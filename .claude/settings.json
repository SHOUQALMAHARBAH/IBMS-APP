{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'script=\"$(git rev-parse --show-toplevel)/ibms-brain/.claude/hooks/enforce-workspace-updates.sh\"; [ -f \"$script\" ] && exec bash \"$script\" || true'"
          },
          {
            "type": "command",
            "command": "bash -c 'script=\"$(git rev-parse --show-toplevel)/ibms-brain/.claude/hooks/enforce-credential-safety.sh\"; [ -f \"$script\" ] && exec bash \"$script\" || true'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'script=\"$(git rev-parse --show-toplevel)/.claude/hooks/mirror-brain-agents.sh\"; [ -f \"$script\" ] && exec bash \"$script\" || true'"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git -C * log *)",
      "Bash(git -C * status *)",
      "Bash(git -C * diff *)",
      "Bash(git -C * branch *)",
      "Bash(git -C * show *)",
      "Bash(git -C * fetch *)",
      "Bash(git -C * rev-parse *)"
    ]
  }
}
