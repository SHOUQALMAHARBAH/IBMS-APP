# Copy to .env.test. Points every test-only command (npm run db:test:*,
# npm run test:e2e) at the db-test container instead of the dev database in
# .env — see docker-compose.yml's db-test service. The dev database is never
# read or written by anything that loads this file.

POSTGRES_USER=ibms
POSTGRES_PASSWORD=ibms
POSTGRES_DB=ibms_test

# Host-side port — docker-compose maps db-test to 5434 on the host (dev is
# 5433, CI's ephemeral container is 5432) so all three can run at once.
DATABASE_URL=postgresql://ibms:ibms@localhost:5434/ibms_test?schema=public

# ---------------------------------------------------------------------------
# Multi-tenancy Phase 2 step 8 — the RUNTIME database connection.
#
# The API connects as a NON-OWNER role so that PostgreSQL applies the row-level
# security policies to it. This is not optional hardening: Postgres exempts a
# table's OWNER from that table's own policies, so connecting the API as the
# migration role above would leave all 118 policies silently, completely inert
# while looking perfectly configured.
#
# DATABASE_URL (above) stays the OWNER connection and is used only by
# `prisma migrate` and the seed — both legitimately need to reach across every
# Organization at once.
#
# Create the role first:  APP_DB_PASSWORD=... npm run db:provision-app-role
# Then run the migrations, which GRANT to it and install the policies.
#
# If this is unset the API still boots, but logs a loud error and runs with
# tenant isolation resting on the application layer alone.
# ---------------------------------------------------------------------------
APP_DATABASE_URL=postgresql://ibms_app:CHANGE_ME@localhost:5434/ibms_test?schema=public

# --- apps/api auth (Part 10.1) --- see .env.example for what these are.
JWT_ACCESS_SECRET=test-only-change-me-32-characters-minimum
MFA_ENCRYPTION_KEY=jWvaaenpb1O7k9jMlLZhRTeQFNJ1jQOFTUHtzgTHNtg=

# --- apps/api field-level encryption (Part 10.2) --- see .env.example.
PII_ENCRYPTION_KEYS=v1:DzVvLT8z/wNB6UZW2cglf0EEajI/+hjMXk8WlVfHphI=
PII_ENCRYPTION_ACTIVE_KEY_ID=v1
# e2e asserts POST /auth/forgot-password returns devResetToken — needs this on.
ENABLE_DEV_RESET_TOKEN=true

# The pino logger is forced silent + file-less under vitest (test:e2e /
# test:contract) regardless — see apps/api/src/common/logging/logger.options.ts.
# smoke.sh boots the REAL server against this env (not under vitest), so keep
# file logging off for it — otherwise a smoke run drops files in <repo>/logs.
LOG_TO_FILE=false

# Wall-clock cron jobs are REMOVED at boot when this is exactly "disabled".
#
# The e2e suite boots the real AppModule, so all 19 @Cron jobs otherwise fire
# during a run: the SLA sweep every 15 minutes, and the watchlist sync at
# 00:00/12:00 against LIVE sanctions endpoints. A run starting at 11:59:40 was
# broken by exactly that — the 12:00 sync published a real 1011-record
# generation, and the next spec's 10-record fixture was then correctly refused
# by the plausibility floor. A suite whose result depends on what time of day
# it started is not testing your code.
#
# Defaults to ENABLED if unset or misspelt, so production never silently stops
# re-screening customers against sanctions lists.
SCHEDULED_JOBS=disabled
