# Copy to .env.test. Points every test-only command (npm run db:test:*,
# npm run test:e2e) at the db-test container instead of the dev database in
# .env — see docker-compose.yml's db-test service. The dev database is never
# read or written by anything that loads this file.

POSTGRES_USER=ibms
POSTGRES_PASSWORD=ibms
POSTGRES_DB=ibms_test

# Host-side port — docker-compose maps db-test to 5434 on the host (dev is
# 5433, CI's ephemeral container is 5432) so all three can run at once.
DATABASE_URL=postgresql://ibms:ibms@localhost:5434/ibms_test?schema=public

# --- apps/api auth (Part 10.1) --- see .env.example for what these are.
JWT_ACCESS_SECRET=test-only-change-me-32-characters-minimum
MFA_ENCRYPTION_KEY=jWvaaenpb1O7k9jMlLZhRTeQFNJ1jQOFTUHtzgTHNtg=

# --- apps/api field-level encryption (Part 10.2) --- see .env.example.
PII_ENCRYPTION_KEYS=v1:DzVvLT8z/wNB6UZW2cglf0EEajI/+hjMXk8WlVfHphI=
PII_ENCRYPTION_ACTIVE_KEY_ID=v1
# e2e asserts POST /auth/forgot-password returns devResetToken — needs this on.
ENABLE_DEV_RESET_TOKEN=true

# The pino logger is forced silent + file-less under vitest (test:e2e /
# test:contract) regardless — see apps/api/src/common/logging/logger.options.ts.
# smoke.sh boots the REAL server against this env (not under vitest), so keep
# file logging off for it — otherwise a smoke run drops files in <repo>/logs.
LOG_TO_FILE=false
