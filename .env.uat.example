# Copy to .env.uat. Points every UAT-only command at the db-uat container
# instead of the dev database in .env or the test database in .env.test —
# see docker-compose.yml's db-uat service. Neither the dev nor the test
# database is ever read or written by anything that loads this file.
#
# Backlog A.10 (Part 10.4/10.5): "Separate Dev/Test/UAT/Prod environments +
# masked/synthesized production data in non-production environments." No
# npm script reads this file yet — same "no real deployment target" gap as
# the rest of this repo's environment story (see README § Deployment). It
# exists so the day a UAT deploy target is chosen, its config isn't invented
# from scratch, and so this file's own existence is a standing reminder that
# UAT must never be seeded from a raw production export — only from
# synthesizeEntityFields()-processed data (apps/api/src/modules/security/
# synthetic-data.util.ts) or hand-built fixtures.

POSTGRES_USER=ibms
POSTGRES_PASSWORD=ibms
POSTGRES_DB=ibms_uat

# Host-side port — dev is 5433, test is 5434, CI's ephemeral container is
# 5432; UAT gets 5435 so all four can run at once without colliding.
DATABASE_URL=postgresql://ibms:ibms@localhost:5435/ibms_uat?schema=public

# --- apps/api auth (Part 10.1) --- see .env.example for what these are.
# UAT-only example values below — generate real secrets per environment,
# never reuse these, and never reuse a Dev/Test/Prod secret here either.
JWT_ACCESS_SECRET=uat-only-change-me-32-characters-minimum
MFA_ENCRYPTION_KEY=jWvaaenpb1O7k9jMlLZhRTeQFNJ1jQOFTUHtzgTHNtg=

# --- apps/api field-level encryption (Part 10.2) --- see .env.example.
PII_ENCRYPTION_KEYS=v1:DzVvLT8z/wNB6UZW2cglf0EEajI/+hjMXk8WlVfHphI=
PII_ENCRYPTION_ACTIVE_KEY_ID=v1

# UAT is a non-production environment used by real testers, not just
# automation — leave this off unless a real email/notification provider is
# wired for it, to avoid a raw reset token showing up somewhere a human
# could screenshot it.
ENABLE_DEV_RESET_TOKEN=false

# --- apps/web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
