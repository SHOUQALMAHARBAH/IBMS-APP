# Generated by `npm run seed:demo` (apps/api). Run output, not source: it
# records the demo accounts and their shared password, so it must not be
# committed even though it lands next to the script that writes it.
apps/api/scripts/seed-demo-report.json

# Written by `scripts/plant.mjs` when a plant is applied and removed by `--revert`. Never committed:
# a leftover backup next to a source file is a plant somebody forgot to revert, and `git add -A` would
# turn that into a committed copy of the pre-plant file.
*.plant-backup

# Generated by `scripts/measurements/server-message-identifiers.py` — the rows, in UTF-8,
# because this host's console is cp1252 and cannot print them. Re-run the script rather than
# committing its output.
server-message-identifiers.txt


# The design-pass screenshots. NOT under `test-results/`, which Playwright clears at the
# start of every run - these have to survive one. Evidence to look at, not an artefact.
design-pass-captures/

# A staging area for files pulled OUT of the working tree on the way to being deleted — stale
# `.git` lock files, mostly. Ignored because of how five of them got committed on 2026-11-11:
# `git add -A` staged the directory, I undid it with `git rm -r --cached` and amended, and then a
# LATER `git add -A` in the same session put them straight back. `git rm --cached` is undone by the
# next `git add -A` unless the path is also ignored — untracking without ignoring is not a fix, it
# is a fix that expires.
_to_delete/
