# Copy to .env and adjust. Used by docker-compose, Prisma (packages/db),
# and apps/api's ConfigModule. apps/web reads NEXT_PUBLIC_* vars from its
# own apps/web/.env.local for local (non-Docker) dev — see README.
#
# This file is the DEV database only. For the separate test database used by
# `npm run test:e2e` / `npm run db:test:migrate:*`, copy .env.test.example to
# .env.test instead — see README § Dev DB vs. test DB.

# --- Postgres (docker-compose) ---
POSTGRES_USER=ibms
POSTGRES_PASSWORD=ibms
POSTGRES_DB=ibms

# --- Prisma / packages/db ---
# Host-side port — docker-compose maps Postgres to 5433 on the host to avoid
# clashing with a locally-installed Postgres on the default 5432. Containers
# in docker-compose reach the db service at db:5432 instead (see compose file).
DATABASE_URL=postgresql://ibms:ibms@localhost:5433/ibms?schema=public

# --- apps/api ---
PORT=4000
WEB_ORIGIN=http://localhost:3000

# --- apps/api auth (Part 10.1) ---
# Dev-only example values below — generate real secrets per environment,
# never reuse these. JWT_ACCESS_SECRET signs short-lived access tokens.
# MFA_ENCRYPTION_KEY must base64-decode to exactly 32 bytes (AES-256-GCM) —
# encrypts MfaCredential.secretEnc (Part 10.2 field-level encryption).
JWT_ACCESS_SECRET=dev-only-change-me-32-characters-minimum
MFA_ENCRYPTION_KEY=jWvaaenpb1O7k9jMlLZhRTeQFNJ1jQOFTUHtzgTHNtg=

# --- apps/api field-level encryption (Part 10.2) ---
# Separate key pool from MFA_ENCRYPTION_KEY above — blast-radius isolation
# between an auth-secret compromise and a PII compromise (see
# apps/api/src/modules/security). Encrypts Customer/UltimateBeneficialOwner/
# InsuredPerson/Employee/ThirdPartyClaimant `-- ENCRYPT` fields.
#
# PII_ENCRYPTION_KEYS holds every key version this environment can still
# decrypt with: "keyId:base64key,keyId2:base64key2,...". Each key must
# base64-decode to exactly 32 bytes (AES-256-GCM). PII_ENCRYPTION_ACTIVE_
# KEY_ID picks which one new writes use. Rotate by adding a new keyId
# alongside the old one, flipping the active id to it, then retiring the
# old id only once every row encrypted under it has been re-encrypted.
PII_ENCRYPTION_KEYS=v1:DzVvLT8z/wNB6UZW2cglf0EEajI/+hjMXk8WlVfHphI=
PII_ENCRYPTION_ACTIVE_KEY_ID=v1

# No email/notification provider exists yet, so forgot-password has nowhere
# to deliver a reset link. With this on, POST /auth/forgot-password returns
# the raw reset token in the response body (never logged) so the flow can be
# exercised end-to-end without a real mailbox. Leave unset/false unless you
# need it — NODE_ENV=production hard-blocks this regardless of the flag.
ENABLE_DEV_RESET_TOKEN=true

# --- apps/api logging (Part 10.3/10.4) ---
# pino structured logs. LOG_LEVEL: trace|debug|info|warn|error|fatal|silent
# (default: debug in dev, info when NODE_ENV=production).
# LOG_TO_FILE: on by default — the running API mirrors EVERYTHING it prints
# (HTTP traces, Logger output, error stacks, stray console.*, uncaught
# crashes) to daily-rolling JSON files under LOG_DIR (default <repo>/logs),
# on top of the pretty dev console. Set it to false for console-only. The
# `npm run dev` / turbo / nest-CLI build output is a separate process and is
# never captured. Always on in production; forced silent + file-less under
# vitest regardless. Request/response BODIES are never logged and auth
# headers + known secret/PII keys are redacted
# (apps/api/src/common/logging/logger.options.ts;
# ibms-brain/meta/lex/sensitive-data-handling.md).
LOG_LEVEL=debug
LOG_TO_FILE=true
# LOG_DIR=./logs

# --- Bootstrap administrator (backlog A.2) ---
# Sample users (one per role, password in seed-data/sample-users.ts) are seeded
# only when NODE_ENV !== 'production'. Set BOTH of these and `npm run db:seed`
# creates a single SYSTEM_SECURITY_ADMINISTRATOR who can then provision
# everyone else through POST /admin/users.
#
# REQUIRED for any non-dev deployment: without it a production-seeded database
# has the full role catalogue, the full permission grid, and NO user able to
# sign in — signup grants zero roles and role assignment needs `user.manage`.
#
# The password is validated against the same Part 10.1 policy the login path
# enforces (>= 12 chars, upper + lower + digit + symbol). Re-running the seed
# never resets an existing account's password; it only confirms the role grant.
# BOOTSTRAP_ADMIN_EMAIL=admin@your-broker.example
# BOOTSTRAP_ADMIN_PASSWORD=

# --- Rate limiting / proxy trust (Part 10.1/10.2) ---
# The auth rate limiter (apps/api/src/common/rate-limit.guard.ts) is enforced
# when NODE_ENV=production, or anywhere this is 'true'. Off in dev/CI on
# purpose: every request there comes from 127.0.0.1, so a per-IP bucket lumps
# every user and every test together — it does not approximate production, it
# just makes the e2e suite unrunnable.
# RATE_LIMIT_ENABLED=true
#
# `X-Forwarded-For` is client-supplied and trivially spoofable, so the limiter
# ignores it unless this declares that a TRUSTED reverse proxy sets it. Turn it
# on only when something in front of the app overwrites the header.
# TRUST_PROXY_HEADERS=true

# --- apps/web ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Automated PEP / sanctions screening -------------------------------------
#
# Which provider answers a screening. Unset = "built_in": the OFAC SDN + UN
# Consolidated cache this repo syncs itself. That is a REAL provider and the
# default; it covers SANCTIONS only, with no PEP source.
#
#   built_in    the local synced watchlist cache (default)
#   on_premise  a local screening engine over HTTP (yente) — see
#               `docker compose --profile screening up -d screening-engine`
#   commercial  a commercial provider (Dow Jones / Refinitiv / ComplyAdvantage)
#
# Selecting on_premise or commercial WITHOUT the settings it needs does NOT
# fall back to the built-in cache. Screening reports NOT_CONFIGURED, because a
# silent fallback would answer a different question than the operator asked.
SCREENING_PROVIDER=built_in

# on_premise + commercial. No trailing slash needed.
#   on_premise example: http://localhost:8000
# SCREENING_BASE_URL=

# COMMERCIAL ONLY, and REQUIRED for it. Never commit a real value: supply it
# through a deployment secret or secret manager. It is sent as an
# Authorization header, never a query parameter, and is never logged, returned
# by an API, or written to the database.
# SCREENING_API_KEY=
# SCREENING_TENANT_ID=

# Which dataset/collection to query, where the provider has more than one.
# SCREENING_DATASET=default

# Reliability. A failure is reported as SCREENING_FAILED — never as "no match".
# SCREENING_TIMEOUT_MS=10000
# SCREENING_MAX_RETRIES=2

# Send national ID / passport to the provider. DEFAULT FALSE: doing so is a
# data-sharing decision with a PDPL basis behind it, not a matching
# optimisation — even to a local engine. Supplying them reduces false
# positives, which is why it is offered at all.
# SCREENING_SEND_IDENTIFIERS=false

# Beyond this the provider's data is reported STALE and screening returns
# UNABLE_TO_SCREEN rather than answering from old data.
# SCREENING_DATASET_STALE_AFTER_HOURS=48

# Match thresholds (0..1). CONFIGURABLE ON PURPOSE — a threshold is a
# risk-appetite decision the broker owns, with false-positive and
# false-negative costs. The values below are STARTING POINTS, not a regulatory
# rule, and no figure here is sourced to any authority.
#   high    >= this: case opened at high risk
#   review  >= this: case opened for human review
#   low     <  this: discarded as noise (0 queues everything)
# SCREENING_MATCH_THRESHOLD_HIGH=0.9
# SCREENING_MATCH_THRESHOLD_REVIEW=0.7
# SCREENING_MATCH_THRESHOLD_LOW=0.5

# --- Workflow holds (Part B §17) --------------------------------------------
# What a screening finding does to the workflow that depends on it. Each is
# NO_HOLD | REVIEW_REQUIRED | BLOCKED. Defaults fail toward review rather than
# toward silent approval.
#
# NONE of these is a regulatory requirement and none carries a citation — no
# source for one was supplied to this repository. They are the deployment's own
# control settings. See docs/screening-provider-setup.md.
#
# The first two may be raised but NEVER lowered: approving a customer nobody
# screened is not a judgement a written reason can carry, and waving through a
# match a reviewer already confirmed in writing would make the queue
# decorative. A configuration that tries to relax them is ignored AND reported.
# SCREENING_HOLD_NEVER_SCREENED=BLOCKED
# SCREENING_HOLD_CONFIRMED_SANCTIONS=BLOCKED
# SCREENING_HOLD_CONFIRMED_PEP=REVIEW_REQUIRED
# SCREENING_HOLD_CONFIRMED_WATCHLIST=REVIEW_REQUIRED
# SCREENING_HOLD_PENDING_REVIEW=REVIEW_REQUIRED
# SCREENING_HOLD_UNRESOLVED=REVIEW_REQUIRED
# SCREENING_HOLD_POTENTIAL_MATCH=REVIEW_REQUIRED
# SCREENING_HOLD_IDENTITY_CHANGED=REVIEW_REQUIRED
# SCREENING_HOLD_LIST_UPDATED=REVIEW_REQUIRED
# SCREENING_HOLD_STALE=REVIEW_REQUIRED
#
# How old a screening may be before it stops counting as current. 0 = off,
# which is the default: no sourced re-screening cadence exists here, and
# inventing one would present an unsourced figure as policy.
# SCREENING_STALE_AFTER_DAYS=0
