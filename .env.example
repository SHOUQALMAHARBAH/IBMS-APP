# Copy to .env and adjust. Used by docker-compose, Prisma (packages/db),
# and apps/api's ConfigModule. apps/web reads NEXT_PUBLIC_* vars from its
# own apps/web/.env.local for local (non-Docker) dev — see README.
#
# This file is the DEV database only. For the separate test database used by
# `npm run test:e2e` / `npm run db:test:migrate:*`, copy .env.test.example to
# .env.test instead — see README § Dev DB vs. test DB.

# --- Postgres (docker-compose) ---
POSTGRES_USER=ibms
POSTGRES_PASSWORD=ibms
POSTGRES_DB=ibms

# --- Prisma / packages/db ---
# Host-side port — docker-compose maps Postgres to 5433 on the host to avoid
# clashing with a locally-installed Postgres on the default 5432. Containers
# in docker-compose reach the db service at db:5432 instead (see compose file).
DATABASE_URL=postgresql://ibms:ibms@localhost:5433/ibms?schema=public

# --- apps/api ---
PORT=4000
WEB_ORIGIN=http://localhost:3000

# --- apps/api auth (Part 10.1) ---
# Dev-only example values below — generate real secrets per environment,
# never reuse these. JWT_ACCESS_SECRET signs short-lived access tokens.
# MFA_ENCRYPTION_KEY must base64-decode to exactly 32 bytes (AES-256-GCM) —
# encrypts MfaCredential.secretEnc (Part 10.2 field-level encryption).
JWT_ACCESS_SECRET=dev-only-change-me-32-characters-minimum
MFA_ENCRYPTION_KEY=jWvaaenpb1O7k9jMlLZhRTeQFNJ1jQOFTUHtzgTHNtg=

# --- apps/api field-level encryption (Part 10.2) ---
# Separate key pool from MFA_ENCRYPTION_KEY above — blast-radius isolation
# between an auth-secret compromise and a PII compromise (see
# apps/api/src/modules/security). Encrypts Customer/UltimateBeneficialOwner/
# InsuredPerson/Employee/ThirdPartyClaimant `-- ENCRYPT` fields.
#
# PII_ENCRYPTION_KEYS holds every key version this environment can still
# decrypt with: "keyId:base64key,keyId2:base64key2,...". Each key must
# base64-decode to exactly 32 bytes (AES-256-GCM). PII_ENCRYPTION_ACTIVE_
# KEY_ID picks which one new writes use. Rotate by adding a new keyId
# alongside the old one, flipping the active id to it, then retiring the
# old id only once every row encrypted under it has been re-encrypted.
PII_ENCRYPTION_KEYS=v1:DzVvLT8z/wNB6UZW2cglf0EEajI/+hjMXk8WlVfHphI=
PII_ENCRYPTION_ACTIVE_KEY_ID=v1

# No email/notification provider exists yet, so forgot-password has nowhere
# to deliver a reset link. With this on, POST /auth/forgot-password returns
# the raw reset token in the response body (never logged) so the flow can be
# exercised end-to-end without a real mailbox. Leave unset/false unless you
# need it — NODE_ENV=production hard-blocks this regardless of the flag.
ENABLE_DEV_RESET_TOKEN=true

# --- apps/api logging (Part 10.3/10.4) ---
# pino structured logs. LOG_LEVEL: trace|debug|info|warn|error|fatal|silent
# (default: debug in dev, info when NODE_ENV=production).
# LOG_TO_FILE: on by default — the running API mirrors EVERYTHING it prints
# (HTTP traces, Logger output, error stacks, stray console.*, uncaught
# crashes) to daily-rolling JSON files under LOG_DIR (default <repo>/logs),
# on top of the pretty dev console. Set it to false for console-only. The
# `npm run dev` / turbo / nest-CLI build output is a separate process and is
# never captured. Always on in production; forced silent + file-less under
# vitest regardless. Request/response BODIES are never logged and auth
# headers + known secret/PII keys are redacted
# (apps/api/src/common/logging/logger.options.ts;
# ibms-brain/meta/lex/sensitive-data-handling.md).
LOG_LEVEL=debug
LOG_TO_FILE=true
# LOG_DIR=./logs

# --- apps/web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
