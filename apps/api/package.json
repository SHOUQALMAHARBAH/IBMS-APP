  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "dotenv -e ../../.env -- nest start --watch",
    "start:dev": "dotenv -e ../../.env -- nest start --watch",
    "start:debug": "dotenv -e ../../.env -- nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "dotenv -e ../../.env.test -- vitest run --config ./test/vitest-e2e.config.ts",
    "test:contract": "dotenv -e ../../.env.test -- vitest run --config ./test/vitest-contract.config.ts",
    "test:smoke": "dotenv -e ../../.env.test -- bash scripts/smoke.sh"
  },
  "dependencies": {
    "@ibms/db": "0.0.0",
