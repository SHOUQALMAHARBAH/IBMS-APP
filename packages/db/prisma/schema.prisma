/// Part 7.2 — transaction monitoring for unusual patterns (unusually large
/// premium payments, frequent cancellations/refunds, third-party premium
/// payment sources), escalating to Suspicious Activity where warranted.
///
/// Process 48 (backlog Part C #48) — `sourceEntityType`/`sourceEntityId`
/// identify the exact Receipt that triggered an event-scoped alert
/// (`large_premium_payment` / `third_party_payment_source`); both stay null
/// for the two customer-level aggregate patterns (`frequent_cancellations` /
/// `frequent_refunds`), which have no single triggering row.
/// `@@unique([patternType, sourceEntityId])` stops the nightly sweep from
/// re-alerting the same Receipt forever — Postgres treats every NULL
/// `sourceEntityId` as distinct, so this is a no-op for the two aggregate
/// patterns (and for a manual log, which never sets `sourceEntityId`
/// either). Their own "one OPEN alert per customer" guard is a
/// hand-authored partial UNIQUE index, scoped directly to
/// `patternType IN ('frequent_cancellations','frequent_refunds')` — NOT to
/// `sourceEntityId IS NULL` (migration 20260904130000_add_transaction_
/// monitoring, the UpSellRecommendation / ClaimFollowUpAlert shape —
/// ibms-brain/meta/lex/race-safe-invariants.md; a `sourceEntityId IS NULL`
/// predicate would also collide two unrelated manual `other`-pattern alerts
/// for the same customer, a real `@code-reviewer` BLOCKER on the first pass).
model TransactionMonitoringAlert {
  id                            String             @id @default(uuid())
  /// Part I §3.2 (multi-tenancy) — the Organization (brokerage office) this
  /// row belongs to. Supplied by `tenantScopeExtension`, never by hand.
  organizationId                String             @default(dbgenerated())
  organization                  Organization       @relation(fields: [organizationId], references: [id])
  customerId                    String?
  customer                      Customer?          @relation(fields: [customerId], references: [id])
  patternType                   String // large_premium_payment | frequent_cancellations | frequent_refunds | third_party_payment_source | other
  detailText                    String?
  sourceEntityType              String?
  sourceEntityId                String?
  detectedAt                    DateTime           @default(now())
  escalatedToSuspiciousActivity Boolean            @default(false)
  escalatedAt                   DateTime?
  reportedToAuthorityAt         DateTime? // record-keeping for regulator-mandated retention (Part 7.2)
  status                        String             @default("open")
  classification                DataClassification @default(HIGHLY_CONFIDENTIAL) // names payment sources/counterparties, AML-sensitive

  @@unique([patternType, sourceEntityId])
  @@index([customerId])
  @@index([status])
  @@index([patternType])
  @@index([organizationId])
}

enum WatchlistSource {
  OFAC_SDN
  UN_CONSOLIDATED
}

/// Process 49 — a locally-cached copy of a free, publicly published
/// sanctions/PEP list (the source of truth stays with the publisher; this
/// table is a sync target, refreshed by `WatchlistSyncScheduler`, never
/// hand-edited). `sourceRecordId` is the source's own stable identifier
/// (OFAC `ent_num`, UN `DATAID`) — the upsert/prune key on every sync.
/// `normalizedName` is the SAME canonicalisation
/// (`normalizeWatchlistName` — uppercase, punctuation stripped, tokens
/// sorted) `ScreeningService` applies to a customer/UBO name at match time,
/// so a stored equality check is the whole match — not fuzzy/phonetic, a
/// documented limitation (see `watchlist-sync.config.ts`). A record whose
/// name normalizes to an empty string (an all-non-letter/digit `fullName`)
/// is never stored — see `WatchlistSyncService`.
///
/// `classification` — a `@code-reviewer` BLOCKER on the first pass had NO
/// classification field at all, reasoning in a code comment that this is
/// "public government text, not IBMS customer data" — an engineering-derived
/// privacy determination that `ibms-brain/meta/designs/2026-08-pcms-source-
/// of-truth.md` says belongs to PCMS (PRIV-STD-02), not to this codebase.
/// Defaulted to the conservative `HIGHLY_CONFIDENTIAL` tier pending that
/// citation — `remarks` can carry a real, named individual's DOB and
/// alleged-conduct text — DRAFTED, same status as `kyc-aml-sla-timers.md`'s
/// figures until PRIV-STD-02 is consulted.
model WatchlistEntry {
  id               String                  @id @default(uuid())
  source           WatchlistSource
  sourceRecordId   String
  fullName         String
  normalizedName   String
  listProgram      String? // OFAC "Program", or UN "UN_LIST_TYPE"/"REFERENCE_NUMBER"
  remarks          String? // OFAC "Remarks", or UN "COMMENTS1"
  classification   DataClassification      @default(HIGHLY_CONFIDENTIAL) // DRAFTED pending PRIV-STD-02 — see model comment
  syncRunId        String // the WatchlistSyncRun that last confirmed this row is still on the source list
  syncedAt         DateTime                @default(now())
  /// Process 49 (fuzzy matching) — `fullName` reduced to a canonical token
  /// set by `canonicalNameTokens()`: lower-cased, punctuation stripped,
  /// de-duplicated, sorted, and collapsed through the curated
  /// transliteration table so every romanisation of a name (and its
  /// Arabic-script spelling) yields the same tokens.
  ///
  /// Screening asks "are ALL of this entry's tokens present in the subject's
  /// tokens?" — an array containment test (`<@`), which is why this is a
  /// scalar list with a GIN index rather than a second normalised string.
  /// Populated on every sync. An entry written before this column existed
  /// carries `[]`, which the FUZZY branch cannot see at all — `array_length`
  /// of an empty array is NULL, so `NULL >= 2` excludes the row. Two things
  /// close that: such a row is still reachable by the EXACT branches of
  /// `findMatchCandidates` (so no database ever goes wholly CLEAR — that is
  /// what the `normalizedName` floor is for), and
  /// `WatchlistEntryRepository.backfillCanonicalTokens` rewrites them at the
  /// start of every sync rather than waiting for a fetch to succeed.
  canonicalTokens  String[]
  /// Part B §6 — which generation of the list this row belongs to. A screening
  /// reads only the PUBLISHED generation, which is what makes a sync invisible
  /// to readers until it is complete.
  /// Required: an entry with no generation would be invisible to the
  /// published-generation reader AND exempt from the generation-scoped unique
  /// key (Postgres treats NULLs as distinct), so it could silently duplicate.
  datasetVersionId String
  datasetVersion   WatchlistDatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)
  matches          ScreeningMatch[]

  /// Scoped to the generation: the same list entry legitimately exists in the
  /// published generation and in the one being downloaded beside it.
  @@unique([source, sourceRecordId, datasetVersionId])
  @@index([normalizedName])
  @@index([source])
  @@index([datasetVersionId])
}

/// Process 49 — one row per sync attempt (scheduled every 12h, matching the
/// source lists' own refresh cadence, or on-demand). The operational health
/// record for the sync job — not an AuditLogEntry, the same "own tracking
/// table, not the compliance audit trail" shape as `SlaTimer` /
/// `AccessRecertificationCycle`.
///
/// `@@unique` below (raw SQL, migration `20260904140000` — Prisma can't
/// express the predicate): at most one `status = 'running'` row per
/// `source` — a `@code-reviewer` BLOCKER on the first pass: with no guard,
/// a manual `POST /watchlist-sync/run` firing while the 12-hourly
/// `WatchlistSyncScheduler` is mid-run (or two concurrent manual triggers)
/// let two syncs of the SAME source interleave — one run's `pruneStale`
/// (`watchlist-entry.repository.ts`) deletes rows the OTHER run had just
/// correctly (re-)written under a different `syncRunId`, silently dropping
/// real, currently-sanctioned entries from the cache until the next sync.
/// `WatchlistSyncService.createSyncRun`'s `P2002` on this index is caught
/// and mapped to a `skipped` outcome, not a `failed` one.
/// Process 49 — a POTENTIAL sanctions match awaiting human review.
///
/// Fuzzy matching (see `watchlist-match.config.ts`) deliberately trades false
/// negatives for false positives: it will fire on a common given name shared
/// with a sanctioned individual. That trade is only safe if a person actually
/// works the resulting queue, which is what this table is. A row here is a
/// QUESTION, never a verdict — nothing in the system blocks, suspends or
/// rejects a customer on the strength of one.
///
/// The screening run is the "maker" (it is a system actor, so there is no
/// human maker to be distinct from) and the reviewing Compliance Officer is
/// the checker; `reviewedByUserId` + a mandatory `reviewReason` are the
/// accountability record. Clearing a match does NOT clear
/// `KYCRecord.isEdd` — that flag only ever escalates, so a cleared false
/// positive still leaves the enhanced due-diligence trail it triggered.
///
/// HIGHLY_CONFIDENTIAL by content: it names a customer alongside a sanctions
/// list entry. Reads are audit-logged with `isSensitiveDataAccess`.
model ScreeningMatch {
  id                  String          @id @default(uuid())
  /// Part I §3.2 (multi-tenancy) — the Organization (brokerage office) this
  /// row belongs to. Supplied by `tenantScopeExtension`, never by hand.
  organizationId      String          @default(dbgenerated())
  organization        Organization    @relation(fields: [organizationId], references: [id])
  kycRecordId         String
  kycRecord           KYCRecord       @relation(fields: [kycRecordId], references: [id])
  /// Nullable, and `SET NULL` rather than `Cascade`: `pruneStale` deletes an
  /// entry the moment it drops off the source list, and a CONFIRMED match —
  /// the reviewer's id, the timestamp, the written reason — must outlive the
  /// subject being de-listed. The snapshot fields below are what the queue
  /// renders once this goes NULL.
  watchlistEntryId    String?
  watchlistEntry      WatchlistEntry? @relation(fields: [watchlistEntryId], references: [id], onDelete: SetNull)
  /// Snapshot of the matched list entry, taken at detection. Denormalised on
  /// purpose: the relation above can go NULL, and a compliance record that
  /// renders as "(deleted)" is not a record.
  entrySource         String
  entrySourceRecordId String?
  entryFullName       String
  entryListProgram    String?

  /// The attempt that raised this candidate.
  screeningRequestId String?
  screeningRequest   ScreeningRequest?      @relation(fields: [screeningRequestId], references: [id], onDelete: SetNull)
  provider           ScreeningProviderKind?
  /// SANCTIONS / PEP / WATCHLIST. Defaults to SANCTIONS because every match
  /// that existed before providers came from OFAC/UN, which are sanctions
  /// lists — a backfill that guessed PEP would be fabricating a
  /// determination.
  listType           ScreeningListType      @default(SANCTIONS)
  /// The provider's own entity id, so a reviewer can look the candidate up.
  providerEntityId   String?
  /// 0..1. NULL for the built-in matcher, which is deterministic set logic
  /// rather than a similarity engine — a fabricated fraction would be false
  /// precision.
  matchScore         Float?
  /// Part B §13 — the review threshold this candidate was measured against,
  /// and the matcher version that raised it. Stored per match rather than
  /// looked up later: the configuration moves, and a match must stay
  /// readable against the rules that actually produced it.
  reviewThreshold    Float?
  algorithmVersion   String?
  /// Which attributes agreed (name / dateOfBirth / nationality / ...). A
  /// name-only agreement is very different evidence from name+DOB+nationality.
  matchedAttributes  String[]               @default([])
  /// For a PEP candidate: the position that makes them politically exposed.
  pepPosition        String?
  /// The name that actually matched. NOT always the customer's own legal
  /// name — screening covers UBOs too, and the reviewer needs to know which
  /// subject triggered it. Display-only: see `subjectCanonical`.
  subjectName        String
  /// `canonicalNameTokens(subjectName).join(' ')` — what the match was
  /// actually made on, and what the duplicate-suppression UNIQUE keys on.
  /// Keying that on the RAW name meant re-casing or re-spacing a customer's
  /// legal name minted a second queue item that a prior `cleared` decision
  /// did not suppress.
  subjectCanonical   String
  /// `exact` (identical after canonicalisation) or `fuzzy` (the entry's
  /// tokens are contained in the subject's). Surfaced so a reviewer can
  /// triage: an exact hit deserves more scrutiny than a subset one.
  matchType          String
  /// The DECISION: `pending` | `cleared` | `confirmed`.
  ///
  /// Distinct from `caseStatus` below, which is the WORKFLOW state, and they
  /// answer different questions. "Has anyone looked at this yet?" is workflow;
  /// "was it a real match?" is the decision. Collapsing them would make
  /// "assigned but not yet decided" unrepresentable.
  status             String                 @default("pending")

  /// Part B §16 — the case workflow.
  ///
  ///   OPEN          detected, nobody owns it
  ///   ASSIGNED      a named reviewer owns it
  ///   UNDER_REVIEW  that reviewer has started work
  ///   ESCALATED     raised to someone else, with a written reason
  ///   CLOSED        a decision was recorded; terminal
  ///
  /// A decision may only be recorded from UNDER_REVIEW or ESCALATED — not from
  /// OPEN. Deciding a case nobody ever picked up is exactly the rubber-stamp
  /// this queue exists to prevent, so the transition table makes it
  /// unreachable rather than discouraged.
  caseStatus        ScreeningCaseStatus @default(OPEN)
  assignedToUserId  String?
  assignedByUserId  String?
  assignedAt        DateTime?
  reviewStartedAt   DateTime?
  escalatedToUserId String?
  escalatedAt       DateTime?
  /// Mandatory when escalating — enforced in the database.
  escalationReason  String?
  closedAt          DateTime?
  closedByUserId    String?

  notes ScreeningCaseNote[]

  detectedAt       DateTime  @default(now())
  reviewedByUserId String?
  reviewedAt       DateTime?
  /// Mandatory when a decision is recorded — the business justification for
  /// clearing or confirming, kept verbatim (a justification, not personal
  /// data — the same treatment `Refund.reason` gets).
  reviewReason     String?

  /// One open item per (KYC file, list entry, CANONICAL subject name): a
  /// re-screen of the same customer must not manufacture a duplicate queue
  /// item every four hours. The race backstop for the recurring batch.
  @@unique([kycRecordId, watchlistEntryId, subjectCanonical])
  @@index([status])
  @@index([kycRecordId])
  /// The "my queue" read.
  @@index([assignedToUserId, caseStatus])
  @@index([caseStatus])
  @@index([organizationId])
}

/// Part B §16 — a note on a screening case.
///
/// Separate from `reviewReason`, deliberately: that field is the JUSTIFICATION
/// for the final decision and is written once, at closure. These are the
/// working record — what was checked, who was contacted, what a document said —
/// and there are many of them over a case's life.
///
/// Append-only. A case note that can be edited is not evidence of what the
/// reviewer knew at the time, which is the only reason to keep one.
model ScreeningCaseNote {
  id               String         @id @default(uuid())
  /// Part I §3.2 (multi-tenancy) — the Organization (brokerage office) this
  /// row belongs to. Supplied by `tenantScopeExtension`, never by hand.
  organizationId   String         @default(dbgenerated())
  organization     Organization   @relation(fields: [organizationId], references: [id])
  screeningMatchId String
  screeningMatch   ScreeningMatch @relation(fields: [screeningMatchId], references: [id], onDelete: Cascade)
  /// Free text by a reviewer about a screening finding. It may name the
  /// subject, so it inherits the match's own Highly Confidential handling and
  /// is never copied into an audit payload.
  note             String
  authorUserId     String
  createdAt        DateTime       @default(now())

  @@index([screeningMatchId, createdAt])
  @@index([organizationId])
}

enum ScreeningCaseStatus {
  OPEN
  ASSIGNED
  UNDER_REVIEW
  ESCALATED
  CLOSED
}

model WatchlistSyncRun {
  id           String          @id @default(uuid())
  source       WatchlistSource
  startedAt    DateTime        @default(now())
  completedAt  DateTime?
  status       String          @default("running") // running | succeeded | failed
  recordCount  Int?
  /// Part B §21 — how many entries this run saw for the FIRST time.
  ///
  /// Only additions matter for re-screening: an entry leaving a list cannot
  /// create a match that did not exist before, but one arriving can. A file
  /// screened before the most recent ADDING run was checked against a list
  /// that has since grown, which the screening hold reports.
  addedCount   Int?
  errorMessage String?
}

/// Process 51 — configurable compliance calendar for CBJ regulatory
/// filings/reporting obligations.
model ComplianceCalendarItem {
  id                      String       @id @default(uuid())
  /// Part I §3.2 (multi-tenancy) — the Organization (brokerage office) this
  /// row belongs to. Supplied by `tenantScopeExtension`, never by hand.
  organizationId          String       @default(dbgenerated())
  organization            Organization @relation(fields: [organizationId], references: [id])
  obligationName          String
  ownerUserId             String
  dueDate                 DateTime
  evidenceOfSubmissionRef String?
  submittedAt             DateTime?

  @@index([organizationId])
}

/// Process 53 / narrative process 37 ("إدارة مخاطر الوسيط نفسه") — the
/// broker's own risk register across the six categories the source model
/// names explicitly: operational (e.g. policy issuance errors), cyber
/// (data leakage), financial (uncollected receivables), compliance
/// (regulatory breach), and reputational (major client complaint).
/// Professional Indemnity risk has its own richer model
/// (ProfessionalIndemnityRiskEvent) because Part 3 gives it a dedicated
/// deep-dive; the other five share this generic register.
model RiskRegisterItem {
  id               String       @id @default(uuid())
  /// Part I §3.2 (multi-tenancy) — the Organization (brokerage office) this
