// ============================================================================
// PROCESS 55 / PART 7.4, 8.1, 9.3 — INCIDENT / BREACH MANAGEMENT (PDPL + ISO)
// ============================================================================

enum IncidentStatus {
  REPORTED
  CONTAINED
  IMPACT_ASSESSED
  CLASSIFIED
  NOTIFIED
  RECOVERED
  CLOSED
}

enum IncidentClassification {
  NOT_YET_CLASSIFIED
  MATERIAL
  NON_MATERIAL
}

/// Process 55 / Part 6.2 / Part 7.4 — unified security + personal-data
/// breach workflow. State machine: Reported -> Contained (4h target for
/// critical) -> Impact Assessed -> Classified (Material needs DPO + Senior
/// Management co-sign) -> Notified -> Recovered -> Closed (RCA mandatory).
model IncidentReport {
  id                             String                 @id @default(uuid())
  /// Part I §3.2 (multi-tenancy) — the Organization (brokerage office) this
  /// row belongs to. Supplied by `tenantScopeExtension`, never by hand.
  organizationId                 String                 @default(dbgenerated())
  organization                   Organization           @relation(fields: [organizationId], references: [id])
  title                          String
  description                    String
  severity                       String // low | medium | high | critical
  status                         IncidentStatus         @default(REPORTED)
  reportedAt                     DateTime               @default(now())
  containedAt                    DateTime? // 4-hour target for critical severity
  impactAssessedAt               DateTime?
  classification                 IncidentClassification @default(NOT_YET_CLASSIFIED)
  classifiedByDpoUserId          String?
  // Material classification irreversible without this — `assertDifferentActors`
  // (app-level) + `IncidentReport_classification_maker_checker_distinct` CHECK
  // (migration 20260906120000, Process 55) both enforce that this is a
  // DIFFERENT officer than classifiedByDpoUserId.
  seniorManagementCoSignUserId   String?
  seniorManagementNotifiedAt     DateTime? // within 1 hour of Material classification
  notifiedRegulators             String[] // CBJ | NCSC | Personal_Data_Protection_Council
  notifiedAt                     DateTime?
  affectedDataSubjectsNotifiedAt DateTime?
  rootCauseAnalysis              String? // mandatory before Closed
  recoveredAt                    DateTime?
  closedAt                       DateTime?
  createdAt                      DateTime               @default(now())

  @@index([organizationId])
}

// ============================================================================
// PART 6, PART 9.3 — DATA PROTECTION (PDPL) CORE CAPABILITIES
// (implements the cross-cutting rules described in Part 6.2 / 9.3; field-
// level detail limited to what these two source documents describe)
// ============================================================================

enum ConsentPurpose {
  UNDERWRITING
  CLAIMS
  MARKETING
  KYC_AML
  SHARING_WITH_INSURER
  OTHER
}

/// Part 4.1 core entity / Part 6.2 (Consent Management). Every optional
/// consent defaults unchecked; contractual-necessity and marketing consent
/// are ALWAYS two separate, independently-actionable controls (Part 6.3).
model ConsentRecord {
  id                 String         @id @default(uuid())
  /// Part I §3.2 (multi-tenancy) — the Organization (brokerage office) this
  /// row belongs to. Supplied by `tenantScopeExtension`, never by hand.
  organizationId     String         @default(dbgenerated())
  organization       Organization   @relation(fields: [organizationId], references: [id])
  customerId         String?
  customer           Customer?      @relation(fields: [customerId], references: [id])
  insuredPersonId    String?
  insuredPerson      InsuredPerson? @relation(fields: [insuredPersonId], references: [id])
  // Part D touchpoint #1 (lead capture) — the one touchpoint that pre-dates
  // a Customer/InsuredPerson row existing at all. Exactly one of
  // customerId/insuredPersonId/leadId is app-level validated (service layer,
  // not a DB CHECK — see consent.config.ts's hasExactlyOneConsentOwner).
  leadId             String?
  lead               Lead?          @relation(fields: [leadId], references: [id])
  purpose            ConsentPurpose
  isMarketing        Boolean        @default(false) // never combined with contractual-necessity processing
  granted            Boolean        @default(false) // defaults unchecked — pre-ticked boxes prohibited
  consentTextVersion String
  grantedAt          DateTime?
  withdrawnAt        DateTime? // must reflect in register within 2 business days (SLA)
  createdAt          DateTime       @default(now())

  communicationLogs CommunicationLog[] // Process 44 — marketing sends that relied on this consent

  @@index([customerId])
  @@index([leadId])
  @@index([organizationId])
}

enum DsrType {
  ACCESS
  CORRECTION
  DELETION
  OBJECTION
}

enum DsrStatus {
  RECEIVED
  IDENTITY_VERIFIED
  IN_PROGRESS
  PARTIALLY_FULFILLED
  FULFILLED
  REJECTED
  CLOSED
}

/// Part 4.1 core entity / Part 6.2 (M04). SLA: Access/Deletion 15 business
/// days (Access +15 extension allowed, reason logged); Correction/Objection
/// 10 business days. A Deletion DSR with an open retention flag cannot be
/// closed "fully fulfilled" — must force PARTIALLY_FULFILLED with a
/// retentionScheduleReference.
model DataSubjectRequest {
  id                             String         @id @default(uuid())
  /// Part I §3.2 (multi-tenancy) — the Organization (brokerage office) this
  /// row belongs to. Supplied by `tenantScopeExtension`, never by hand.
  organizationId                 String         @default(dbgenerated())
  organization                   Organization   @relation(fields: [organizationId], references: [id])
  customerId                     String?
  customer                       Customer?      @relation("DsrCustomer", fields: [customerId], references: [id])
  insuredPersonId                String?
  insuredPerson                  InsuredPerson? @relation("DsrInsuredPerson", fields: [insuredPersonId], references: [id])
  type                           DsrType
  status                         DsrStatus      @default(RECEIVED)
  receivedAt                     DateTime       @default(now()) // logged same business day regardless of channel
  identityVerifiedAt             DateTime?
  slaDueAt                       DateTime
  accessExtensionAppliedAt       DateTime? // Access-only, +15 business days
  extensionReason                String?
  retentionScheduleReference     String? // required if partially-fulfilled deletion
  partialFulfilmentJustification String?
  closedAt                       DateTime?
  dpoHandlerUserId               String?
  createdAt                      DateTime       @default(now())
  // Process 52/M04 (backlog Part D) widening — maker/checker segregation for
  // closure (Part 5.2 / maker-checker-segregation.md): processedByUserId is
  // stamped by whichever of verify->fulfil/partially-fulfil/reject actually
  // drove the terminal outcome (the MAKER); closedByUserId (the CHECKER) must
  // differ — enforced app-side (assertDifferentActors) AND by the
  // DataSubjectRequest_closure_maker_checker_distinct CHECK below. Both are
  // DPO-only permissions (dsr.handle / dsr.close) — segregation here is
  // between two distinct DPO officers, not between roles.
  processedByUserId              String?
  closedByUserId                 String?
  rejectionReason                String?
  // DELETION-only staff attestation persisted at fulfil() time (a
  // @code-reviewer MAJOR on the first pass: confirmNoOpenRetentionHold was
  // validated in-memory from the request DTO and then discarded — nothing
  // survived to prove which DPO officer attested "no retention hold applies"
  // before this Deletion was marked fully fulfilled). Retention & Disposal
  // (M06) is not built yet, so this stays a staff attestation, not an
  // automated check against RetentionScheduleItem/LegalHold — see
  // dsr.config.ts's header comment.
  noOpenRetentionHoldConfirmedAt DateTime?

  @@index([status])
  @@index([slaDueAt])
  @@index([customerId])
  @@index([insuredPersonId])
  @@index([dpoHandlerUserId])
  @@index([organizationId])
}

/// Part 6.2 (M06) — retention periods per record category against a
/// documented legal-minimum retention table. `recordCategory` is unique —
/// one schedule row per category, not a free-running log (Process #52
/// widening: the original model had no constraint stopping a duplicate).
model RetentionScheduleItem {
  id                        String       @id @default(uuid())
  /// Part I §3.2 (multi-tenancy) — the Organization (brokerage office) this
  /// row belongs to. Supplied by `tenantScopeExtension`, never by hand.
  organizationId            String       @default(dbgenerated())
  organization              Organization @relation(fields: [organizationId], references: [id])
  /// Multi-tenancy Phase 1 step 5 — unique WITHIN an Organization, not across
  /// the platform. A bare @unique here is not only a functional bug (two
  /// offices legitimately produce the same value); it leaks across tenants on
  /// its own — a uniqueness-violation error confirms the value already exists
  /// for SOMEONE, with no row ever returned. See @@unique below.
  recordCategory            String
  retentionPeriodMonths     Int
  legalBasis                String?
  confirmedByLegalCounselAt DateTime?

  disposalBatches DisposalBatch[]
  legalHolds      LegalHold[]

  @@unique([organizationId, recordCategory])
  @@index([organizationId])
}

/// Part 6.2 (M06) — records under active Legal Hold (releasedAt IS NULL)
/// are excluded from routine disposal. Reviewed every 6 months (SLA).
/// `retentionScheduleItemId` (Process #52 widening) is what makes the
/// exclusion check against a DisposalBatch's own category mechanically
/// checkable — `scope` stays free text for the human-readable reference
/// (a specific customer file, a litigation case number) a hold not tied to
/// a whole category still needs. `customerId`/`insuredPersonId` (a second,
/// later Process #52 widening — at most one set, independent of
/// `retentionScheduleItemId`) make a hold placed against ONE data subject's
/// file mechanically checkable too — the live cross-check
/// `DsrService.fulfil()` runs before letting a DELETION request close as
/// fully fulfilled, so "never closeable while a retention flag is open"
/// (M04) is a real, current-data check against THIS register, not a staff
/// attestation alone.
model LegalHold {
  id                      String                 @id @default(uuid())
  /// Part I §3.2 (multi-tenancy) — the Organization (brokerage office) this
  /// row belongs to. Supplied by `tenantScopeExtension`, never by hand.
  organizationId          String                 @default(dbgenerated())
  organization            Organization           @relation(fields: [organizationId], references: [id])
  scope                   String // description / entity reference under hold
  reason                  String
  placedAt                DateTime               @default(now())
  nextReviewDueAt         DateTime
  releasedAt              DateTime?
  retentionScheduleItemId String?
  retentionScheduleItem   RetentionScheduleItem? @relation(fields: [retentionScheduleItemId], references: [id])
  customerId              String?
  customer                Customer?              @relation(fields: [customerId], references: [id])
  insuredPersonId         String?
  insuredPerson           InsuredPerson?         @relation(fields: [insuredPersonId], references: [id])

  @@index([retentionScheduleItemId])
  @@index([releasedAt])
  @@index([customerId])
  @@index([insuredPersonId])
  @@index([organizationId])
}

enum DisposalBatchStatus {
  NOMINATED
  MANAGER_APPROVED
  DPO_APPROVED
  EXECUTED
  CLOSED
}

/// Part 5.2, Part 6.2 (M06) — destruction ALWAYS dual control (Department
/// Manager nominates, DPO approves), and ALWAYS produces a Certificate of
/// Destruction. 30-day SLA from batch approval.
model DisposalBatch {
  id                      String                 @id @default(uuid())
  /// Part I §3.2 (multi-tenancy) — the Organization (brokerage office) this
  /// row belongs to. Supplied by `tenantScopeExtension`, never by hand.
  organizationId          String                 @default(dbgenerated())
  organization            Organization           @relation(fields: [organizationId], references: [id])
  retentionScheduleItemId String?
  retentionScheduleItem   RetentionScheduleItem? @relation(fields: [retentionScheduleItemId], references: [id])
  status                  DisposalBatchStatus    @default(NOMINATED)
  nominatedByUserId       String // Department Manager — maker
  managerApprovedAt       DateTime?
  dpoApprovedByUserId     String? // MUST differ from nominatedByUserId
  dpoApprovedAt           DateTime?
  method                  String? // certified_secure_wipe_nist_800_88 | physical_destruction | certified_shredding
  executedAt              DateTime?
  slaDueAt                DateTime? // 30 days from batch approval
  createdAt               DateTime               @default(now())

  certificateOfDestruction CertificateOfDestruction?

  @@index([retentionScheduleItemId])
  @@index([status])
  @@index([organizationId])
}

/// A DisposalBatch cannot reach Closed without this attached.
model CertificateOfDestruction {
  id              String        @id @default(uuid())
  /// Part I §3.2 (multi-tenancy) — the Organization (brokerage office) this
  /// row belongs to. Supplied by `tenantScopeExtension`, never by hand.
  organizationId  String        @default(dbgenerated())
  organization    Organization  @relation(fields: [organizationId], references: [id])
  disposalBatchId String        @unique
  disposalBatch   DisposalBatch @relation(fields: [disposalBatchId], references: [id])
  issuedAt        DateTime      @default(now())
  issuedByUserId  String

  @@index([organizationId])
}

/// Part 6.2 — any transfer of personal data outside Jordan is blocked
/// unless exactly one of three bases is recorded.
model CrossBorderTransferRecord {
  id                    String       @id @default(uuid())
  /// Part I §3.2 (multi-tenancy) — the Organization (brokerage office) this
  /// row belongs to. Supplied by `tenantScopeExtension`, never by hand.
  organizationId        String       @default(dbgenerated())
  organization          Organization @relation(fields: [organizationId], references: [id])
  description           String
  destinationCountry    String
  legalBasis            String // statutory_exception | standard_contractual_clauses | explicit_consent
  legalBasisEvidenceRef String?
  approvedByUserId      String?
  transferredAt         DateTime     @default(now())

  @@index([organizationId])
}

/// Part 7.5 / Part 9.3 (M07) — insurers, reinsurers, loss adjusters, IT/
/// cloud vendors, printing/archiving, marketing/call-centre vendors.
/// Merges Process 71 (Vendor Management) and PDPL third-party governance —
/// both describe the same register in these two source documents.
model Vendor {
  id                               String                   @id @default(uuid())
  /// Part I §3.2 (multi-tenancy) — the Organization (brokerage office) this
  /// row belongs to. Supplied by `tenantScopeExtension`, never by hand.
  organizationId                   String                   @default(dbgenerated())
  organization                     Organization             @relation(fields: [organizationId], references: [id])
  name                             String
  vendorType                       String // insurer | reinsurer | loss_adjuster | it_cloud | printing_archiving | marketing_call_centre | other
  riskTier                         String? // low | medium | high — assigned before any data is shared or access granted
  annualReviewDueAt                DateTime?
  terminationDataReturnConfirmedAt DateTime?
  accessRevokedAt                  DateTime? // within 2 business days of termination
  createdAt                        DateTime                 @default(now())
  // Part F item #6 — bilingual full-text search, from name. See
  // Customer.searchVector's own comment.
  searchVector                     Unsupported("tsvector")?

  dataProcessingAgreements DataProcessingAgreement[]
  dataSharingApprovals     DataSharingApproval[]

  @@index([organizationId])
}

/// Part 7.5 — mandatory for Medium/High tier before go-live; High tier
/// additionally requires DPO approval before first data share.
model DataProcessingAgreement {
  id                  String       @id @default(uuid())
  /// Part I §3.2 (multi-tenancy) — the Organization (brokerage office) this
  /// row belongs to. Supplied by `tenantScopeExtension`, never by hand.
  organizationId      String       @default(dbgenerated())
  organization        Organization @relation(fields: [organizationId], references: [id])
  vendorId            String
  vendor              Vendor       @relation(fields: [vendorId], references: [id])
  signedAt            DateTime?
  // Maker/checker (Part 5.2): the Relationship Owner who assessed this
  // vendor and prepared the agreement — MUST differ from dpoApprovedByUserId
  // (app- and DB-enforced).
  assessedByUserId    String?
  dpoApprovedByUserId String? // required for High tier
  expiresAt           DateTime?

  @@index([organizationId])
}

/// Part 10.6/M08 — the data-sharing channel picklist. CONFIDENTIAL/
/// HIGHLY_CONFIDENTIAL shares may only pick a channel in the SECURE_*
/// subset — assertSecureChannel() (apps/api/src/modules/security/
/// secure-channel.util.ts) rejects the rest for those two classifications;
/// see meta/lex/sensitive-data-handling.md "any data share where the picked
/// channel is not on the approved secure-channel list."
enum DataSharingChannel {
  SECURE_SFTP
  ENCRYPTED_EMAIL
  VENDOR_SECURE_PORTAL
  CBJ_REGULATORY_PORTAL
  IN_PERSON_ENCRYPTED_MEDIA
  UNENCRYPTED_EMAIL
  POSTAL_MAIL
  OTHER_UNSECURED
}

/// Part 7.5 (M08) — one-off, non-recurring data shares outside a standing
/// vendor relationship. 3 business days standard SLA, 1 business day for
/// a recognized regulatory channel (e.g. CBJ Data Portal/iFile).
model DataSharingApproval {
  id                  String             @id @default(uuid())
  /// Part I §3.2 (multi-tenancy) — the Organization (brokerage office) this
  /// row belongs to. Supplied by `tenantScopeExtension`, never by hand.
  organizationId      String             @default(dbgenerated())
  organization        Organization       @relation(fields: [organizationId], references: [id])
  vendorId            String?
  vendor              Vendor?            @relation(fields: [vendorId], references: [id])
  description         String
  classification      DataClassification // of the data being shared — drives assertSecureChannel()
  channel             DataSharingChannel
  isRegulatoryChannel Boolean            @default(false) // exempt from standard vendor-risk workflow, still classification-checked
  requestedByUserId   String
  approvedByUserId    String? // DPO — MUST differ from requestedByUserId
  slaDueAt            DateTime
  decidedAt           DateTime?
  createdAt           DateTime           @default(now())

  @@index([classification])
  @@index([organizationId])
}

enum DpiaOutcome {
  AUTO_APPROVED
  DPO_REVIEW_REQUIRED
  ESCALATED_FULL_DPIA
}

/// Part 6.2 (M10) — 5-question yes/no screening before any new product,
/// system, campaign or vendor integration involving personal data goes
/// live. Any single "Yes" -> mandatory DPO review within 5 business days.
model DpiaScreening {
  id                       String       @id @default(uuid())
