  organization      Organization @relation(fields: [organizationId], references: [id])
  touchpoint        String // lead_capture | onboarding_kyc | needs_risk_assessment | rfq_market_placement | claims | group_medical_life_motor_fleet | renewal_cross_sell
  versionNumber     Int          @default(1)
  textAr            String
  textEn            String
  legallyReviewedAt DateTime?
  publishedAt       DateTime     @default(now())

  @@unique([organizationId, touchpoint, versionNumber])
  @@index([organizationId])
