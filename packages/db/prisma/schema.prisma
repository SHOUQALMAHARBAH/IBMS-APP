  /// row belongs to. Supplied by `tenantScopeExtension`, never by hand.
  organizationId           String       @default(dbgenerated())
  organization             Organization @relation(fields: [organizationId], references: [id])
  subjectDescription       String // the product/system/campaign/vendor integration being screened
  qSensitiveData           Boolean
  qLargeScaleProcessing    Boolean
  qCrossBorderTransfer     Boolean
  qNewTechnologyMonitoring Boolean
  qNewDigitalChannel       Boolean
  outcome                  DpiaOutcome
  dpoReviewDueAt           DateTime?
  dpoReviewedAt            DateTime?
  dpoSpotCheckedAt         DateTime? // for all-"No" auto-approved results
  escalatedToFullDpiaAt    DateTime?
  createdAt                DateTime     @default(now())

  @@index([organizationId])
}

/// Part 6.2 — bilingual, version-controlled privacy notice text presented
/// at each relevant collection point. Publishing a new version for a
/// touchpoint is a new row, never an edit of an old one (immutable
/// history, the Quotation negotiation-round shape) — @@unique closes the
/// race where two concurrent publishes for the same touchpoint could
/// otherwise land on the same versionNumber.
model PrivacyNotice {
  id                String       @id @default(uuid())
