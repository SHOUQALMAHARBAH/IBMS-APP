// ============================================================================
// IBMS — Insurance Brokerage Management System
// Full database schema — Prisma / PostgreSQL
//
// SOURCE: this schema is derived exclusively from the two documents supplied
// for this build:
//   1. IBMS_Full_Scope_Context_Document.docx  (Parts 1-13 + Appendices A-C)
//   2. تصور عمليات وسطاء التأمين.pdf           (12 process groups, same model)
//
// Every model below is commented with the Part/Process it comes from so the
// schema stays traceable to its source. Nothing here is invented outside
// those two documents' content.
//
// CROSS-CUTTING RULES BUILT INTO THIS SCHEMA (apply to every model below):
//   1. Maker/Checker (Part 5.2): any model with an approval step carries a
//      maker field (e.g. `createdByUserId`) and a checker field (e.g.
//      `approvedByUserId`) that MUST resolve to two distinct users. Every
//      write of a checker field MUST call `assertDifferentActors()`
//      (apps/api/src/common/maker-checker.util.ts) — not enforceable in
//      Prisma schema syntax alone. A DB-level CHECK constraint per table
//      (raw-SQL migration `add_maker_checker_check_constraints`) backs the
//      same invariant so it can't be bypassed by a caller that skips the
//      application layer entirely.
//   2. Money (Part 3.6 Controls): every monetary field is `Decimal(18, 3)`
//      — JOD's minor unit is the fils (1/1000 JOD), never a float.
//   3. Workflow state (Parts 3.x "Workflow States" rows): status fields are
//      plain enums here, but MUST only be written through an application
//      `transition()` function — never assigned directly. See AuditLogEntry.
//   4. Data classification (Part 6.1): `DataClassification` is attached to
//      every entity that can hold personal or sensitive data.
//   5. Audit trail (Part 10.3): AuditLogEntry is immutable and polymorphic,
//      covering create/read/update/delete/approve on every entity below,
//      including READ access to Highly Confidential data.
//   6. Encryption (Part 10.2): field-level encryption is an application-layer
//      concern for the fields flagged `-- ENCRYPT` in the comments below
//      (national ID, bank account, medical data) — Prisma stores them as
//      opaque encrypted strings (`String` columns), never as plaintext.
//   7. Versioning (Part 4.1, 3.3): Quotation and Document are never
//      overwritten — a new version row is created and linked via
//      `previousVersionId` / `isCurrentVersion`.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// SHARED ENUMS
// ============================================================================

/// Part 6.1 — the single, binding four-tier classification model.
/// Every Part 4 data entity carries one of these four labels.
enum DataClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  HIGHLY_CONFIDENTIAL
}

enum LanguagePreference {
  AR
  EN
}

/// Part 5.1 — illustrative role catalogue.
enum RoleName {
  SALES_RELATIONSHIP_OFFICER
  PLACEMENT_TECHNICAL_OFFICER
  POLICY_CHECKING_OFFICER
  CLAIMS_OFFICER
  FINANCE_COLLECTIONS_OFFICER
  COMPLIANCE_OFFICER
  BRANCH_DEPARTMENT_MANAGER
  DATA_PROTECTION_OFFICER
  SYSTEM_SECURITY_ADMINISTRATOR
  EXECUTIVE_MANAGEMENT
  EXTERNAL_AUDITOR
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  APPROVE
  REJECT
  TRANSITION
  EXPORT
  PRINT
  // Part 10.1 — auth/session lifecycle events, logged the same as any other
  // AuditLogEntry action (entityType "User", entityId = the acting user).
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  MFA_ENROLLED
  MFA_VERIFIED
  MFA_FAILED
  STEP_UP_VERIFIED
  ACCESS_WINDOW_EXPIRED
  // Part 10.2 — centralized key management: every encrypt/decrypt of a
  // field-level `-- ENCRYPT` column logs which key was used. entityType/
  // entityId carry the owning record (e.g. "Customer"/<id>); afterValue
  // carries { keyId, purpose, field, operation } — never plaintext/ciphertext.
  ENCRYPTION_KEY_USED
  // Part 6.2/7/3.x SLA registry (ibms-brain/meta/lex/pdpl-sla-timers.md,
  // backlog A.8): written by SlaTimerService when its scheduled sweep marks
  // an overdue SlaTimer row escalated. entityType/entityId carry the
  // underlying business entity (not "SlaTimer" itself); afterValue carries
  // { slaTimerId, workflowName, escalatedTo, dueAt }.
  SLA_ESCALATED
}

/// Part 10.1 — how a user authenticates. SSO is a reserved integration point
/// (Part 10.1 "SSO integration point, optional per broker") — no identity
/// provider is wired yet; see meta/designs for why none is assumed.
enum AuthProvider {
  LOCAL
  SSO
}

/// Part 10.1 — MFA factor type. WEBAUTHN is schema-reserved for the
/// hardware-token fast-follow (mandatory for privileged roles / Compliance
/// / DPO) — no enrollment/verification path exists for it yet.
/// Part II §4.1.3.
enum MfaMethod {
  TOTP_APP
  SMS
  EMAIL
}

enum MfaCredentialType {
  TOTP
  WEBAUTHN
}

// ============================================================================
// MULTI-TENANCY — PART I of the multi-tenant architecture spec
//
// Every brokerage office using this platform is one `Organization`. Office A
// must never be able to see, query, export, search, or infer the EXISTENCE of
// Office B's customers, employees, policies, claims, documents or audit logs
// (spec §1). That is enforced at two independent layers:
//
//   1. Application layer — a Prisma middleware/interceptor injects the current
//      request's `organizationId` into every query. NOT BUILT YET (Phase 2).
//   2. Database layer — PostgreSQL Row-Level Security keyed to a session
//      variable `app.current_org_id`. NOT BUILT YET (Phase 2).
//
// This phase (Phase 1) is schema + backfill ONLY: the column exists on every
// tenant-scoped table and every existing row points at one seeded
// Organization. Nothing enforces isolation yet.
//
// ---------------------------------------------------------------------------
// THE TEMPORARY `@default` IS GONE — PHASE 2 REMOVED IT (migration 20260927100000)
// ---------------------------------------------------------------------------
// Through Phase 1 every tenant-scoped `organizationId` carried
// `@default("00000000-0000-0000-0000-000000000001")`. That was a deliberate,
// temporary device: it made the column NOT NULL from the very first migration,
// backfilled every pre-existing row inside the same `ALTER TABLE`, and kept
// every existing `.create()` call site compiling, which is what let Phase 1 be
// "schema + backfill, no application change".
//
// It is now removed, because from Phase 2 onwards it would be a hazard rather
// than a convenience: a write path the org-scoping audit missed would SILENTLY
// succeed with the default office's id instead of failing loudly, masking
// exactly the gap that phase exists to catch.
//
// `organizationId` is now supplied by `tenantScopeExtension`
// (apps/api/src/prisma/tenant-scope.extension.ts), which injects it into every
// query — including nested relation writes — and refuses to run a tenant-scoped
// query at all when there is no Organization in context. Nothing in the API
// passes it by hand.
//
// The one place that still writes it explicitly is `prisma/seed.ts`, which runs
// outside the API and therefore outside the extension.
// ============================================================================

/// Spec §2 — one brokerage office on the platform. Deliberately NOT itself
/// tenant-scoped: it is the tenant.
///
/// `legalNameAr` is not decoration. Arabic is this system's primary language
/// (English is the secondary), so an office's name has to be storable in the
/// language the UI actually runs in — otherwise switching to Arabic leaves the
/// org name sitting in Latin script in the middle of an Arabic page. Same
/// reasoning as `Customer.legalNameAr` / `Insurer.nameAr` elsewhere in this
/// schema.
model Organization {
  id                         String    @id @default(uuid())
  legalName                  String
  /// Arabic legal name — see the model comment. Optional only because an
  /// office may be onboarded before its registered Arabic name is confirmed.
  legalNameAr                String?
  /// This office's own CBJ broker license number. Distinct from the
  /// `BrokerLicense` model, which tracks a license's lifecycle per office.
  brokerLicenseNumber        String?
  /// Tenant resolution key (spec §4.10) — e.g. "alsalam" resolves
  /// alsalam.ibms-app.example to this row BEFORE any login step runs.
  /// Nothing consumes it yet; `GET /orgs/resolve` arrives in Phase 4.
  subdomain                  String    @unique
  status                     OrgStatus @default(ACTIVE)
  /// Spec §10.5 — OPTIONAL edge-case fallback only. In the normal org chart the
  /// DPO (Office Manager) and a Branch/Department Manager are structurally
  /// different people, so maker/checker on a disposal batch already resolves to
  /// two humans. This exists solely for an office small enough that one person
  /// holds both titles, and names whoever approves in their place.
  /// Deliberately a plain id, NOT a User relation — a second
  /// Organization<->User relation would force every other relation in this
  /// file to be explicitly named.
  dpoAlternateApproverUserId String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  accessAnomalyAlerts             AccessAnomalyAlert[]
  accessDeprovisioningChecklists  AccessDeprovisioningChecklist[]
  accessRecertificationCycles     AccessRecertificationCycle[]
  accessRecertificationItems      AccessRecertificationItem[]
  adjusters                       Adjuster[]
  assets                          Asset[]
  auditLogEntries                 AuditLogEntry[]
  emailIntegration                OrganizationEmailIntegration?
  bcpDrPlans                      BcpDrPlan[]
  branches                        Branch[]
  brokerLicenses                  BrokerLicense[]
  cancellations                   Cancellation[]
  certificateOfDestructions       CertificateOfDestruction[]
  claims                          Claim[]
  claimDocuments                  ClaimDocument[]
  claimFollowUpAlerts             ClaimFollowUpAlert[]
  claimStatusHistories            ClaimStatusHistory[]
  clientDecisions                 ClientDecision[]
  clientFundsLedgerEntries        ClientFundsLedgerEntry[]
  commissionAgreements            CommissionAgreement[]
  commissionLedgerEntries         CommissionLedgerEntry[]
  commissionReversals             CommissionReversal[]
  communicationLogs               CommunicationLog[]
  comparisonMatrixes              ComparisonMatrix[]
  comparisonMatrixRows            ComparisonMatrixRow[]
  complaints                      Complaint[]
  complaintActions                ComplaintAction[]
  complianceCalendarItems         ComplianceCalendarItem[]
  conflictOfInterestDisclosures   ConflictOfInterestDisclosure[]
  consentRecords                  ConsentRecord[]
  coverNotes                      CoverNote[]
  crossBorderTransferRecords      CrossBorderTransferRecord[]
  crossSellOpportunities          CrossSellOpportunity[]
  customers                       Customer[]
  customerFeedbacks               CustomerFeedback[]
  dataProcessingAgreements        DataProcessingAgreement[]
  dataSharingApprovals            DataSharingApproval[]
  dataSubjectRequests             DataSubjectRequest[]
  deliveryRecords                 DeliveryRecord[]
  departments                     Department[]
  disposalBatches                 DisposalBatch[]
  documents                       Document[]
  documentTemplates               DocumentTemplate[]
  dpiaScreenings                  DpiaScreening[]
  employees                       Employee[]
  employeePerformanceRecords      EmployeePerformanceRecord[]
  endorsements                    Endorsement[]
  escalationRecords               EscalationRecord[]
  incidentReports                 IncidentReport[]
  informationAssets               InformationAsset[]
  insurancePrograms               InsuranceProgram[]
  insuranceProgramLines           InsuranceProgramLine[]
  insuredPersons                  InsuredPerson[]
  insurers                        Insurer[]
  insurerPerformanceScores        InsurerPerformanceScore[]
  insurerProducts                 InsurerProduct[]
  insurerSlaAgreements            InsurerSlaAgreement[]
  interactions                    Interaction[]
  internalAuditFindings           InternalAuditFinding[]
  invoices                        Invoice[]
  knowledgeBaseArticles           KnowledgeBaseArticle[]
  kyCRecords                      KYCRecord[]
  leads                           Lead[]
  legalHolds                      LegalHold[]
  lossRatios                      LossRatio[]
  mfaCredentials                  MfaCredential[]
  needsAssessments                NeedsAssessment[]
  opportunities                   Opportunity[]
  passwordHistoryEntries          PasswordHistoryEntry[]
  passwordResetTokens             PasswordResetToken[]
  paymentChannels                 PaymentChannel[]
  policies                        Policy[]
  policyCheckings                 PolicyChecking[]
  policySchedules                 PolicySchedule[]
  premiumTransactions             PremiumTransaction[]
  privacyNotices                  PrivacyNotice[]
  professionalIndemnityPolicies   ProfessionalIndemnityPolicy[]
  professionalIndemnityRiskEvents ProfessionalIndemnityRiskEvent[]
  prospects                       Prospect[]
  quotations                      Quotation[]
  receipts                        Receipt[]
  recommendations                 Recommendation[]
  reconciliationExceptions        ReconciliationException[]
  refreshTokens                   RefreshToken[]
  refunds                         Refund[]
  remittances                     Remittance[]
  renewalCases                    RenewalCase[]
  renewalRecommendations          RenewalRecommendation[]
  retentionCases                  RetentionCase[]
  roles                           Role[]
  rolePermissions                 RolePermission[]
  retentionScheduleItems          RetentionScheduleItem[]
  rfqs                            RFQ[]
  rfQInsurers                     RFQInsurer[]
  riskProfiles                    RiskProfile[]
  riskRatings                     RiskRating[]
