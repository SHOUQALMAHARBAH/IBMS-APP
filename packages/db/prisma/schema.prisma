// ============================================================================
// IBMS — Insurance Brokerage Management System
// Full database schema — Prisma / PostgreSQL
//
// SOURCE: this schema is derived exclusively from the two documents supplied
// for this build:
//   1. IBMS_Full_Scope_Context_Document.docx  (Parts 1-13 + Appendices A-C)
//   2. تصور عمليات وسطاء التأمين.pdf           (12 process groups, same model)
//
// Every model below is commented with the Part/Process it comes from so the
// schema stays traceable to its source. Nothing here is invented outside
// those two documents' content.
//
// CROSS-CUTTING RULES BUILT INTO THIS SCHEMA (apply to every model below):
//   1. Maker/Checker (Part 5.2): any model with an approval step carries a
//      maker field (e.g. `createdByUserId`) and a checker field (e.g.
//      `approvedByUserId`) that MUST resolve to two distinct users. Every
//      write of a checker field MUST call `assertDifferentActors()`
//      (apps/api/src/common/maker-checker.util.ts) — not enforceable in
//      Prisma schema syntax alone. A DB-level CHECK constraint per table
//      (raw-SQL migration `add_maker_checker_check_constraints`) backs the
//      same invariant so it can't be bypassed by a caller that skips the
//      application layer entirely.
//   2. Money (Part 3.6 Controls): every monetary field is `Decimal(18, 3)`
//      — JOD's minor unit is the fils (1/1000 JOD), never a float.
//   3. Workflow state (Parts 3.x "Workflow States" rows): status fields are
//      plain enums here, but MUST only be written through an application
//      `transition()` function — never assigned directly. See AuditLogEntry.
//   4. Data classification (Part 6.1): `DataClassification` is attached to
//      every entity that can hold personal or sensitive data.
//   5. Audit trail (Part 10.3): AuditLogEntry is immutable and polymorphic,
//      covering create/read/update/delete/approve on every entity below,
//      including READ access to Highly Confidential data.
//   6. Encryption (Part 10.2): field-level encryption is an application-layer
//      concern for the fields flagged `-- ENCRYPT` in the comments below
//      (national ID, bank account, medical data) — Prisma stores them as
//      opaque encrypted strings (`String` columns), never as plaintext.
//   7. Versioning (Part 4.1, 3.3): Quotation and Document are never
//      overwritten — a new version row is created and linked via
//      `previousVersionId` / `isCurrentVersion`.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// SHARED ENUMS
// ============================================================================

/// Part 6.1 — the single, binding four-tier classification model.
/// Every Part 4 data entity carries one of these four labels.
enum DataClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  HIGHLY_CONFIDENTIAL
}

enum LanguagePreference {
  AR
  EN
}

/// Part 5.1 — illustrative role catalogue.
enum RoleName {
  SALES_RELATIONSHIP_OFFICER
  PLACEMENT_TECHNICAL_OFFICER
  POLICY_CHECKING_OFFICER
  CLAIMS_OFFICER
  FINANCE_COLLECTIONS_OFFICER
  COMPLIANCE_OFFICER
  BRANCH_DEPARTMENT_MANAGER
  DATA_PROTECTION_OFFICER
  SYSTEM_SECURITY_ADMINISTRATOR
  EXECUTIVE_MANAGEMENT
  EXTERNAL_AUDITOR
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  APPROVE
  REJECT
  TRANSITION
  EXPORT
  PRINT
  // Part 10.1 — auth/session lifecycle events, logged the same as any other
  // AuditLogEntry action (entityType "User", entityId = the acting user).
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  MFA_ENROLLED
  MFA_VERIFIED
  MFA_FAILED
  STEP_UP_VERIFIED
  ACCESS_WINDOW_EXPIRED
  // Part 10.2 — centralized key management: every encrypt/decrypt of a
  // field-level `-- ENCRYPT` column logs which key was used. entityType/
  // entityId carry the owning record (e.g. "Customer"/<id>); afterValue
  // carries { keyId, purpose, field, operation } — never plaintext/ciphertext.
  ENCRYPTION_KEY_USED
  // Part 6.2/7/3.x SLA registry (ibms-brain/meta/lex/pdpl-sla-timers.md,
  // backlog A.8): written by SlaTimerService when its scheduled sweep marks
  // an overdue SlaTimer row escalated. entityType/entityId carry the
  // underlying business entity (not "SlaTimer" itself); afterValue carries
  // { slaTimerId, workflowName, escalatedTo, dueAt }.
  SLA_ESCALATED
}

/// Part 10.1 — how a user authenticates. SSO is a reserved integration point
/// (Part 10.1 "SSO integration point, optional per broker") — no identity
/// provider is wired yet; see meta/designs for why none is assumed.
enum AuthProvider {
  LOCAL
  SSO
}

/// Part 10.1 — MFA factor type. WEBAUTHN is schema-reserved for the
/// hardware-token fast-follow (mandatory for privileged roles / Compliance
/// / DPO) — no enrollment/verification path exists for it yet.
enum MfaCredentialType {
  TOTP
  WEBAUTHN
}

// ============================================================================
// PART 5 / 10.1 — IDENTITY, ROLES & ACCESS CONTROL
// ============================================================================

/// Part 5.1, Part 10.1 — a system user. MFA/session details live at the
/// auth-provider layer; this table is the authorization anchor.
model User {
  id                String    @id @default(uuid())
  fullName          String
  email             String    @unique
  passwordHash      String
  passwordUpdatedAt DateTime?
  isActive          Boolean   @default(true)
  languagePreference LanguagePreference @default(AR)
  branchId          String?
  branch            Branch?   @relation(fields: [branchId], references: [id])
  employeeId        String?   @unique
  employee          Employee? @relation(fields: [employeeId], references: [id])
  authProvider      AuthProvider @default(LOCAL)
  mfaEnabled        Boolean   @default(false)
  lastLoginAt       DateTime?
  failedLoginAttempts Int     @default(0)
  lockedUntil       DateTime? // Part 10.1 — automatic lockout after repeated failed logins
  // External Auditor (Part 5.1) — time-boxed access
  accessValidFrom   DateTime?
  accessValidUntil  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  roles             UserRoleAssignment[]
  auditLogEntries   AuditLogEntry[]        @relation("AuditLogUser")
  accessAnomalyAlerts AccessAnomalyAlert[] @relation("AccessAnomalyAlertUser")
  recertifications  AccessRecertificationItem[] @relation("RecertificationReviewer")
  mfaCredentials    MfaCredential[]
  refreshTokens     RefreshToken[]
  sessions          UserSession[]
  passwordResetTokens PasswordResetToken[]

  @@index([email])
}

/// Part 10.1 — a single enrolled MFA factor. A user may hold more than one
/// (e.g. TOTP now, a hardware key later) — `isActive` lets one be retired
/// without losing the audit trail of when it was enrolled/used.
model MfaCredential {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  type          MfaCredentialType
  secretEnc     String?  // TOTP secret -- ENCRYPT (Part 10.2)
  label         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  lastUsedAt    DateTime?
  // Reserved for the WebAuthn/hardware-token fast-follow — unused by TOTP.
  webauthnCredentialId String? @unique
  webauthnPublicKeyEnc String? // -- ENCRYPT
  webauthnCounter      Int?

  @@index([userId])
}

/// Part 10.1 — issued refresh tokens. The raw token is never stored, only
/// its hash (`token.service.ts` hashes with sha256 before persisting) —
/// same principle as password hashing, applied to bearer secrets.
/// `replacedByTokenId` chains rotation so reuse of a retired token (a stolen
/// or replayed refresh token) is detectable, not just "expired eventually."
model RefreshToken {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  tokenHash         String   @unique
  issuedAt          DateTime @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?  @unique
  userAgent         String?
  ipAddress         String?

  session           UserSession?

  @@index([userId])
}

/// Part 10.1 / Part 8.3 — the live-session anchor idle-timeout enforcement
/// and the External Auditor time-boxed access window both key off.
/// `lastActivityAt` is bumped by the session heartbeat; a request outside
/// `SecurityConfig.idleTimeoutMinutes` or past `User.accessValidUntil` is
/// rejected AND the session is revoked here (not just refused at login).
model UserSession {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  refreshTokenId String?  @unique
  refreshToken   RefreshToken? @relation(fields: [refreshTokenId], references: [id])
  createdAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())
  lastStepUpAt   DateTime? // Part 10.1 — forced re-auth before sensitive actions
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedReason  String?  // idle_timeout | logout | access_window_expired | admin_revoked | refresh_reuse_detected
  ipAddress      String?
  userAgent      String?

  @@index([userId])
}

/// Part 10.1 — forgot-password flow. Single-use (`usedAt`), short-lived,
/// hashed the same way as RefreshToken.
model PasswordResetToken {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  tokenHash   String   @unique
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?
  createdAt   DateTime @default(now())

  @@index([userId])
}

/// Part 10.1 / Part 8.3 — single-row, admin-editable security configuration
/// (idle timeout, token lifetimes, lockout policy). Deliberately real data
/// the System/Security Administrator role edits, not an env var only — see
/// roles-and-segregation-of-duties.md for that role's mandate. The
/// application layer enforces the single-row invariant (fixed id "default").
model SecurityConfig {
  id                         String   @id @default("default")
  idleTimeoutMinutes         Int      @default(15)
  hardLogoutAfterIdleMinutes Int      @default(30)
  accessTokenTtlMinutes      Int      @default(15)
  refreshTokenTtlDays        Int      @default(14)
  stepUpMaxAgeMinutes        Int      @default(10)
  maxFailedLoginAttempts     Int      @default(5)
  lockoutMinutes             Int      @default(15)
  updatedByUserId            String?
  updatedAt                  DateTime @updatedAt
}

/// Part 5.1 — role catalogue.
model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  description String?
  createdAt   DateTime @default(now())

  users       UserRoleAssignment[]
  permissions RolePermission[]
}

/// Part 4.1 core entity ("User / Role / Permission", n..n Role<->Permission)
/// / Process 40 (staff permissions management) — the granular can/cannot
/// grid illustrated per role in Part 5.1 (e.g. Sales Officer can create
/// Lead/Customer/RFQ but cannot approve refunds or delete claims).
model Permission {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. "policy.check", "refund.approve", "claim.delete"
  module      String   // maps to a Part 2 domain / PCMS module, e.g. "claims", "finance", "m04_dsr"
  description String?

  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

/// Explicit many-to-many: a user may hold more than one role (Part 5.1 notes
/// the DPO/Compliance Officer dual-hat as a conditional, recorded case).
model UserRoleAssignment {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  roleId   String
  role     Role     @relation(fields: [roleId], references: [id])
  grantedAt DateTime @default(now())
  // Part 10.1 — set when an access-recertification decision revokes this
  // grant (AccessRecertificationItem.decision = "revoked"). A row with
  // revokedAt set is no longer an active assignment, but is kept (not
  // deleted) as the audit record of when/that access was withdrawn.
  revokedAt DateTime?

  @@unique([userId, roleId])
}

/// Part 10.1 — periodic (e.g. quarterly) access recertification workflow.
model AccessRecertificationCycle {
  id          String   @id @default(uuid())
  cycleLabel  String
  startedAt   DateTime @default(now())
  dueAt       DateTime
  closedAt    DateTime?
  items       AccessRecertificationItem[]
}

model AccessRecertificationItem {
  id            String   @id @default(uuid())
  cycleId       String
  cycle         AccessRecertificationCycle @relation(fields: [cycleId], references: [id])
  subjectUserId String
  reviewerUserId String
  reviewer      User     @relation("RecertificationReviewer", fields: [reviewerUserId], references: [id])
  decision      String?  // confirmed | revoked | changed
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())
}

/// Supporting structure referenced by "filterable by branch" dashboards
/// (Part 13) and Branch/Department Manager role (Part 5.1).
model Branch {
  id     String @id @default(uuid())
  name   String
  nameAr String?
  users  User[]
}

/// Process 66 — Human Resources. Minimal record: licensing/certification
/// tracking for regulated staff, training records (Part 8.2).
model Employee {
  id                     String    @id @default(uuid())
  fullName               String
  nationalIdEnc          String    // -- ENCRYPT (Part 10.2 field-level encryption)
  position               String?
  hireDate               DateTime?
  terminationDate        DateTime?
  licensedRole           String?   // e.g. regulated staff licensing/certification (Part 8.2)
  confidentialityAgreementSignedAt DateTime? // Part 8.2 NDAs
  backgroundCheckCompletedAt DateTime? // Part 8.2 screening
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user                   User?
  trainings              SecurityAwarenessTraining[]
  deprovisioningChecklist AccessDeprovisioningChecklist?
  performanceRecords     EmployeePerformanceRecord[]
}

/// Part 8.2 — security awareness training completion tracking.
model SecurityAwarenessTraining {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  trainingName String
  completedAt  DateTime?
  dueAt        DateTime?
}

/// Part 8.2 — termination/change-of-employment de-provisioning checklist,
/// triggered by HR status change (Part 5, PDPL SLA: same business day).
model AccessDeprovisioningChecklist {
  id                  String    @id @default(uuid())
  employeeId          String    @unique
  employee            Employee  @relation(fields: [employeeId], references: [id])
  triggeredAt         DateTime  @default(now())
  systemAccessRevokedAt DateTime?
  physicalAccessRevokedAt DateTime?
  deviceReturnedAt    DateTime?
  knowledgeTransferDoneAt DateTime?
  completedAt         DateTime?
}

// ============================================================================
// PART 2 DOMAIN A / PART 4 — LEAD, PROSPECT, CUSTOMER, CRM (Processes 1-10)
// ============================================================================

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED_TO_PROSPECT
  DISQUALIFIED
}

/// Process 1 — Lead Management. Captured from referrals, website, social
/// media, campaigns, tenders, corporate/bank partnerships, strategic
/// partners, ex-customers, renewal opportunities.
model Lead {
  id            String     @id @default(uuid())
  fullName      String
  source        String     // referral | website | social_media | campaign | tender | bank_partner | strategic_partner | ex_customer | renewal
  ownerUserId   String
  status        LeadStatus @default(NEW)
  contactPhone  String?
  contactEmail  String?
  // marketing consent captured distinctly from KYC consent, unticked by default (Part 6.3)
  marketingConsentGranted Boolean @default(false)
  firstContactAt DateTime  @default(now())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  prospect      Prospect?

  @@index([ownerUserId])
  @@index([source])
  @@index([status])
}

/// Process 2 — Prospect Management (qualification of a Lead).
model Prospect {
  id                String   @id @default(uuid())
  leadId            String?  @unique
  lead              Lead?    @relation(fields: [leadId], references: [id])
  companyName       String
  sector            String?
  activity          String?
  employeeCount     Int?
  businessSize      String?
  location          String?
  contactPerson     String?
  productsOfInterest String[] // e.g. Medical, Motor, Property, Fire, Liability
  expectedPremium   Decimal? @db.Decimal(18, 3)
  salesOwnerUserId  String
  status            String   @default("qualifying")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customer          Customer?

  @@index([salesOwnerUserId])
}

enum CustomerType {
  INDIVIDUAL
  CORPORATE
}

enum CustomerStatus {
  PENDING_KYC
  ACTIVE
  SUSPENDED
  CLOSED
}

/// Part 4.1 core entity — the central Customer record (individual or
/// corporate). Process 3-4 (Onboarding/KYC).
model Customer {
  id                String         @id @default(uuid())
  prospectId        String?        @unique
  prospect          Prospect?      @relation(fields: [prospectId], references: [id])
  customerType      CustomerType
  legalName         String         // corporate: legal name; individual: full name
  registrationNumber String?       // corporate: commercial registration number
  nationalIdEnc     String?        // individual -- ENCRYPT
  taxRegistrationNumber String?
  registeredAddress String?
  natureOfBusiness  String?
  contactPhoneEnc   String?        // -- ENCRYPT (Confidential)
  contactEmailEnc   String?        // -- ENCRYPT (Confidential)
  languagePreference LanguagePreference @default(AR)
  status            CustomerStatus @default(PENDING_KYC)
  classification    DataClassification @default(CONFIDENTIAL)
  ownerUserId       String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  ubos              UltimateBeneficialOwner[]
  kycRecords        KYCRecord[]
  riskProfiles      RiskProfile[]
  opportunities     Opportunity[]
  policies          Policy[]
  claims            Claim[]              @relation("ClaimCustomer")
  complaints        Complaint[]
  interactions      Interaction[]
  insuredPersons    InsuredPerson[]
  consentRecords    ConsentRecord[]
  dataSubjectRequests DataSubjectRequest[] @relation("DsrCustomer")
  documents         Document[]           @relation("CustomerDocuments")
  invoices          Invoice[]
  clientFundsLedgerEntries ClientFundsLedgerEntry[]
  serviceRequests   ServiceRequest[]
  feedback          CustomerFeedback[]
  retentionCases    RetentionCase[]
  crossSellOpportunities CrossSellOpportunity[]
  upSellRecommendations  UpSellRecommendation[]
  transactionMonitoringAlerts TransactionMonitoringAlert[]

  @@index([legalName])
  @@index([status])
}

/// Process 3 — corporate KYC: Ultimate Beneficial Owner identification.
model UltimateBeneficialOwner {
  id             String   @id @default(uuid())
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  fullName       String
  nationalIdEnc  String   // -- ENCRYPT
  ownershipPercent Decimal? @db.Decimal(5, 2)
  isAuthorizedSignatory Boolean @default(false)
  isPep          Boolean  @default(false)
  createdAt      DateTime @default(now())
}

/// Part 4.1 note — a natural person covered by a policy who is NOT the
/// contracting Customer (insured employee, driver, beneficiary). Carries
/// its own consent/DSR record.
model InsuredPerson {
  id              String   @id @default(uuid())
  customerId      String   // the contracting Customer this person is covered under
  customer        Customer @relation(fields: [customerId], references: [id])
  policyId        String?
  policy          Policy?  @relation(fields: [policyId], references: [id])
  role            String   // employee_group_medical | driver_motor_fleet | beneficiary_life | other
  fullName        String
  nationalIdEnc   String?  // -- ENCRYPT
  dateOfBirth     DateTime?
  classification  DataClassification @default(CONFIDENTIAL)
  createdAt       DateTime @default(now())

  consentRecords  ConsentRecord[]
  dataSubjectRequests DataSubjectRequest[] @relation("DsrInsuredPerson")
}

/// Process 3-4 (Customer Acquisition/Onboarding) KYC lifecycle — mirrors the
/// model's original comment 1:1 so WorkflowTransitionService (A.6) has a
/// real enum to govern, the same way LeadStatus does. PERIODIC_REVIEW_DUE is
/// terminal for THIS row (same pattern as Lead's CONVERTED_TO_PROSPECT): the
/// actual re-KYC cycle is a new KYCRecord for the same Customer, not a loop
/// back on this one.
enum KycStatus {
  DRAFT
  SUBMITTED
  SCREENING
  EDD
  COMPLIANCE_REVIEW
  APPROVED
  REJECTED
  PERIODIC_REVIEW_DUE
}

/// Process 3.1 KYC file (per the Part 3.1 "Core Data Entities" row).
model KYCRecord {
  id           String    @id @default(uuid())
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id])
  status       KycStatus @default(DRAFT)
  isEdd        Boolean   @default(false) // enhanced due diligence
  submittedAt  DateTime?
  // Maker/checker (Part 3.1 Approval row) — capturer != approver
  createdByUserId  String
  approvedByUserId String?
  approvedAt   DateTime?
  nextReviewDueAt DateTime? // risk-based refresh schedule
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  screeningResults ScreeningResult[]
  riskRating   RiskRating?

  @@index([customerId])
  @@index([status])
}

enum ScreeningType {
  SANCTIONS
  PEP
  AML
}

enum ScreeningOutcome {
  CLEAR
  HIT
  PENDING_INVESTIGATION
}

/// Process 47/49 — sanctions/PEP/AML screening result, at onboarding, on
/// material data change, and recurring batch.
model ScreeningResult {
  id           String   @id @default(uuid())
  kycRecordId  String
  kycRecord    KYCRecord @relation(fields: [kycRecordId], references: [id])
  screeningType ScreeningType
  result       ScreeningOutcome
  screenedAt   DateTime @default(now())
  listSource   String?
  escalatedToComplianceAt DateTime?

  @@index([kycRecordId])
}

enum RiskLevel {
  STANDARD
  HIGH
}

/// Process 3.1/47 — customer risk classification driving screening
/// frequency and EDD depth.
model RiskRating {
  id           String   @id @default(uuid())
  kycRecordId  String   @unique
  kycRecord    KYCRecord @relation(fields: [kycRecordId], references: [id])
  level        RiskLevel
  reason       String?
  ratedAt      DateTime @default(now())
}

enum InteractionChannel {
  MEETING
  CALL
  EMAIL
  WHATSAPP
  VISIT
  PROPOSAL
  RENEWAL
  CLAIM
  COMPLAINT
  PORTAL
  SMS
  OTHER
}

/// Process 10 — Relationship Management (CRM). Every interaction logged,
/// building a 360° Customer View.
model Interaction {
  id         String            @id @default(uuid())
  customerId String
  customer   Customer          @relation(fields: [customerId], references: [id])
  channel    InteractionChannel
  summary    String
  occurredAt DateTime          @default(now())
  loggedByUserId String
  createdAt  DateTime          @default(now())

  @@index([customerId])
}

/// Process 8 (Cross-Selling) status. OPEN once the detection sweep flags a
/// gap between a customer's in-force policy lines and the benchmark line
/// list; CONVERTED when a Sales Officer takes it forward into an
/// Opportunity/RFQ (Process 11+, not built); DISMISSED (with a reason) when
/// it is not pursued. Both non-OPEN states are terminal — and the
/// `@@unique([customerId, gapLine])` on CrossSellOpportunity means a
/// resolved gap is never re-flagged, so re-opening would be a manual action
/// with no endpoint yet (same "modeled ahead of a real trigger" shape as
/// InsuranceProgramStatus.SUPERSEDED). Converted from a free-text String,
/// the same enum conversion #1/#3-4/#5/#7 did for their status columns.
enum CrossSellStatus {
  OPEN
  CONVERTED
  DISMISSED
}

/// Process 8 — Cross-Selling (backlog Part C #8). A system-detected gap
/// between a customer's in-force policy lines and a benchmark line list —
/// flagged by the nightly CrossSellDetectionScheduler (or an on-demand
/// scan via POST /cross-sell-opportunities/detect), then converted or
/// dismissed. See apps/api/src/modules/cross-sell/.
///
/// `status` moves ONLY through WorkflowTransitionService (A.6) — see
/// ibms-brain/meta/lex/workflow-state-transitions.md.
///
/// `@@unique([customerId, gapLine])` is the race-safe backstop
/// (ibms-brain/meta/lex/race-safe-invariants.md): at most one opportunity
/// per (customer, benchmark line), ever — the detection sweep inserts with
/// `skipDuplicates`, so a re-run or a concurrent run adds nothing.
model CrossSellOpportunity {
  id           String   @id @default(uuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  gapLine      String   // a benchmark insuranceLine the customer holds no in-force policy for, e.g. "Public Liability"
  status       CrossSellStatus @default(OPEN)
  detectedAt   DateTime @default(now())
  /// The actor behind the detection run — the system service account for
  /// the nightly sweep, the Sales Officer for an on-demand scan. Bare
  /// scalar, no relation; the AuditLogEntry is the authoritative trail.
  detectedByUserId String?
  resolvedByUserId String?
  resolvedAt   DateTime?
  dismissReason String?

  @@unique([customerId, gapLine])
  @@index([status])
}

/// Process 9 (Up-Selling) status. OPEN once the detection sweep flags
/// under-insurance (updated asset value materially above the currently
/// designed Sum Insured); CONVERTED when a Sales Officer takes the proposed
/// increase forward (an endorsement / re-quote — Process 22 / 11+, not
/// built); DISMISSED (with a reason) when it is not pursued. Both non-OPEN
/// states are terminal. Converted from a free-text String, the same enum
/// conversion #1/#3-4/#5/#7/#8 did for their status columns.
enum UpSellStatus {
  OPEN
  CONVERTED
  DISMISSED
}

/// Process 9 — Up-Selling (backlog Part C #9). A system-detected gap between
/// a customer's currently designed property Sum Insured (the "Property All
/// Risks" line of their live `InsuranceProgram`, Process 7) and the current
/// value of their surveyed assets (`deriveSumInsured` over the `RiskProfile`
/// asset survey, Process 6) — flagged by the nightly
/// UpSellDetectionScheduler (or an on-demand scan via
/// POST /up-sell-recommendations/detect), then converted or dismissed. See
/// apps/api/src/modules/up-sell/. Both figures are fils-precision JOD
/// (`money.util.ts`, ibms-brain/meta/lex/money-decimal-jod.md).
///
/// `status` moves ONLY through WorkflowTransitionService (A.6).
///
/// A **partial** UNIQUE index (`customerId WHERE status = 'OPEN'`) is the
/// race-safe backstop (ibms-brain/meta/lex/race-safe-invariants.md): at most
/// one OPEN recommendation per customer at a time. Unlike #8's
/// CrossSellOpportunity (a full UNIQUE — a line gap is binary and one-shot),
/// an up-sell gap is a continuous, growing quantity, so a customer who
/// resolves one recommendation can get a fresh one later once their assets
/// have grown further. Raw SQL — Prisma can't express the predicate; see
/// migration 20260827220000.
model UpSellRecommendation {
  id              String   @id @default(uuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  /// Σ of the "Property All Risks" line's `sumInsuredBasis` over the
  /// customer's non-SUPERSEDED Insurance Programs, snapshotted at detection.
  currentSumInsured Decimal @db.Decimal(18, 3)
  /// `deriveSumInsured(...).propertySumInsured` over the customer's whole
  /// asset survey, snapshotted at detection.
  currentAssetValue Decimal @db.Decimal(18, 3)
  status          UpSellStatus @default(OPEN)
  detectedAt      DateTime @default(now())
  /// The actor behind the detection run — the system service account for
  /// the nightly sweep, the Sales Officer for an on-demand scan. Bare
  /// scalar, no relation; the AuditLogEntry is the authoritative trail.
  detectedByUserId String?
  resolvedByUserId String?
  resolvedAt      DateTime?
  dismissReason   String?

  @@index([customerId])
  @@index([status])
}

// ============================================================================
// PART 3.2, PROCESSES 5-9 — NEEDS ASSESSMENT & RISK ASSESSMENT
// ============================================================================

/// Part 3.2 core data entity.
model RiskProfile {
  id           String   @id @default(uuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  siteLabel    String?  // for multi-site/multi-entity clients (repeated per location)
  priorClaimsHistorySummary String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assets       Asset[]
  needsAssessments NeedsAssessment[]
  insurancePrograms InsuranceProgram[]

  @@index([customerId])
}

/// Part 3.2 — asset data (building value, equipment, stock, fleet size...).
model Asset {
  id            String   @id @default(uuid())
  riskProfileId String
  riskProfile   RiskProfile @relation(fields: [riskProfileId], references: [id])
  assetType     String   // building | equipment | stock | vehicle | other
  description   String?
  declaredValue Decimal? @db.Decimal(18, 3)
  annualGrossProfit Decimal? @db.Decimal(18, 3) // BI indemnity basis
  indemnityPeriodMonths Int?
  fleetVehicleCount Int?
  createdAt     DateTime @default(now())

  @@index([riskProfileId])
}

enum NeedsAssessmentStatus {
  DRAFT
  PENDING_REVIEW
  REVIEWED
  APPROVED
  REJECTED
}

/// Process 5 — structured questionnaire ("what risks do you face") that
/// derives a recommended coverage list, then goes through review + approval
/// before it can feed an Opportunity/RFQ. Maker/checker: `createdByUserId`
/// is the Sales/Relationship Officer who captured it; `reviewedByUserId`/
/// `approvedByUserId` are the Branch/Department Manager who signs it off —
/// assertDifferentActors (A.5) plus a DB CHECK enforce the split. `status`
/// moves ONLY through WorkflowTransitionService (A.6) — see
/// ibms-brain/meta/lex/workflow-state-transitions.md. APPROVED is terminal
/// here: linking an approved assessment to an Opportunity/RFQ is Process
/// 11+, not built yet.
model NeedsAssessment {
  id            String   @id @default(uuid())
  riskProfileId String
  riskProfile   RiskProfile @relation(fields: [riskProfileId], references: [id])
  questionnaireAnswers Json
  recommendedCoverageLines String[] // Fire, Machinery Breakdown, BI, Workers Comp, Product Liability, Burglary, Public Liability, Motor, Cyber, Group Life...
  status        NeedsAssessmentStatus @default(DRAFT)
  createdByUserId String
  reviewedByUserId String?
  approvedByUserId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([riskProfileId])
  @@index([status])
  @@index([createdByUserId])
}

/// Process 7 — Product Recommendation / Program Design (backlog Part C #7).
/// DRAFT once assembled from an APPROVED NeedsAssessment's coverage list +
/// the parent RiskProfile's asset survey; FINALIZED when the Placement/
/// Technical Officer locks it to feed an Opportunity/RFQ (Process 11+, not
/// built). `status` moves ONLY through WorkflowTransitionService (A.6) — see
/// apps/api/src/modules/insurance-program/. SUPERSEDED is modeled for a
/// re-assembled replacement (e.g. a mid-cycle risk change per
/// policy-lifecycle.md) but no endpoint triggers it in Part C #7 yet — same
/// "modeled ahead of a real trigger" shape as CustomerStatus.SUSPENDED.
enum InsuranceProgramStatus {
  DRAFT
  FINALIZED
  SUPERSEDED
}

model InsuranceProgram {
  id            String   @id @default(uuid())
  riskProfileId String
  riskProfile   RiskProfile @relation(fields: [riskProfileId], references: [id])
  status        InsuranceProgramStatus @default(DRAFT)
  /// The APPROVED NeedsAssessment whose recommendedCoverageLines this
  /// program was assembled from (Part C #7). Nullable: bare scalar, no
  /// relation — provenance for display/re-assembly, the AuditLogEntry is the
  /// authoritative trail.
  needsAssessmentId String?
  assembledByUserId String?
  createdAt     DateTime @default(now())

  lines         InsuranceProgramLine[]
  opportunities Opportunity[]

  // "One live program per RiskProfile" is enforced by a partial UNIQUE index
  // (riskProfileId WHERE status <> 'SUPERSEDED') that Prisma can't express
  // here — see migration 20260827180000.
  @@index([riskProfileId])
}

model InsuranceProgramLine {
  id                 String   @id @default(uuid())
  insuranceProgramId String
  insuranceProgram   InsuranceProgram @relation(fields: [insuranceProgramId], references: [id])
  insuranceLine      String   // Property All Risks | BI | Machinery Breakdown | General/Product Liability | Motor Fleet | Group Medical | Group Life | Workers Comp | Cyber | ...
  sumInsuredBasis    Decimal? @db.Decimal(18, 3)

  @@index([insuranceProgramId])
}

// ============================================================================
// PROCESSES 11-19 / PART 3.3 — RFQ, PLACEMENT, QUOTATION, RECOMMENDATION
// ============================================================================

enum OpportunityStatus {
  NEEDS_CONFIRMED
  RFQ_ISSUED
  QUOTES_RECEIVED
  COMPARISON_BUILT
  RECOMMENDATION_DRAFTED
  SENT_TO_CLIENT
  CLIENT_DECISION
  PLACEMENT
  RENEGOTIATE
  CLOSED_LOST
}

/// Part 4.1 core entity — a specific insurance placement need (new business
/// or renewal). May close-lost and never become a Policy.
model Opportunity {
  id                 String   @id @default(uuid())
  customerId         String
  customer           Customer @relation(fields: [customerId], references: [id])
  insuranceProgramId String?
  insuranceProgram   InsuranceProgram? @relation(fields: [insuranceProgramId], references: [id])
  isRenewal          Boolean  @default(false)
  renewalCaseId      String?  @unique
  renewalCase        RenewalCase? @relation(fields: [renewalCaseId], references: [id])
  status             OpportunityStatus @default(NEEDS_CONFIRMED)
  targetPremiumThreshold Decimal? @db.Decimal(18, 3) // triggers senior-officer approval above this
  // Process 11 (backlog Part C #11) provenance — the Placement Officer who
  // took the finalized Insurance Program to market. Bare scalar, no relation;
  // the AuditLogEntry CREATE row is the authoritative trail.
  createdByUserId    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  rfqs               RFQ[]
  recommendation     Recommendation?
  clientDecision     ClientDecision?
  policy             Policy?

  // "At most one live Opportunity per InsuranceProgram" is enforced by a
  // partial UNIQUE index (insuranceProgramId WHERE status <> 'CLOSED_LOST')
  // that Prisma can't express here — see migration
  // 20260828120000_add_rfq_market_submission.
  @@index([customerId])
  @@index([status])
  @@index([insuranceProgramId])
}

/// Process 11 — RFQ / Market Submission per product/line to a shortlist of
/// insurers.
model RFQ {
  id            String   @id @default(uuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  insuranceLine String
  issuedAt      DateTime @default(now())
  followUpThresholdDays Int @default(9) // Part 3.7-style configurable follow-up
  // Process 11 (backlog Part C #11) provenance — the Placement Officer who
  // issued this RFQ. Bare scalar; the AuditLogEntry CREATE row is authoritative.
  issuedByUserId String?

  insurerSubmissions RFQInsurer[]
  quotations    Quotation[]
  comparisonMatrix ComparisonMatrix?
  communications CommunicationLog[]

  // One RFQ per insurance line per Opportunity (backlog Part C #11 — "Create
  // an RFQ per insurance line"). Re-marketing a line is a deliberate future
  // relaxation (Negotiation #15 / Client Decision #17).
  @@unique([opportunityId, insuranceLine])
}

enum RfqInsurerStatus {
  SENT
  VIEWED
  QUOTED
  DECLINED
  NO_RESPONSE
}

/// Process 12 — per-insurer tracking of an RFQ (sent/viewed/quoted/declined/
/// no response), with SLA follow-up alerting.
model RFQInsurer {
  id          String   @id @default(uuid())
  rfqId       String
  rfq         RFQ      @relation(fields: [rfqId], references: [id])
  insurerId   String
  insurer     Insurer  @relation(fields: [insurerId], references: [id])
  status      RfqInsurerStatus @default(SENT)
  sentAt      DateTime @default(now())
  respondedAt DateTime?
  followUpAlertSentAt DateTime?

  communications CommunicationLog[]

  @@unique([rfqId, insurerId])
  @@index([insurerId])
  // The nightly follow-up sweep (backlog Part C #11) filters on status.
  @@index([status])
}

/// Process 13 — insurer quotation (backlog Part C #13). Versioned, NEVER
/// overwritten (Part 4.1, Part 3.3 Controls: "full version history retained
/// for every quotation"): a renegotiation `create()`s a new row linked to
/// its predecessor via `previousVersionId` and flips `isCurrentVersion`.
/// A "version chain" is every row sharing one `(rfqId, insurerId)` — one
/// insurer's successive quotes on one RFQ line.
///
/// Process 15 — Negotiation (backlog Part C #15) is the same mechanism: every
/// negotiation round is a NEW version, "never deleted or replaced". That is
/// enforced at the DB layer, not just by convention — migration
/// 20260901180000 adds a trigger (same pattern as
/// prevent_audit_log_entry_mutation) that rejects any DELETE of a Quotation
/// row, any UPDATE of an already-superseded version, and any UPDATE of a live
/// version other than the supersede flip itself.
///
/// `isCurrentVersion` is NOT a workflow `status` (it is a boolean, and the
/// chain has no state machine), so Quotation is not a
/// WorkflowTransitionService entity — same as Interaction (#10) /
/// CommunicationLog (#12). It has no maker/checker (capturing what an
/// insurer sent is a factual, single-actor Placement record).
///
/// "At most one current version per chain" is a real DB invariant, not a
/// read-then-write in QuotationService
/// (ibms-brain/meta/lex/race-safe-invariants.md): a PARTIAL UNIQUE index
/// `("rfqId", "insurerId") WHERE "isCurrentVersion" = true` that Prisma
/// can't express here — see migration 20260901120000. `previousVersionId`'s
/// own `@unique` additionally serializes two concurrent revisions of the
/// same node (only one successor can exist).
model Quotation {
  id             String   @id @default(uuid())
  rfqId          String
  rfq            RFQ      @relation(fields: [rfqId], references: [id])
  insurerId      String
  insurer        Insurer  @relation(fields: [insurerId], references: [id])
  versionNumber  Int      @default(1)
  previousVersionId String? @unique
  previousVersion Quotation? @relation("QuotationVersionChain", fields: [previousVersionId], references: [id])
  nextVersion    Quotation? @relation("QuotationVersionChain")
  isCurrentVersion Boolean @default(true)
  premium        Decimal  @db.Decimal(18, 3)
  currency       String   @default("JOD")
  deductible     Decimal? @db.Decimal(18, 3)
  limits         Json?
  biPeriodMonths Int?
  liabilityLimit Decimal? @db.Decimal(18, 3)
  exclusions     String?
  conditions     String?
  commissionRatePercent Decimal? @db.Decimal(5, 2)
  receivedAt     DateTime @default(now())
  /// Backlog Part C #13 provenance — the Placement Officer who captured this
  /// version. Bare scalar, no relation; the AuditLogEntry CREATE row is the
  /// authoritative trail (same shape as RFQ.issuedByUserId, migration
  /// 20260828120000).
  capturedByUserId String?
  /// Backlog Part C #15 — the broker's documented rationale for THIS
  /// negotiation round (what was requested / conceded). NULL on a version-1
  /// capture: an insurer's opening quote is not a negotiation round. Treated
  /// as Confidential commercial correspondence — the AuditLogEntry snapshot
  /// carries only a `hasNegotiationNotes` boolean, never this text (Part 6.1,
  /// same "metadata not body" shape as exclusions / conditions).
  negotiationNotes String?

  comparisonRows ComparisonMatrixRow[]
  recommendation Recommendation? @relation("RecommendedQuotation")

  @@index([rfqId])
  @@index([insurerId])
}

/// Process 14 — Quote Comparison (backlog Part C #14). Structured comparison
/// across price + coverage + exclusions + deductibles + limits + insurer
/// quality + service — **never price alone**
/// (ibms-brain/meta/context/policy-lifecycle.md § "The rules that aren't
/// obvious"). One matrix per RFQ (`rfqId @unique`); `ComparisonService.build`
/// (re)assembles it deterministically from every **current-version**
/// `Quotation` on the RFQ (one `ComparisonMatrixRow` each — the objective
/// columns live on the linked `Quotation`), and records the shortlisted
/// insurers with no current quote in `missingInsurers` (insurer ids). A
/// build best-effort advances the parent `Opportunity`
/// QUOTES_RECEIVED -> COMPARISON_BUILT through the workflow engine.
model ComparisonMatrix {
  id        String   @id @default(uuid())
  rfqId     String   @unique
  rfq       RFQ      @relation(fields: [rfqId], references: [id])
  builtAt   DateTime @default(now())
  missingInsurers String[] // insurer ids: on the RFQ shortlist, no current Quotation, not DECLINED — flagged in the output
  /// Backlog Part C #14 provenance — the Placement Officer who built this
  /// matrix. Bare scalar, no relation; the AuditLogEntry row is the
  /// authoritative trail (same shape as Quotation.capturedByUserId).
  builtByUserId String?

  rows      ComparisonMatrixRow[]
}

model ComparisonMatrixRow {
  id                 String   @id @default(uuid())
  comparisonMatrixId String
  comparisonMatrix   ComparisonMatrix @relation(fields: [comparisonMatrixId], references: [id])
  quotationId        String
  quotation          Quotation @relation(fields: [quotationId], references: [id])
  /// Optional subjective scores (0-100, 2dp) supplied by Placement on the
  /// build request — there is no Insurer-scoring module yet (narrative
  /// Process 61). Null when not supplied.
  insurerQualityScore Decimal? @db.Decimal(5, 2)
  serviceScore        Decimal? @db.Decimal(5, 2)

  // One row per (matrix, quotation) — a rebuild replaces rows wholesale, and
  // this keeps two interleaved rebuilds from doubling a row
  // (ibms-brain/meta/lex/race-safe-invariants.md; Prisma-expressible, no raw
  // SQL — same as CrossSellOpportunity's @@unique).
  @@unique([comparisonMatrixId, quotationId])
  @@index([comparisonMatrixId])
  @@index([quotationId])
}

/// Process 16 — the broker's documented, reasoned advice — retained as
/// professional-indemnity evidence. Never "cheapest wins" without reasoning.
///
/// Backlog Part C #16: NOT a WorkflowTransitionService entity (it has no
/// `status` column) — its lifecycle is DRAFTED (row exists) -> APPROVED
/// (`approvedAt`, only when `approvalRequired`) -> SENT (`sentToClientAt`),
/// carried by nullable timestamps; the parent `Opportunity` reflects the
/// same progression through the engine (COMPARISON_BUILT ->
/// RECOMMENDATION_DRAFTED -> SENT_TO_CLIENT). Maker/checker (Part 5.2): the
/// `recommendation.approve` holder (senior officer) must differ from
/// `draftedByUserId` — `assertDifferentActors` is the app guard, the
/// `Recommendation_maker_checker_distinct` CHECK (migration 20260826091424)
/// the DB backstop.
///
/// `rationaleFactors` is the structured, per-dimension rationale the backlog
/// enumerates — a JSON object with a non-empty note for each of
/// `coverage` / `price` / `financialStrength` / `claimsService` /
/// `deductible` / `policyConditions` (a recommendation must address every
/// dimension, not just price — the "never price alone" controls rule from
/// #14 carried forward). `rationale` stays the free-text overall summary.
///
/// `approvalRequired` / `conflictOfInterestFlagged` are snapshots taken at
/// draft time: `approvalRequired` = the recommended quote's premium exceeds
/// the Opportunity's `targetPremiumThreshold` (when one is set);
/// `conflictOfInterestFlagged` = a comparable competing quote (premium within
/// a configured band) carried a materially lower commission rate.
/// `coiCompetingQuotationId` / `coiCommissionDiffPercent` explain the flag.
model Recommendation {
  id                 String   @id @default(uuid())
  opportunityId      String   @unique
  opportunity        Opportunity @relation(fields: [opportunityId], references: [id])
  recommendedQuotationId String @unique
  recommendedQuotation Quotation @relation("RecommendedQuotation", fields: [recommendedQuotationId], references: [id])
  rationale          String   // free-text overall summary
  rationaleFactors   Json     // { coverage, price, financialStrength, claimsService, deductible, policyConditions } — a non-empty note each
  draftedByUserId    String
  // Snapshot at draft: recommendedQuotation.premium > Opportunity.targetPremiumThreshold
  approvalRequired   Boolean  @default(false)
  // Snapshot at draft: COI heuristic (comparable competing quote, materially lower commission)
  conflictOfInterestFlagged Boolean @default(false)
  coiCompetingQuotationId String?
  coiCommissionDiffPercent Decimal? @db.Decimal(5, 2)
  // Maker/checker: senior-officer approval required above a configurable premium threshold
  approvedByUserId   String?
  approvedAt         DateTime?
  sentToClientAt     DateTime?
  sentByUserId       String?
  createdAt          DateTime @default(now())

  conflictOfInterestDisclosure ConflictOfInterestDisclosure?

  @@index([draftedByUserId])
}

/// Process 50 / Part 3.3, 7.3 — mandatory disclosure whenever a
/// recommendation favors a materially higher-commission insurer over a
/// comparable/better-value competing offer. System gate, not optional
/// (backlog Part C #16): `RecommendationService.send` refuses to stamp
/// `sentToClientAt` while `Recommendation.conflictOfInterestFlagged` is true
/// and no disclosure row exists. `acknowledgedByUserId` must differ from the
/// recommendation's `draftedByUserId` (the conflicted officer cannot clear
/// their own conflict — `assertDifferentActors`, Part 5.2).
model ConflictOfInterestDisclosure {
  id               String   @id @default(uuid())
  recommendationId String   @unique
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id])
  competingQuotationId String?
  commissionDifferencePercent Decimal? @db.Decimal(5, 2)
  disclosureText   String
  acknowledgedByUserId String
  acknowledgedAt   DateTime @default(now())

  @@index([competingQuotationId])
}

enum ClientDecisionType {
  ACCEPT
  REJECT
  REQUEST_FURTHER_NEGOTIATION
  REQUEST_ALTERNATIVE_OPTIONS
  REQUEST_PRICE_REDUCTION
  REQUEST_COVERAGE_INCREASE
}

/// Process 17 — Client Decision Handling (backlog Part C #17). The client's
/// single decision on a sent Recommendation, one per Opportunity
/// (`opportunityId @unique`). The six `ClientDecisionType` values collapse
/// to three routes (`client-decision.config.ts` `routeFor`): ACCEPT ->
/// placement (`Opportunity -> PLACEMENT`), REJECT -> close the request
/// (`-> CLOSED_LOST`), and the four REQUEST_* values -> renewed negotiation
/// (`-> RENEGOTIATE`). The routing is the parent Opportunity's engine
/// transition (`SENT_TO_CLIENT -> CLIENT_DECISION -> <route>`); `ClientDecision`
/// itself is NOT a WorkflowTransitionService entity (`decision` is a one-shot
/// enum, not a state machine) and has no maker/checker (recording the
/// client's stated decision is a factual, single-actor Sales/Placement act).
model ClientDecision {
  id            String   @id @default(uuid())
  opportunityId String   @unique
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  decision      ClientDecisionType
  evidenceType  String?  // signature | e-signature | email_confirmation
  evidenceRef   String?
  /// Free-text context the officer recorded with the decision (e.g. which
  /// terms the client wants changed on a REQUEST_* route). Not evidence.
  notes         String?
  /// Backlog Part C #17 provenance — the Sales/Placement officer who recorded
  /// the client's decision. Bare scalar, no relation; the AuditLogEntry
  /// CREATE row is the authoritative trail (same shape as
  /// Recommendation.sentByUserId / RFQ.issuedByUserId).
  capturedByUserId String?
  decidedAt     DateTime @default(now())
}

// ============================================================================
// PROCESSES 18-22 / PART 3.4-3.5 — POLICY PLACEMENT, ISSUANCE, CHECKING,
// DELIVERY, ENDORSEMENT
// ============================================================================

enum PolicyStatus {
  PLACEMENT_CONFIRMED
  ISSUED
  CHECKING_IN_PROGRESS
  DISCREPANCY
  VERIFIED
  DELIVERED
  ACTIVE
  CANCELLED
  EXPIRED
}

/// Part 4.1 core entity — the bound insurance contract.
model Policy {
  id             String   @id @default(uuid())
  opportunityId  String   @unique
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id])
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  insurerId      String
  insurer        Insurer  @relation(fields: [insurerId], references: [id])
  policyNumber   String?  @unique
  insuranceLine  String
  status         PolicyStatus @default(PLACEMENT_CONFIRMED)
  inceptionDate  DateTime?
  expiryDate     DateTime?
  requestedPremium Decimal @db.Decimal(18, 3)
  issuedPremium  Decimal? @db.Decimal(18, 3)
  currency       String   @default("JOD")
  // Process 18-19 (backlog Part C #18-19) provenance — bare scalars, no
  // relation. placedByUserId is the Placement Officer who bound the cover;
  // issuedByUserId is stamped on the PLACEMENT_CONFIRMED -> ISSUED
  // transition. The AuditLogEntry CREATE / TRANSITION rows are the
  // authoritative trail (same pattern as Opportunity.createdByUserId /
  // RFQ.issuedByUserId).
  placedByUserId String?
  issuedByUserId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  schedules      PolicySchedule[]
  coverNote      CoverNote?
  checking       PolicyChecking?
  deliveryRecord DeliveryRecord?
  endorsements   Endorsement[]
  claims         Claim[]              @relation("ClaimPolicy")
  premiumTransactions PremiumTransaction[]
  invoices       Invoice[]
  commissionLedgerEntries CommissionLedgerEntry[]
  insuredPersons InsuredPerson[]
  complaints     Complaint[]
  renewalCase    RenewalCase?
  documents      Document[]           @relation("PolicyDocuments")

  @@index([customerId])
  @@index([status])
  @@index([expiryDate])
}

/// Requested/issued coverage snapshot — limits, sums insured, named perils,
/// extensions (Part 3.4). Kept as a distinct versioned row so a Claim can
/// resolve to "coverage in force at the loss date" (Part 3.7, data-model rule).
/// "At most one OPEN schedule (effectiveTo IS NULL) per Policy" is a real DB
/// invariant — the partial UNIQUE index `PolicySchedule_one_open_per_policy`
/// (migration 20260902140000_add_policy_placement_issuance,
/// ibms-brain/meta/lex/race-safe-invariants.md). Prisma can't express a
/// partial UNIQUE here, so it lives in raw SQL in that migration.
model PolicySchedule {
  id            String   @id @default(uuid())
  policyId      String
  policy        Policy   @relation(fields: [policyId], references: [id])
  effectiveFrom DateTime
  effectiveTo   DateTime?
  limits        Json
  sumsInsured   Json
  namedPerils   String[]
  extensions    String[]
  sourceEndorsementId String? @unique
  sourceEndorsement Endorsement? @relation(fields: [sourceEndorsementId], references: [id])
  createdAt     DateTime @default(now())

  @@index([policyId, effectiveFrom])
}

/// Process 18 (interim state) — urgent cover before full policy issuance,
/// with a tracked expiry.
model CoverNote {
  id        String   @id @default(uuid())
  policyId  String   @unique
  policy    Policy   @relation(fields: [policyId], references: [id])
  issuedAt  DateTime @default(now())
  expiresAt DateTime
}

/// Process 20 — MANDATORY maker/checker line-by-line comparison of
/// Requested Coverage vs Issued Policy. The single largest source of PI
/// claims per the source model if skipped.
model PolicyChecking {
  id                String    @id @default(uuid())
  policyId          String    @unique
  policy            Policy    @relation(fields: [policyId], references: [id])
  placedByUserId    String    // maker — the officer who placed the cover
  checkedByUserId   String?   // checker — MUST differ from placedByUserId (app-enforced)
  checklistResult   Json?     // structured field-by-field comparison
  discrepancyFound  Boolean   @default(false)
  discrepancyDetail String?
  discrepancyLoggedAsPiRiskEvent Boolean @default(false)
  complianceOverrideByUserId String? // discrepancy cannot be bypassed without logged override
  checkedAt         DateTime?
  createdAt         DateTime  @default(now())
}

/// Process 21 — delivery date, method, recipient, confirmation, receipt
/// acknowledgement.
model DeliveryRecord {
  id             String   @id @default(uuid())
  policyId       String   @unique
  policy         Policy   @relation(fields: [policyId], references: [id])
  deliveredAt    DateTime @default(now())
  method         String   // email | portal | courier | in_person
  recipient      String
  receiptAcknowledgedAt DateTime?
}

enum EndorsementType {
  POSITIVE
  NEGATIVE
}

enum EndorsementStatus {
  REQUESTED
  SUBMITTED_TO_INSURER
  INSURER_CONFIRMED
  FINANCIAL_ADJUSTMENT_CALCULATED
  REFUND_APPROVAL_PENDING
  APPLIED
  CLIENT_NOTIFIED
}

/// Process 22 / Part 3.5 — mid-term amendment. Positive (adds premium) or
/// negative (returns premium) — never overwrites prior history.
///
/// RACE-SAFE INVARIANT (race-safe-invariants.md): at most one in-flight
/// cancellation per policy — enforced by the partial UNIQUE index
/// `Endorsement_one_live_cancellation_per_policy` (raw SQL, migration
/// 20260902170000: `WHERE "changeType" = 'cancellation' AND "status" <>
/// 'CLIENT_NOTIFIED'`; Prisma cannot express a two-column partial UNIQUE with
/// a predicate on the mutable `status`). Without it a second cancellation
/// Endorsement could be raised while the first is still in flight (the Policy
/// stays ACTIVE until APPLY) and mint a duplicate Refund + CommissionReversal.
model Endorsement {
  id              String   @id @default(uuid())
  policyId        String
  policy          Policy   @relation(fields: [policyId], references: [id])
  type            EndorsementType
  changeType      String   // add_vehicle | remove_vehicle | add_employee | remove_employee | address_change | sum_insured_increase | add_location | change_beneficiary | coverage_amendment | cancellation
  status          EndorsementStatus @default(REQUESTED)
  premiumAdjustment Decimal @db.Decimal(18, 3) // positive or negative amount
  // Process 22 — when the amendment takes effect; the boundary date of the
  // new PolicySchedule version created at APPLY.
  effectiveFrom   DateTime?
  requestedByUserId String
  submittedToInsurerAt DateTime?
  insurerConfirmedAt DateTime?
  financialAdjustmentCalculatedAt DateTime?
  appliedAt       DateTime?
  clientNotifiedAt DateTime?
  // Process 22 (backlog Part C #22) — the post-amendment coverage snapshot,
  // captured at request time and materialised into a NEW PolicySchedule
  // version when the endorsement is APPLIED (never overwrites the prior
  // version). `{ limits, sumsInsured, namedPerils, extensions }`; null means
  // "carry the current coverage forward, just mark the new version boundary".
  targetCoverage  Json?
  createdAt       DateTime @default(now())

  schedule        PolicySchedule?
  refund          Refund?
  commissionReversal CommissionReversal?
  cancellation    Cancellation?

  @@index([policyId])
}

/// Process 22/37 — cancellation request, always paired with a commission
/// reversal (Part 3.5 rule: "the two numbers must move together").
model Cancellation {
  id                String   @id @default(uuid())
  endorsementId     String   @unique
  endorsement       Endorsement @relation(fields: [endorsementId], references: [id])
  reason            String
  basis             String   // short_period | pro_rata
  returnPremium     Decimal  @db.Decimal(18, 3)
  clientNotifiedAt  DateTime?
  createdAt         DateTime @default(now())
}

/// Process 37 — refund workflow. Maker/checker: raiser != Finance approver,
/// gated by a configurable value threshold.
model Refund {
  id                 String   @id @default(uuid())
  endorsementId      String   @unique
  endorsement        Endorsement @relation(fields: [endorsementId], references: [id])
  amount             Decimal  @db.Decimal(18, 3)
  reason             String   // cancellation | premium_reduction | coverage_change | overpayment
  raisedByUserId     String
  approvedByUserId   String?  // MUST differ from raisedByUserId (app-enforced)
  approvalThresholdMatrixLevel String?
  paidAt             DateTime?
  createdAt          DateTime @default(now())
}

/// Process 35-37 — commission reversal tied 1:1 to a negative
/// endorsement/cancellation premium adjustment.
model CommissionReversal {
  id             String   @id @default(uuid())
  endorsementId  String   @unique
  endorsement    Endorsement @relation(fields: [endorsementId], references: [id])
  amount         Decimal  @db.Decimal(18, 3)
  createdAt      DateTime @default(now())
}

// ============================================================================
// PROCESSES 23-30 / PART 3.7 — CLAIMS
// ============================================================================

enum ClaimStatus {
  NOTIFIED
  REGISTERED
  DOCUMENTATION_IN_PROGRESS
  UNDER_ASSESSMENT
  APPROVED
  PARTIALLY_APPROVED
  DECLINED
  SETTLED
  CLOSED
}

/// Part 4.1 core entity — a reported loss event under a Policy. Must
/// validate against coverage in force AT THE LOSS DATE (data-model rule) —
/// resolve via PolicySchedule.effectiveFrom/effectiveTo, not Policy alone.
model Claim {
  id                 String   @id @default(uuid())
  policyId           String
  policy             Policy   @relation("ClaimPolicy", fields: [policyId], references: [id])
  customerId         String
  customer           Customer @relation("ClaimCustomer", fields: [customerId], references: [id])
  claimNumber        String?  @unique
  status             ClaimStatus @default(NOTIFIED)
  lossDate           DateTime
  lossLocation       String?
  causeOfLoss        String?
  estimatedLoss      Decimal  @db.Decimal(18, 3)
  isThirdPartyInvolved Boolean @default(false)
  isLargeClaim       Boolean  @default(false) // requires second approver
  insurerClaimReference String?
  followUpAlertThresholdDays Int @default(9)
  classification     DataClassification @default(HIGHLY_CONFIDENTIAL) // medical/health claim data
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  documents          ClaimDocument[]
  statusHistory      ClaimStatusHistory[]
  settlement         Settlement?
  thirdParty         ThirdPartyClaimant?
  adjuster           Adjuster?
  followUpAlerts     ClaimFollowUpAlert[]
  complaints         Complaint[]

  @@index([policyId])
  @@index([status])
  @@index([lossDate])
}

/// Process 25 — claim form, police report, medical report, photos,
/// invoices, repair estimate, expert report.
model ClaimDocument {
  id           String   @id @default(uuid())
  claimId      String
  claim        Claim    @relation(fields: [claimId], references: [id])
  documentId   String
  document     Document @relation(fields: [documentId], references: [id])
  docType      String   // claim_form | police_report | medical_report | photo | invoice | repair_estimate | expert_report | correspondence
}

/// Part 3.7 core data entity — explicit status-history trail, named
/// separately from the generic AuditLogEntry because it feeds Loss Ratio
/// and Claims Analytics directly.
///
/// RACE-SAFE INVARIANT (race-safe-invariants.md): at most one row per
/// (claimId, toStatus) — the `WORKFLOW_TRANSITIONS.Claim` map is an acyclic
/// DAG (no status is ever revisited), so a status is entered exactly once
/// over a claim's life. `@@unique([claimId, toStatus])` (migration
/// 20260902180000) makes "one REGISTERED row per claim" (etc.) structural,
/// so a concurrent double-registration cannot mint a duplicate history row
/// even if the caller-side pre-check is later weakened.
model ClaimStatusHistory {
  id         String      @id @default(uuid())
  claimId    String
  claim      Claim       @relation(fields: [claimId], references: [id])
  fromStatus ClaimStatus?
  toStatus   ClaimStatus
  changedByUserId String
  changedAt  DateTime    @default(now())

  @@unique([claimId, toStatus])
}

/// Process 28 — four DISTINCT figures, never collapsed into one number
/// (estimatedLoss carried from the Claim; netSettlement is always
/// approvedAmount - deductible, never hand-entered).
///
/// maker/checker: approvedByUserId (the officer who recorded the four figures
/// = first approver) vs secondApproverUserId. The `Settlement_maker_checker_
/// distinct` CHECK (migration 20260826091424) is the DB backstop for
/// assertDifferentActors. A second approver is MANDATORY when the settlement
/// is large (Settlement.approvedAmount re-derived against the live threshold,
/// NOT Claim.isLargeClaim) OR brokerProcessedPayment is true; `settleCore`
/// refuses `Claim -> SETTLED` structurally while that is unmet.
model Settlement {
  id               String   @id @default(uuid())
  claimId          String   @unique
  claim            Claim    @relation(fields: [claimId], references: [id])
  estimatedLoss    Decimal  @db.Decimal(18, 3)
  approvedAmount   Decimal? @db.Decimal(18, 3)
  deductible       Decimal? @db.Decimal(18, 3)
  netSettlement    Decimal? @db.Decimal(18, 3)
  // true when the broker (not the insurer direct) processes the payout —
  // forces a second approver regardless of amount (Process 28).
  brokerProcessedPayment Boolean @default(false)
  // large claims / broker-processed payments require a second approver
  approvedByUserId String?
  secondApproverUserId String?
  clientPaymentConfirmedAt DateTime?
  createdAt        DateTime @default(now())
}

/// Process 23 — additional data for third-party-involved claims, with a
/// subrogation/recovery flag (distinct piece of state, own process).
model ThirdPartyClaimant {
  id                String   @id @default(uuid())
  claimId           String   @unique
  claim             Claim    @relation(fields: [claimId], references: [id])
  fullName          String?
  contactDetailsEnc String?  // -- ENCRYPT
  subrogationRecoveryFlag Boolean @default(false)
  recoveryAmount    Decimal? @db.Decimal(18, 3)
}

/// Process 24/26 — insurer/loss-adjuster assignment tracking.
model Adjuster {
  id          String   @id @default(uuid())
  claimId     String   @unique
  claim       Claim    @relation(fields: [claimId], references: [id])
  name        String
  firm        String?
  assignedAt  DateTime @default(now())
  surveyCompletedAt DateTime?
  investigationCompletedAt DateTime?
}

/// Process 27 — system-generated follow-up alert once insurer non-response
/// exceeds the configurable threshold (example: day 10 after a 1 Aug
/// submission with a 9-day threshold). The clock runs from the claim's
/// REGISTERED ClaimStatusHistory.changedAt; the threshold is snapshotted onto
/// Claim.followUpAlertThresholdDays at notification (per line family).
///
/// RACE-SAFE INVARIANT (race-safe-invariants.md): at most one UNRESOLVED alert
/// per claim — a partial `UNIQUE ("claimId") WHERE "resolvedAt" IS NULL`
/// (migration 20260902190000; Prisma cannot express the WHERE here). A
/// resolved alert leaves the index, so a claim chased again later gets a fresh
/// row. The sweep + a manual re-run rely on this: raise is `create` +
/// P2002 -> "already alerted".
model ClaimFollowUpAlert {
  id          String   @id @default(uuid())
  claimId     String
  claim       Claim    @relation(fields: [claimId], references: [id])
  triggeredAt DateTime @default(now())
  resolvedAt  DateTime?

  @@index([claimId])
}

// ============================================================================
// PROCESSES 31-40 / PART 3.6 — FINANCE
// ============================================================================

enum InvoiceStatus {
  INVOICED
  COLLECTED
  RECONCILED
  REMITTED
  EXCEPTION_RAISED
  EXCEPTION_RESOLVED
}

/// Part 4.1 core entity ("PremiumTransaction / Invoice / Receipt") / Part
/// 3.5 core entity ("PolicyTransaction") — the generic financial-transaction
/// ledger tied to a Policy: new-business premium, endorsement premium
/// adjustment, cancellation, renewal. Distinct from Invoice, which is the
/// billing document raised against one or more of these transactions.
model PremiumTransaction {
  id            String   @id @default(uuid())
  policyId      String
  policy        Policy   @relation(fields: [policyId], references: [id])
  transactionType String // new_business_premium | endorsement_adjustment | cancellation | renewal_premium
  amount        Decimal  @db.Decimal(18, 3)
  currency      String   @default("JOD")
  relatedEndorsementId String?
  occurredAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([policyId])
}

/// Process 31 — premium + tax + fees, net of commission, with due dates.
model Invoice {
  id           String   @id @default(uuid())
  policyId     String?
  policy       Policy?  @relation(fields: [policyId], references: [id])
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  premiumAmount Decimal @db.Decimal(18, 3)
  taxAmount    Decimal  @db.Decimal(18, 3) @default(0)
  feesAmount   Decimal  @db.Decimal(18, 3) @default(0)
  commissionDeducted Decimal @db.Decimal(18, 3) @default(0)
  totalAmount  Decimal  @db.Decimal(18, 3)
  currency     String   @default("JOD")
  dueDate      DateTime
  status       InvoiceStatus @default(INVOICED)
  createdAt    DateTime @default(now())

  receipts     Receipt[]
  reconciliationExceptions ReconciliationException[]

  @@index([customerId])
  @@index([status])
}

/// Process 32 — Invoice -> Collection -> Receipt -> Reconciliation ->
/// Remittance cycle.
model Receipt {
  id           String   @id @default(uuid())
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id])
  amount       Decimal  @db.Decimal(18, 3)
  receivedAt   DateTime @default(now())
  method       String?  // bank_transfer | cheque | card | cash

  remittance   Remittance?
}

/// Process 32/34 — remittance to insurer per agreed arrangement (broker may
/// collect on behalf of insurer).
model Remittance {
  id          String   @id @default(uuid())
  receiptId   String   @unique
  receipt     Receipt  @relation(fields: [receiptId], references: [id])
  insurerId   String
  insurer     Insurer  @relation(fields: [insurerId], references: [id])
  amount      Decimal  @db.Decimal(18, 3)
  remittedAt  DateTime?
}

/// Process 35 — insurer- and product-specific commission rate table
/// (illustrative rates: Motor 12%, Medical 10%, Property 15%, Life 20%).
model CommissionAgreement {
  id            String   @id @default(uuid())
  insurerId     String
  insurer       Insurer  @relation(fields: [insurerId], references: [id])
  insuranceLine String
  ratePercent   Decimal  @db.Decimal(5, 2)
  effectiveFrom DateTime @default(now())
  effectiveTo   DateTime?

  ledgerEntries CommissionLedgerEntry[]

  @@index([insurerId, insuranceLine])
}

/// Process 36 — commission rate, amount, VAT/tax implications, paid,
/// outstanding, reversed.
model CommissionLedgerEntry {
  id                     String   @id @default(uuid())
  policyId               String
  policy                 Policy   @relation(fields: [policyId], references: [id])
  commissionAgreementId  String?
  commissionAgreement    CommissionAgreement? @relation(fields: [commissionAgreementId], references: [id])
  amount                 Decimal  @db.Decimal(18, 3)
  vatAmount              Decimal  @db.Decimal(18, 3) @default(0)
  status                 String   @default("outstanding") // outstanding | paid | reversed
  isManualOverride       Boolean  @default(false)
  overrideReason         String?  // manual override requires an approval reason, logged
  // Maker/checker (Part 5.2): whoever requests the manual override MUST
  // differ from overrideApprovedByUserId, the separately logged approver
  // (app- and DB-enforced).
  overrideRequestedByUserId String?
  overrideApprovedByUserId String?
  createdAt              DateTime @default(now())
}

/// Process 39 — every reconciliation mismatch raised as an EXPLICIT
/// exception with the exact variance amount, NEVER silently written off.
model ReconciliationException {
  id                String   @id @default(uuid())
  invoiceId         String?
  invoice           Invoice? @relation(fields: [invoiceId], references: [id])
  insurerStatementAmount Decimal @db.Decimal(18, 3)
  brokerRecordAmount Decimal @db.Decimal(18, 3)
  varianceAmount    Decimal  @db.Decimal(18, 3)
  status            String   @default("open") // open | investigating | resolved
  investigatedByUserId String?
  resolvedAt        DateTime?
  createdAt         DateTime @default(now())
}

/// Process 32/7.3 — client funds must be identifiable and reconcilable
/// separately from the broker's own operating funds at all times.
model ClientFundsLedgerEntry {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  amount      Decimal  @db.Decimal(18, 3)
  direction   String   // in | out
  reference   String?
  recordedAt  DateTime @default(now())
}

// ============================================================================
// PROCESSES 41-46 — CUSTOMER SERVICE
// ============================================================================

/// Process 41 — certificates, copies, changes, with SLA tracking.
model ServiceRequest {
  id           String   @id @default(uuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  requestType  String   // certificate | copy | change | other
  status       String   @default("open")
  slaTimerId   String?  @unique
  slaTimer     SlaTimer? @relation(fields: [slaTimerId], references: [id])
  createdAt    DateTime @default(now())
  closedAt     DateTime?
}

enum ComplaintStatus {
  LOGGED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  ESCALATED
}

/// Process 42 / Part 3.8 — date, customer, issue, responsible employee,
/// SLA, action, resolution, closure date.
model Complaint {
  id                 String   @id @default(uuid())
  customerId         String
  customer           Customer @relation(fields: [customerId], references: [id])
  claimId            String?
  claim              Claim?   @relation(fields: [claimId], references: [id])
  policyId           String?
  policy             Policy?  @relation(fields: [policyId], references: [id])
  issue              String
  category           String?  // denied_claim | delayed_issuance | premium_dispute | unanswered_claim | other
  responsibleEmployeeUserId String?
  status             ComplaintStatus @default(LOGGED)
  slaTimerId         String?  @unique
  slaTimer           SlaTimer? @relation(fields: [slaTimerId], references: [id])
  resolution         String?
  // closure requires supervisor approval before case is closed
  closureApprovedByUserId String?
  closedAt           DateTime?
  createdAt          DateTime @default(now())

  actions            ComplaintAction[]
  escalations        EscalationRecord[]

  @@index([customerId])
  @@index([status])
}

model ComplaintAction {
  id          String    @id @default(uuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id])
  actionText  String
  takenByUserId String
  takenAt     DateTime  @default(now())
}

/// Process 42 — escalation to regulator / insurance dispute resolution
/// mechanism, captured as a case status.
model EscalationRecord {
  id            String    @id @default(uuid())
  complaintId   String
  complaint     Complaint @relation(fields: [complaintId], references: [id])
  escalatedTo   String    // management | regulator | dispute_resolution_committee
  escalatedAt   DateTime  @default(now())
  reason        String?
}

enum CommunicationDirection {
  INBOUND
  OUTBOUND
}

/// Process 44 — outbound customer communication across channels, full
/// logging — AND (backlog Part C #12, Domain B) broker<->insurer
/// correspondence during an RFQ's market phase ("answer insurer queries and
/// supply additional information"). The Process 44 columns (`templateId`,
/// `languageUsed`, `respectedConsent`) are untouched by placement rows;
/// `direction` defaults to OUTBOUND so Process 44 (always outbound) needs no
/// change when it is built. A placement row carries `rfqId` (+ optional
/// `rfqInsurerId` to pin it to one insurer submission; null = the whole
/// panel), a free-text `body`, and `loggedByUserId`; its `customerId` is
/// backfilled from the RFQ's Opportunity's Customer.
///
/// DISCRIMINATOR: `rfqId IS NULL` == a Process-44 customer-communication row;
/// `rfqId IS NOT NULL` == a Part C #12 RFQ-correspondence row. A placement
/// row *also* has `customerId` set (backfilled), so a Process-44 "all
/// communications for customer X" query MUST filter `rfqId IS NULL` or it
/// will pick up RFQ correspondence too.
model CommunicationLog {
  id          String   @id @default(uuid())
  customerId  String?
  channel     InteractionChannel
  templateId  String?
  languageUsed LanguagePreference?
  direction   CommunicationDirection @default(OUTBOUND)
  rfqId       String?
  rfq         RFQ? @relation(fields: [rfqId], references: [id])
  rfqInsurerId String?
  rfqInsurer  RFQInsurer? @relation(fields: [rfqInsurerId], references: [id])
  subject     String?
  body        String?
  loggedByUserId String?
  sentAt      DateTime @default(now())
  createdAt   DateTime @default(now())
  respectedConsent Boolean @default(true) // must respect customer's consent preference

  @@index([customerId])
  @@index([rfqId])
  @@index([rfqInsurerId])
}

/// Process 45 — satisfaction feedback post-issuance, post-claim,
/// post-renewal.
model CustomerFeedback {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  context     String   // post_issuance | post_claim | post_renewal
  score       Int?
  comments    String?
  submittedAt DateTime @default(now())
}

/// Process 46 — at-risk renewals / lapsed clients, retention workflow.
model RetentionCase {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  reason      String   // renewal_inactivity | lapse_risk
  status      String   @default("open")
  createdAt   DateTime @default(now())
  closedAt    DateTime?
}

// ============================================================================
// PROCESS 9 (RENEWAL) / PART 3.9
// ============================================================================

enum RenewalStatus {
  RENEWAL_DUE
  IN_PROGRESS
  QUOTES_OBTAINED
  RECOMMENDED
  CLIENT_DECISION
  RENEWED
  LAPSED
  CANCELLED
}

/// Part 3.9 core entity — triggered automatically at a configurable lead
/// time before expiry (default 90 days).
model RenewalCase {
  id                String   @id @default(uuid())
  policyId          String   @unique
  policy            Policy   @relation(fields: [policyId], references: [id])
  status            RenewalStatus @default(RENEWAL_DUE)
  leadTimeDays       Int     @default(90)
  triggeredAt       DateTime @default(now())
  riskChangedSinceLastRenewal Boolean @default(false) // triggers fresh Risk Assessment
  insurerTermsWorsened Boolean @default(false) // triggers full re-marketing
  retentionEscalatedAt DateTime?
  createdAt         DateTime @default(now())

  opportunity       Opportunity?
  lossRatio         LossRatio?
  recommendation    RenewalRecommendation?
}

/// Process 30/9 — Claims ÷ Premium for a given client/policy/line/period.
/// Computed and surfaced BEFORE the renewal recommendation is drafted.
model LossRatio {
  id             String   @id @default(uuid())
  renewalCaseId  String   @unique
  renewalCase    RenewalCase @relation(fields: [renewalCaseId], references: [id])
  periodClaims   Decimal  @db.Decimal(18, 3)
  periodPremium  Decimal  @db.Decimal(18, 3)
  ratio          Decimal  @db.Decimal(7, 4)
  computedAt     DateTime @default(now())
}

model RenewalRecommendation {
  id            String   @id @default(uuid())
  renewalCaseId String   @unique
  renewalCase   RenewalCase @relation(fields: [renewalCaseId], references: [id])
  rationale     String
  createdAt     DateTime @default(now())
}

// ============================================================================
// PROCESSES 47-57 / PART 5, 7 — COMPLIANCE & RISK
// ============================================================================

/// Process 51/Part 7.1 — the broker's own CBJ license status.
model BrokerLicense {
  id                String   @id @default(uuid())
  licenseNumber     String
  scopeOfAuthorization String?
  issuedAt          DateTime?
  expiresAt         DateTime
  status            String   @default("active") // active | lapsed
}

/// Part 7.1 — the broker's own Professional Indemnity insurance — a broker
/// without valid PI cover is itself a licensing breach.
model ProfessionalIndemnityPolicy {
  id            String   @id @default(uuid())
  insurerName   String
  coverageLimit Decimal  @db.Decimal(18, 3)
  expiresAt     DateTime
  claimsHistorySummary String?

  riskEvents    ProfessionalIndemnityRiskEvent[]
}

/// Process 54 — exposures from advice/placement errors (e.g. requested Sum
/// Insured not matching amount sent to insurer).
model ProfessionalIndemnityRiskEvent {
  id            String   @id @default(uuid())
  piPolicyId    String?
  piPolicy      ProfessionalIndemnityPolicy? @relation(fields: [piPolicyId], references: [id])
  sourcePolicyCheckingId String? // links back to a PolicyChecking discrepancy
  description   String
  mitigationAction String?
  loggedAt      DateTime @default(now())
}

/// Part 7.2 — transaction monitoring for unusual patterns (unusually large
/// premium payments, frequent cancellations/refunds, third-party premium
/// payment sources), escalating to Suspicious Activity where warranted.
model TransactionMonitoringAlert {
  id                 String   @id @default(uuid())
  customerId         String?
  customer           Customer? @relation(fields: [customerId], references: [id])
  patternType        String   // large_premium_payment | frequent_cancellations | frequent_refunds | third_party_payment_source | other
  detailText         String?
  detectedAt         DateTime @default(now())
  escalatedToSuspiciousActivity Boolean @default(false)
  escalatedAt        DateTime?
  reportedToAuthorityAt DateTime? // record-keeping for regulator-mandated retention (Part 7.2)
  status             String   @default("open")
  classification     DataClassification @default(HIGHLY_CONFIDENTIAL) // names payment sources/counterparties, AML-sensitive
}

/// Process 51 — configurable compliance calendar for CBJ regulatory
/// filings/reporting obligations.
model ComplianceCalendarItem {
  id              String   @id @default(uuid())
  obligationName  String
  ownerUserId     String
  dueDate         DateTime
  evidenceOfSubmissionRef String?
  submittedAt     DateTime?
}

/// Process 53 / narrative process 37 ("إدارة مخاطر الوسيط نفسه") — the
/// broker's own risk register across the six categories the source model
/// names explicitly: operational (e.g. policy issuance errors), cyber
/// (data leakage), financial (uncollected receivables), compliance
/// (regulatory breach), and reputational (major client complaint).
/// Professional Indemnity risk has its own richer model
/// (ProfessionalIndemnityRiskEvent) because Part 3 gives it a dedicated
/// deep-dive; the other five share this generic register.
model RiskRegisterItem {
  id               String   @id @default(uuid())
  riskType         String   // operational | cyber | financial | compliance | reputational
  description      String
  mitigationAction String?
  status           String   @default("open")
  loggedAt         DateTime @default(now())
  closedAt         DateTime?
}

/// Process 57 — internal audit findings and remediation tracker.
model InternalAuditFinding {
  id              String   @id @default(uuid())
  auditPeriodLabel String
  finding         String
  remediationAction String?
  status          String   @default("open")
  loggedAt        DateTime @default(now())
  closedAt        DateTime?
}

// ============================================================================
// PART 8.1 — ASSET MANAGEMENT (ISO 27001 Organizational Controls)
// ============================================================================

/// Part 8.1 — inventory of information assets (customer data, policy data,
/// documents, backups, integrations) with owners and classification.
model InformationAsset {
  id             String   @id @default(uuid())
  name           String
  assetType      String   // customer_data | policy_data | document_store | backup | integration | other
  ownerUserId    String
  classification DataClassification
  createdAt      DateTime @default(now())
}

// ============================================================================
// PROCESS 55 / PART 7.4, 8.1, 9.3 — INCIDENT / BREACH MANAGEMENT (PDPL + ISO)
// ============================================================================

enum IncidentStatus {
  REPORTED
  CONTAINED
  IMPACT_ASSESSED
  CLASSIFIED
  NOTIFIED
  RECOVERED
  CLOSED
}

enum IncidentClassification {
  NOT_YET_CLASSIFIED
  MATERIAL
  NON_MATERIAL
}

/// Process 55 / Part 6.2 / Part 7.4 — unified security + personal-data
/// breach workflow. State machine: Reported -> Contained (4h target for
/// critical) -> Impact Assessed -> Classified (Material needs DPO + Senior
/// Management co-sign) -> Notified -> Recovered -> Closed (RCA mandatory).
model IncidentReport {
  id                    String   @id @default(uuid())
  title                 String
  description           String
  severity              String   // low | medium | high | critical
  status                IncidentStatus @default(REPORTED)
  reportedAt            DateTime @default(now())
  containedAt           DateTime? // 4-hour target for critical severity
  impactAssessedAt      DateTime?
  classification        IncidentClassification @default(NOT_YET_CLASSIFIED)
  classifiedByDpoUserId String?
  seniorManagementCoSignUserId String? // Material classification irreversible without this
  seniorManagementNotifiedAt DateTime? // within 1 hour of Material classification
  notifiedRegulators    String[] // CBJ | NCSC | Personal_Data_Protection_Council
  notifiedAt            DateTime?
  affectedDataSubjectsNotifiedAt DateTime?
  rootCauseAnalysis     String? // mandatory before Closed
  recoveredAt           DateTime?
  closedAt              DateTime?
  createdAt             DateTime @default(now())
}

// ============================================================================
// PART 6, PART 9.3 — DATA PROTECTION (PDPL) CORE CAPABILITIES
// (implements the cross-cutting rules described in Part 6.2 / 9.3; field-
// level detail limited to what these two source documents describe)
// ============================================================================

enum ConsentPurpose {
  UNDERWRITING
  CLAIMS
  MARKETING
  KYC_AML
  SHARING_WITH_INSURER
  OTHER
}

/// Part 4.1 core entity / Part 6.2 (Consent Management). Every optional
/// consent defaults unchecked; contractual-necessity and marketing consent
/// are ALWAYS two separate, independently-actionable controls (Part 6.3).
model ConsentRecord {
  id              String    @id @default(uuid())
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])
  insuredPersonId String?
  insuredPerson   InsuredPerson? @relation(fields: [insuredPersonId], references: [id])
  purpose         ConsentPurpose
  isMarketing     Boolean   @default(false) // never combined with contractual-necessity processing
  granted         Boolean   @default(false) // defaults unchecked — pre-ticked boxes prohibited
  consentTextVersion String
  grantedAt       DateTime?
  withdrawnAt     DateTime? // must reflect in register within 2 business days (SLA)
  createdAt       DateTime  @default(now())

  @@index([customerId])
}

enum DsrType {
  ACCESS
  CORRECTION
  DELETION
  OBJECTION
}

enum DsrStatus {
  RECEIVED
  IDENTITY_VERIFIED
  IN_PROGRESS
  PARTIALLY_FULFILLED
  FULFILLED
  REJECTED
  CLOSED
}

/// Part 4.1 core entity / Part 6.2 (M04). SLA: Access/Deletion 15 business
/// days (Access +15 extension allowed, reason logged); Correction/Objection
/// 10 business days. A Deletion DSR with an open retention flag cannot be
/// closed "fully fulfilled" — must force PARTIALLY_FULFILLED with a
/// retentionScheduleReference.
model DataSubjectRequest {
  id                    String    @id @default(uuid())
  customerId            String?
  customer              Customer? @relation("DsrCustomer", fields: [customerId], references: [id])
  insuredPersonId       String?
  insuredPerson         InsuredPerson? @relation("DsrInsuredPerson", fields: [insuredPersonId], references: [id])
  type                  DsrType
  status                DsrStatus @default(RECEIVED)
  receivedAt            DateTime  @default(now()) // logged same business day regardless of channel
  identityVerifiedAt    DateTime?
  slaDueAt              DateTime
  accessExtensionAppliedAt DateTime? // Access-only, +15 business days
  extensionReason       String?
  retentionScheduleReference String? // required if partially-fulfilled deletion
  partialFulfilmentJustification String?
  closedAt              DateTime?
  dpoHandlerUserId      String?
  createdAt             DateTime  @default(now())

  @@index([status])
  @@index([slaDueAt])
}

/// Part 6.2 (M06) — retention periods per record category against a
/// documented legal-minimum retention table.
model RetentionScheduleItem {
  id                String   @id @default(uuid())
  recordCategory    String
  retentionPeriodMonths Int
  legalBasis        String?
  confirmedByLegalCounselAt DateTime?

  disposalBatches   DisposalBatch[]
}

/// Part 6.2 (M06) — records under active Legal Hold are excluded from
/// routine disposal. Reviewed every 6 months (SLA).
model LegalHold {
  id            String   @id @default(uuid())
  scope         String   // description / entity reference under hold
  reason        String
  placedAt      DateTime @default(now())
  nextReviewDueAt DateTime
  releasedAt    DateTime?
}

enum DisposalBatchStatus {
  NOMINATED
  MANAGER_APPROVED
  DPO_APPROVED
  EXECUTED
  CLOSED
}

/// Part 5.2, Part 6.2 (M06) — destruction ALWAYS dual control (Department
/// Manager nominates, DPO approves), and ALWAYS produces a Certificate of
/// Destruction. 30-day SLA from batch approval.
model DisposalBatch {
  id                    String   @id @default(uuid())
  retentionScheduleItemId String?
  retentionScheduleItem RetentionScheduleItem? @relation(fields: [retentionScheduleItemId], references: [id])
  status                DisposalBatchStatus @default(NOMINATED)
  nominatedByUserId     String   // Department Manager — maker
  managerApprovedAt     DateTime?
  dpoApprovedByUserId   String?  // MUST differ from nominatedByUserId
  dpoApprovedAt         DateTime?
  method                String?  // certified_secure_wipe_nist_800_88 | physical_destruction | certified_shredding
  executedAt            DateTime?
  slaDueAt              DateTime? // 30 days from batch approval
  createdAt             DateTime @default(now())

  certificateOfDestruction CertificateOfDestruction?
}

/// A DisposalBatch cannot reach Closed without this attached.
model CertificateOfDestruction {
  id              String   @id @default(uuid())
  disposalBatchId String   @unique
  disposalBatch   DisposalBatch @relation(fields: [disposalBatchId], references: [id])
  issuedAt        DateTime @default(now())
  issuedByUserId  String
}

/// Part 6.2 — any transfer of personal data outside Jordan is blocked
/// unless exactly one of three bases is recorded.
model CrossBorderTransferRecord {
  id            String   @id @default(uuid())
  description   String
  destinationCountry String
  legalBasis    String   // statutory_exception | standard_contractual_clauses | explicit_consent
  legalBasisEvidenceRef String?
  approvedByUserId String?
  transferredAt DateTime @default(now())
}

/// Part 7.5 / Part 9.3 (M07) — insurers, reinsurers, loss adjusters, IT/
/// cloud vendors, printing/archiving, marketing/call-centre vendors.
/// Merges Process 71 (Vendor Management) and PDPL third-party governance —
/// both describe the same register in these two source documents.
model Vendor {
  id                String   @id @default(uuid())
  name              String
  vendorType        String   // insurer | reinsurer | loss_adjuster | it_cloud | printing_archiving | marketing_call_centre | other
  riskTier          String?  // low | medium | high — assigned before any data is shared or access granted
  annualReviewDueAt DateTime?
  terminationDataReturnConfirmedAt DateTime?
  accessRevokedAt   DateTime? // within 2 business days of termination
  createdAt         DateTime @default(now())

  dataProcessingAgreements DataProcessingAgreement[]
  dataSharingApprovals DataSharingApproval[]
}

/// Part 7.5 — mandatory for Medium/High tier before go-live; High tier
/// additionally requires DPO approval before first data share.
model DataProcessingAgreement {
  id            String   @id @default(uuid())
  vendorId      String
  vendor        Vendor   @relation(fields: [vendorId], references: [id])
  signedAt      DateTime?
  // Maker/checker (Part 5.2): the Relationship Owner who assessed this
  // vendor and prepared the agreement — MUST differ from dpoApprovedByUserId
  // (app- and DB-enforced).
  assessedByUserId String?
  dpoApprovedByUserId String? // required for High tier
  expiresAt     DateTime?
}

/// Part 10.6/M08 — the data-sharing channel picklist. CONFIDENTIAL/
/// HIGHLY_CONFIDENTIAL shares may only pick a channel in the SECURE_*
/// subset — assertSecureChannel() (apps/api/src/modules/security/
/// secure-channel.util.ts) rejects the rest for those two classifications;
/// see meta/lex/sensitive-data-handling.md "any data share where the picked
/// channel is not on the approved secure-channel list."
enum DataSharingChannel {
  SECURE_SFTP
  ENCRYPTED_EMAIL
  VENDOR_SECURE_PORTAL
  CBJ_REGULATORY_PORTAL
  IN_PERSON_ENCRYPTED_MEDIA
  UNENCRYPTED_EMAIL
  POSTAL_MAIL
  OTHER_UNSECURED
}

/// Part 7.5 (M08) — one-off, non-recurring data shares outside a standing
/// vendor relationship. 3 business days standard SLA, 1 business day for
/// a recognized regulatory channel (e.g. CBJ Data Portal/iFile).
model DataSharingApproval {
  id               String   @id @default(uuid())
  vendorId         String?
  vendor           Vendor?  @relation(fields: [vendorId], references: [id])
  description      String
  classification   DataClassification // of the data being shared — drives assertSecureChannel()
  channel          DataSharingChannel
  isRegulatoryChannel Boolean @default(false) // exempt from standard vendor-risk workflow, still classification-checked
  requestedByUserId String
  approvedByUserId String?  // DPO — MUST differ from requestedByUserId
  slaDueAt         DateTime
  decidedAt        DateTime?
  createdAt        DateTime @default(now())

  @@index([classification])
}

enum DpiaOutcome {
  AUTO_APPROVED
  DPO_REVIEW_REQUIRED
  ESCALATED_FULL_DPIA
}

/// Part 6.2 (M10) — 5-question yes/no screening before any new product,
/// system, campaign or vendor integration involving personal data goes
/// live. Any single "Yes" -> mandatory DPO review within 5 business days.
model DpiaScreening {
  id                     String   @id @default(uuid())
  subjectDescription     String   // the product/system/campaign/vendor integration being screened
  qSensitiveData         Boolean
  qLargeScaleProcessing  Boolean
  qCrossBorderTransfer   Boolean
  qNewTechnologyMonitoring Boolean
  qNewDigitalChannel     Boolean
  outcome                DpiaOutcome
  dpoReviewDueAt         DateTime?
  dpoReviewedAt          DateTime?
  dpoSpotCheckedAt       DateTime? // for all-"No" auto-approved results
  escalatedToFullDpiaAt  DateTime?
  createdAt              DateTime @default(now())
}

/// Part 6.2 — bilingual, version-controlled privacy notice text presented
/// at each relevant collection point.
model PrivacyNotice {
  id            String   @id @default(uuid())
  touchpoint    String   // lead_capture | onboarding_kyc | needs_risk_assessment | rfq_market_placement | claims | group_medical_life_motor_fleet | renewal_cross_sell
  versionNumber Int      @default(1)
  textAr        String
  textEn        String
  legallyReviewedAt DateTime?
  publishedAt   DateTime @default(now())
}

/// Part 9.3 — system-maintained Records of Processing Activities register.
model RopaEntry {
  id             String   @id @default(uuid())
  processingActivity String
  categoriesOfData String[]
  purpose        String
  recipients     String[]
  retentionPeriodMonths Int?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}

// ============================================================================
// PART 13 — MANAGEMENT: INSURER & EMPLOYEE PERFORMANCE
// ============================================================================

/// Process 60 — score insurers on Quote Response, Claims Service, Price,
/// Service quality.
model InsurerPerformanceScore {
  id                  String   @id @default(uuid())
  insurerId           String
  insurer             Insurer  @relation(fields: [insurerId], references: [id])
  periodLabel         String
  quoteResponseScore  Decimal  @db.Decimal(5, 2)
  claimsServiceScore  Decimal  @db.Decimal(5, 2)
  priceScore          Decimal  @db.Decimal(5, 2)
  serviceQualityScore Decimal  @db.Decimal(5, 2)
  computedAt          DateTime @default(now())
}

/// Process 61 — employee KPI achievement vs target.
model EmployeePerformanceRecord {
  id              String   @id @default(uuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id])
  periodLabel     String
  newClients      Int?
  premiumWritten  Decimal? @db.Decimal(18, 3)
  commissionEarned Decimal? @db.Decimal(18, 3)
  renewalRatePercent Decimal? @db.Decimal(5, 2)
  crossSellRatePercent Decimal? @db.Decimal(5, 2)
}

// ============================================================================
// PROCESSES 66-74 — SUPPORTING OPERATIONS
// ============================================================================

/// Process 72-73 — continuity/DR plans and tests (system outage, office/
/// site loss, cyberattack/ransomware, key-staff unavailability, insurer
/// service interruption).
model BcpDrPlan {
  id            String   @id @default(uuid())
  scenario      String   // system_outage | office_site_loss | cyberattack_ransomware | key_staff_unavailability | insurer_service_interruption
  planDocumentId String?
  rtoHours      Int?
  rpoHours      Int?
  lastTestedAt  DateTime?
  nextTestDueAt DateTime?
}

/// Process 74 — product knowledge, insurer appetite, rate guides,
/// regulatory updates for staff.
model KnowledgeBaseArticle {
  id          String   @id @default(uuid())
  title       String
  titleAr     String?
  category    String   // product_knowledge | insurer_appetite | rate_guide | regulatory_update
  bodyEn      String?
  bodyAr      String?
  publishedAt DateTime @default(now())
}

/// Part 11.2 — bilingual master data: coverage types, exclusion clauses,
/// notification templates maintained in parallel EN/AR, not machine-
/// translated at render time for regulator-facing documents.
model DocumentTemplate {
  id          String   @id @default(uuid())
  templateType String  // quotation_comparison | recommendation_report | policy_schedule_summary | invoice | certificate | complaint_acknowledgement | notification
  nameEn      String
  nameAr      String
  bodyEn      String
  bodyAr      String
  versionNumber Int    @default(1)
  updatedAt   DateTime @updatedAt
}

// ============================================================================
// INSURER MASTER DATA (Part 4.1)
// ============================================================================

/// Part 4.1 core entity / narrative process 31 ("إدارة شركات التأمين" —
/// Insurer Database): products, classes, contact persons, underwriters,
/// claims contacts, commission agreements, credit terms, SLAs, financial
/// strength, performance history.
model Insurer {
  id                String   @id @default(uuid())
  name              String
  nameAr            String?
  contactEmail      String?
  contactPhone      String?
  claimsContact     String?
  underwriterContact String? // Part 4.1 "underwriters"
  creditTermsDays   Int?     // narrative process 31 "Credit Terms"
  financialStrengthRating String? // narrative process 31 "Financial Strength"
  createdAt         DateTime @default(now())

  products          InsurerProduct[]
  slaAgreements     InsurerSlaAgreement[]
  rfqSubmissions    RFQInsurer[]
  quotations        Quotation[]
  policies          Policy[]
  commissionAgreements CommissionAgreement[]
  remittances       Remittance[]
  performanceScores InsurerPerformanceScore[]
}

/// Narrative process 31 — "Products / Classes" per insurer, the lines of
/// business the insurer underwrites and the broker can place with them.
model InsurerProduct {
  id            String   @id @default(uuid())
  insurerId     String
  insurer       Insurer  @relation(fields: [insurerId], references: [id])
  insuranceLine String
  productName   String?
  isActive      Boolean  @default(true)
}

/// Narrative process 33 ("إدارة اتفاقيات الخدمات") / Part 4.1 "SLAs" —
/// Response Time, Claim Handling SLA, Quote Response SLA, Policy Issuance
/// SLA per insurer; the system monitors compliance against these.
model InsurerSlaAgreement {
  id                   String   @id @default(uuid())
  insurerId            String
  insurer              Insurer  @relation(fields: [insurerId], references: [id])
  slaType              String   // response_time | claim_handling | quote_response | policy_issuance
  targetDays           Int
  effectiveFrom        DateTime @default(now())
}

// ============================================================================
// PART 4.2 — DOCUMENT MANAGEMENT (ELECTRONIC INSURANCE FILE)
// ============================================================================

enum DocumentCategory {
  APPLICATION_PROPOSAL
  RISK_SURVEY
  QUOTATION
  COMPARISON
  RECOMMENDATION
  CLIENT_APPROVAL
  POLICY
  ENDORSEMENT
  INVOICE
  RECEIPT
  CLAIM
  CORRESPONDENCE
  OTHER
}

/// Part 4.2 — every Policy resolves to ONE electronic Insurance File made
/// of these version-controlled, access-controlled objects. Deletion
/// disallowed without a privileged, logged override (Part 5.2).
/// A file combining multiple classification levels is classified at the
/// HIGHEST level present — never averaged (Part 6.1).
model Document {
  id               String   @id @default(uuid())
  policyId         String?
  policy           Policy?  @relation("PolicyDocuments", fields: [policyId], references: [id])
  // Process 3-4 (Customer Acquisition/Onboarding) — APPLICATION_PROPOSAL
  // onboarding documents attach to a Customer before any Policy exists.
  customerId       String?
  customer         Customer? @relation("CustomerDocuments", fields: [customerId], references: [id])
  category         DocumentCategory
  classification   DataClassification
  fileName         String
  storageRef       String   // encrypted-at-rest object storage key (Part 10.2)
  versionNumber    Int      @default(1)
  previousVersionId String? @unique
  previousVersion  Document? @relation("DocumentVersionChain", fields: [previousVersionId], references: [id])
  nextVersion      Document? @relation("DocumentVersionChain")
  uploadedByUserId String
  deletionLocked   Boolean  @default(true) // disabled by default (Part 4.2, 5.2)
  deletionOverrideByUserId String? // privileged, logged override only
  createdAt        DateTime @default(now())

  claimDocuments   ClaimDocument[]

  @@index([policyId])
  @@index([customerId])
  @@index([classification])
}

// ============================================================================
// PART 10.3 — AUDIT TRAIL (cross-cutting, polymorphic, immutable)
// ============================================================================

/// Part 4.1 core entity / Part 10.3 — IMMUTABLE record of every
/// create/read/update/delete/approve action across EVERY entity above,
/// including READ access to Sensitive/Highly Confidential data. Never
/// updated after insert; no update/delete path should exist at the
/// application layer for this table.
model AuditLogEntry {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation("AuditLogUser", fields: [userId], references: [id])
  action       AuditAction
  entityType   String      // polymorphic: "Customer" | "Policy" | "Claim" | ...
  entityId     String
  beforeValue  Json?
  afterValue   Json?
  isSensitiveDataAccess Boolean @default(false) // Part 10.3: reads of Sensitive Personal Data specifically flagged
  occurredAt   DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([occurredAt])
}

/// Part 10.3 — detected anomalous access pattern over AuditLogEntry (bulk
/// export, off-hours access, repeated unjustified access to the same
/// sensitive record). Written by AuditAnomalyDetectionService right after
/// the triggering AuditLogEntry itself; never a live notification channel
/// today, same as TransactionMonitoringAlert above.
enum AccessAnomalyPatternType {
  BULK_EXPORT
  OFF_HOURS_ACCESS
  REPEATED_UNJUSTIFIED_ACCESS
}

model AccessAnomalyAlert {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation("AccessAnomalyAlertUser", fields: [userId], references: [id])
  patternType    AccessAnomalyPatternType
  detailText     String?
  relatedAuditLogEntryIds String[]
  detectedAt     DateTime @default(now())
  status         String   @default("open")
  classification DataClassification @default(CONFIDENTIAL)

  @@index([userId])
  @@index([patternType])
  @@index([detectedAt])
}

// ============================================================================
// GENERIC SLA TIMER (Part 2 cross-cutting "Workflow & Notifications";
// every lex-listed SLA in Part 6.2/7/3.x becomes a queryable row here, not
// a note in a ticket)
// ============================================================================

/// Polymorphic SLA deadline tracker with automated escalation, backing
/// ServiceRequest/Complaint and any other SLA-bearing workflow described
/// across Parts 2-9.
model SlaTimer {
  id           String   @id @default(uuid())
  entityType   String   // polymorphic: "DataSubjectRequest" | "Complaint" | "ClaimFollowUpAlert" | ...
  entityId     String
  workflowName String   // e.g. "dsr_access", "consent_withdrawal", "disposal_batch_execution"
  dueAt        DateTime
  escalatedAt  DateTime?
  escalatedTo  String?  // role or user escalated to
  resolvedAt   DateTime?
  createdAt    DateTime @default(now())

  serviceRequest ServiceRequest?
  complaint      Complaint?

  @@index([entityType, entityId])
  @@index([dueAt])
}
