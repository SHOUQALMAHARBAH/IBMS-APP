// ============================================================================
// INSURER MASTER DATA (Part 4.1)
// ============================================================================

/// Part 4.1 core entity / narrative process 31 ("إدارة شركات التأمين" —
/// Insurer Database): products, classes, contact persons, underwriters,
/// claims contacts, commission agreements, credit terms, SLAs, financial
/// strength, performance history.
/// Part I §5 (multi-tenancy) — GLOBAL, like `Role`/`Permission` and the
/// watchlist cache (§3.1): one row per real-world insurance company, shared by
/// every Organization on the platform. Deliberately carries NO
/// `organizationId`, so `tenantScopeExtension` leaves it unfiltered and no RLS
/// policy applies — two offices dealing with the same insurer must see the
/// same company, not two divergent copies of it.
///
/// What is genuinely different per office — the negotiated commission, the
/// contact person, the credit terms — lives on `Insurer`, which is scoped.
/// Part I §6 (multi-tenancy Phase 3 step 11) — the office's OWN corporate
/// mailbox, connected by OAuth.
///
/// The platform never sends mail "as itself". Every outbound message leaves
/// from the office's real authenticated account (e.g. info@alsalam-insurance.jo),
/// which solves three things at once: recipients recognise the sender,
/// deliverability reputation belongs to the office rather than a shared
/// platform domain, and no bulk-sending infrastructure has to be operated at
/// all.
///
/// Tenant-scoped, one row per Organization. An office's mailbox credential is
/// about as sensitive as a row in this system gets, so it is governed by BOTH
/// isolation layers like any other tenant table — see the RLS policy in
/// migration 20260930100000.
model OrganizationEmailIntegration {
  id                   String                 @id @default(uuid())
  /// Part I §3.2 (multi-tenancy) — the Organization (brokerage office) this
  /// row belongs to. Supplied by `tenantScopeExtension`, never by hand.
  organizationId       String                 @default(dbgenerated())
  organization         Organization           @relation(fields: [organizationId], references: [id])
  provider             EmailProviderKind
  /// The mailbox messages are actually sent FROM. Stored so the address can be
  /// shown and audited without a round trip to the provider.
  connectedEmail       String
  /// -- ENCRYPT. The long-lived OAuth refresh token, encrypted with the same
  /// field-level service as national IDs (`EncryptionService`, purpose
  /// `oauth`). Never returned by any API, never logged.
  oauthRefreshTokenEnc String // -- ENCRYPT
  /// Microsoft identifies the directory the mailbox lives in; Google does not
  /// need it. Null for GOOGLE_WORKSPACE.
  providerTenantId     String?
  connectedByUserId    String?
  connectedAt          DateTime               @default(now())
  /// Send health. A mailbox whose consent was withdrawn at the provider fails
  /// at send time, not at connect time, so the failure has to be recorded
  /// where an administrator will see it.
  lastSucceededAt      DateTime?
  lastFailedAt         DateTime?
  lastError            String?
  status               EmailIntegrationStatus @default(ACTIVE)
  updatedAt            DateTime               @updatedAt

  /// One mailbox per office. Scoped rather than global: this IS the tenant key
  /// (Phase 1 step 5 — a unique that is only `organizationId` is the one case
  /// where scoping it means exactly this).
  @@unique([organizationId])
  @@index([organizationId])
}

/// Part I §6. A closed set, because "which API do we call to send this" has no
/// sensible default — an unknown provider must fail to construct, not fall
/// back to something.
enum EmailProviderKind {
  MICROSOFT365
  GOOGLE_WORKSPACE
}

enum EmailIntegrationStatus {
  ACTIVE
  /// Disconnected deliberately by an administrator here.
  REVOKED
  /// The provider rejected the stored credential — consent withdrawn, mailbox
  /// deleted, or the token invalidated at their end.
  ERROR
}

model InsurerMaster {
  id           String   @id @default(uuid())
  /// Unique platform-wide, which is what makes "one row per real company"
  /// enforceable rather than a convention. Divergent duplicate records are the
  /// exact failure §5 exists to prevent.
  legalName    String   @unique
  legalNameAr  String?
  /// e.g. ["MOTOR","LIFE","MARINE","HEALTH"] — what this company writes at
  /// all, distinct from `InsurerProduct`, which is what ONE office actually
  /// places with them.
  linesOffered String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  formTemplates InsurerFormTemplate[]
  relationships Insurer[]
}

/// Part I §5 — an insurer's official submission form for one product line,
/// mapped ONCE by whoever first deals with that insurer+line and then reused,
/// unmodified, by every other Organization. Global for the same reason as
/// `InsurerMaster`: re-mapping the same PDF per office is the duplicated work
/// this model removes.
///
/// Before a mapping exists the uploaded file is just an unstructured
/// `Document`; it becomes a live e-form only once its fields are defined.
model InsurerFormTemplate {
  id                String        @id @default(uuid())
  insurerMasterId   String
  insurerMaster     InsurerMaster @relation(fields: [insurerMasterId], references: [id])
  insuranceLine     String
  version           Int           @default(1)
  /// The originally uploaded PDF/Word this mapping was derived from.
  sourceDocumentRef String?
  createdAt         DateTime      @default(now())

  fields InsurerFormField[]

  /// One version of a given line's form per insurer. A re-map is a NEW
  /// version, never an edit of the one other offices are already submitting
  /// against.
  @@unique([insurerMasterId, insuranceLine, version])
  @@index([insurerMasterId])
}

/// Part I §5 — one mapped field of an insurer's form. `labelAr` alongside
/// `labelEn` because the platform's primary language is Arabic; it is optional
/// only because the source form may be English-only, in which case there is no
/// Arabic label to record rather than an empty one to invent.
model InsurerFormField {
  id           String               @id @default(uuid())
  templateId   String
  template     InsurerFormTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  fieldKey     String
  labelEn      String
  labelAr      String?
  dataType     InsurerFormFieldType
  isRequired   Boolean              @default(false)
  /// Only meaningful for ENUM fields; empty for every other type.
  options      String[]
  displayOrder Int

  @@unique([templateId, fieldKey])
  @@index([templateId])
}

/// Part I §5 renders this as a bare `String` with the values in a comment. An
/// enum instead, so an unmappable type is unrepresentable rather than caught at
/// read time by whatever renders the form.
enum InsurerFormFieldType {
  TEXT
  NUMBER
  DATE
  ENUM
  BOOLEAN
}

/// Part I §5 — ONE OFFICE'S working relationship with a master insurer, not
/// the insurer itself. The company's identity moved to `InsurerMaster`; what
/// stays here is what genuinely differs per office and must never be visible
/// to another one: the negotiated commercial terms and the named contacts.
model Insurer {
  id              String        @id @default(uuid())
  /// Part I §3.2 (multi-tenancy) — the Organization (brokerage office) this
  /// row belongs to. Supplied by `tenantScopeExtension`, never by hand.
  organizationId  String        @default(dbgenerated())
  organization    Organization  @relation(fields: [organizationId], references: [id])
  insurerMasterId String
  insurerMaster   InsurerMaster @relation(fields: [insurerMasterId], references: [id])

  /// Part I §10.2 — three DIFFERENT people, not one generic contact: pricing
  /// and RFQ, claims, and underwriting.
  rfqContactName          String?
  rfqContactEmail         String?
  /// Not in §5's model. Kept so the migration does not silently drop the
  /// existing `Insurer.contactPhone` column's data — §10.2's list is a
  /// minimum, and step 10 is explicitly a column-by-column migration.
  rfqContactPhone         String?
  claimsContactName       String?
  claimsContactEmail      String?
  underwriterContact      String? // Part 4.1 "underwriters"
  creditTermsDays         Int? // narrative process 31 "Credit Terms"
  financialStrengthRating String? // narrative process 31 "Financial Strength"
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())

  products             InsurerProduct[]
  slaAgreements        InsurerSlaAgreement[]
  rfqSubmissions       RFQInsurer[]
  quotations           Quotation[]
  policies             Policy[]
  commissionAgreements CommissionAgreement[]
  remittances          Remittance[]
  paymentChannels      PaymentChannel[]
  performanceScores    InsurerPerformanceScore[]

  /// One relationship row per office per real insurer. Without this an office
  /// could hold two divergent sets of commercial terms for the same company.
  @@unique([organizationId, insurerMasterId])
  @@index([organizationId])
  @@index([insurerMasterId])
}

/// Narrative process 31 — "Products / Classes" per insurer, the lines of
/// business the insurer underwrites and the broker can place with them.
model InsurerProduct {
  id             String       @id @default(uuid())
  /// Part I §3.2 (multi-tenancy) — the Organization (brokerage office) this
  /// row belongs to. Supplied by `tenantScopeExtension`, never by hand.
  organizationId String       @default(dbgenerated())
  organization   Organization @relation(fields: [organizationId], references: [id])
  insurerId      String
  insurer        Insurer      @relation(fields: [insurerId], references: [id])
  insuranceLine  String
  productName    String?
  isActive       Boolean      @default(true)

  @@index([organizationId])
}

/// Narrative process 33 ("إدارة اتفاقيات الخدمات") / Part 4.1 "SLAs" —
/// Response Time, Claim Handling SLA, Quote Response SLA, Policy Issuance
/// SLA per insurer; the system monitors compliance against these.
model InsurerSlaAgreement {
  id             String       @id @default(uuid())
  /// Part I §3.2 (multi-tenancy) — the Organization (brokerage office) this
  /// row belongs to. Supplied by `tenantScopeExtension`, never by hand.
  organizationId String       @default(dbgenerated())
  organization   Organization @relation(fields: [organizationId], references: [id])
  insurerId      String
  insurer        Insurer      @relation(fields: [insurerId], references: [id])
  slaType        String // response_time | claim_handling | quote_response | policy_issuance
  targetDays     Int
  effectiveFrom  DateTime     @default(now())

  @@index([organizationId])
}

// ============================================================================
// PART 4.2 — DOCUMENT MANAGEMENT (ELECTRONIC INSURANCE FILE)
// ============================================================================

enum DocumentCategory {
  APPLICATION_PROPOSAL
  RISK_SURVEY
  QUOTATION
  COMPARISON
  RECOMMENDATION
  CLIENT_APPROVAL
  POLICY
  ENDORSEMENT
  INVOICE
  RECEIPT
  CLAIM
  CORRESPONDENCE
  OTHER
}

/// Part 4.2 — every Policy resolves to ONE electronic Insurance File made
/// of these version-controlled, access-controlled objects. Deletion
/// disallowed without a privileged, logged override (Part 5.2).
/// A file combining multiple classification levels is classified at the
/// HIGHEST level present — never averaged (Part 6.1).
model Document {
  id                       String             @id @default(uuid())
  /// Part I §3.2 (multi-tenancy) — the Organization (brokerage office) this
  /// row belongs to. Supplied by `tenantScopeExtension`, never by hand.
  organizationId           String             @default(dbgenerated())
  organization             Organization       @relation(fields: [organizationId], references: [id])
  policyId                 String?
  policy                   Policy?            @relation("PolicyDocuments", fields: [policyId], references: [id])
  // Process 3-4 (Customer Acquisition/Onboarding) — APPLICATION_PROPOSAL
  // onboarding documents attach to a Customer before any Policy exists.
  customerId               String?
  customer                 Customer?          @relation("CustomerDocuments", fields: [customerId], references: [id])
  category                 DocumentCategory
  classification           DataClassification
  fileName                 String
  storageRef               String // encrypted-at-rest object storage key (Part 10.2)
  versionNumber            Int                @default(1)
  previousVersionId        String?            @unique
  previousVersion          Document?          @relation("DocumentVersionChain", fields: [previousVersionId], references: [id])
  nextVersion              Document?          @relation("DocumentVersionChain")
  uploadedByUserId         String
  deletionLocked           Boolean            @default(true) // disabled by default (Part 4.2, 5.2)
  deletionOverrideByUserId String? // privileged, logged override only
  createdAt                DateTime           @default(now())

  claimDocuments ClaimDocument[]

  @@index([policyId])
  @@index([customerId])
  @@index([classification])
  @@index([organizationId])
}

// ============================================================================
// PART 10.3 — AUDIT TRAIL (cross-cutting, polymorphic, immutable)
// ============================================================================

/// Part 4.1 core entity / Part 10.3 — IMMUTABLE record of every
/// create/read/update/delete/approve action across EVERY entity above,
/// including READ access to Sensitive/Highly Confidential data. Never
/// updated after insert; no update/delete path should exist at the
/// application layer for this table.
model AuditLogEntry {
  id                    String       @id @default(uuid())
  /// Part I §3.2 (multi-tenancy) — the Organization (brokerage office) this
  /// row belongs to. Supplied by `tenantScopeExtension`, never by hand.
  organizationId        String       @default(dbgenerated())
  organization          Organization @relation(fields: [organizationId], references: [id])
  userId                String
  user                  User         @relation("AuditLogUser", fields: [userId], references: [id])
  action                AuditAction
  entityType            String // polymorphic: "Customer" | "Policy" | "Claim" | ...
  entityId              String
  beforeValue           Json?
  afterValue            Json?
  isSensitiveDataAccess Boolean      @default(false) // Part 10.3: reads of Sensitive Personal Data specifically flagged
  occurredAt            DateTime     @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([occurredAt])
  @@index([organizationId])
}

/// Part 10.3 — detected anomalous access pattern over AuditLogEntry (bulk
/// export, off-hours access, repeated unjustified access to the same
/// sensitive record). Written by AuditAnomalyDetectionService right after
/// the triggering AuditLogEntry itself; never a live notification channel
/// today, same as TransactionMonitoringAlert above.
enum AccessAnomalyPatternType {
  BULK_EXPORT
  OFF_HOURS_ACCESS
  REPEATED_UNJUSTIFIED_ACCESS
}

model AccessAnomalyAlert {
  id                      String                   @id @default(uuid())
  /// Part I §3.2 (multi-tenancy) — the Organization (brokerage office) this
  /// row belongs to. Supplied by `tenantScopeExtension`, never by hand.
  organizationId          String                   @default(dbgenerated())
  organization            Organization             @relation(fields: [organizationId], references: [id])
  userId                  String
  user                    User                     @relation("AccessAnomalyAlertUser", fields: [userId], references: [id])
  patternType             AccessAnomalyPatternType
  detailText              String?
  relatedAuditLogEntryIds String[]
  detectedAt              DateTime                 @default(now())
  status                  String                   @default("open")
  classification          DataClassification       @default(CONFIDENTIAL)

  @@index([userId])
  @@index([patternType])
  @@index([detectedAt])
  @@index([organizationId])
}

// ============================================================================
// CONFIGURABLE SLA POLICIES
// ============================================================================

/// How an SLA duration is measured.
///
/// `BUSINESS_DAYS` is NOT `value * 24h` — it walks the configured working
/// calendar (Jordan's weekend is Friday+Saturday, and `SlaHoliday` rows are
/// skipped too). Getting that wrong silently moves a statutory deadline.
enum SlaDurationUnit {
  MINUTES
  HOURS
  BUSINESS_DAYS
  CALENDAR_DAYS
  MONTHS
}

/// Which working calendar a BUSINESS_DAYS duration walks.
enum SlaCalendarType {
  /// Jordan default: Friday+Saturday weekend, plus any `SlaHoliday` rows.
  JORDAN_STANDARD
  /// Round the clock — every day counts. For SLAs that genuinely do not
  /// pause for weekends (e.g. a breach-containment clock).
  CONTINUOUS_24_7
  /// Weekend days supplied per-policy via `customWeekendDays`.
  CUSTOM
}

/// WHERE AN SLA COMES FROM. The whole reason this table exists.
///
/// A duration alone cannot tell you whether missing it breaks the law or
/// breaks an internal target, and the system must never present the second as
/// the first. `SLA_REGISTRY` carried this only as free text inside `citation`,
/// mixing genuine PDPL rows with ones whose own citation said "DRAFT,
/// UNSOURCED" — indistinguishable to any consumer, and to any UI.
enum SlaSourceType {
  /// Backed by law/regulation. `sourceReference` + `sourceDocument` are
  /// MANDATORY (enforced in `SlaPolicyService`, and by a CHECK constraint).
  REGULATORY
  /// The broker's own governance decision. The honest home for a drafted
  /// figure with no authority behind it.
  INTERNAL_POLICY
  /// Owed to a counterparty under an agreement.
  CONTRACTUAL
  /// An operational/service target, not a commitment to anyone external.
  OPERATIONAL
  OTHER
}

enum SlaPolicyStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

/// One configurable SLA rule. Replaces the hard-coded `SLA_REGISTRY` const as
/// the RUNTIME source of truth: changing "3 business days" to "5" is a row
/// update, not a code change and redeploy.
///
/// The registry remains in code as the SEED baseline and as the compile-time
/// list of known workflow names — it is where a new workflow declares itself.
/// What it no longer is, is the thing the application reads at runtime.
///
/// `processType` matches `SlaTimer.workflowName` / `SlaRegistryEntry
/// .workflowName`. `workflowState` narrows a policy to one state of that
/// process where a workflow needs different deadlines at different stages;
/// NULL means "the whole process".
model SlaPolicy {
  id             String       @id @default(uuid())
  /// Part I §3.2 (multi-tenancy) — the Organization (brokerage office) this
  /// row belongs to. Supplied by `tenantScopeExtension`, never by hand.
  organizationId String       @default(dbgenerated())
  organization   Organization @relation(fields: [organizationId], references: [id])
  /// Stable human-facing identifier, e.g. "SLA-DSR-ACCESS". Quoted in
  /// governance documents, so it must not change when the duration does.
  /// Multi-tenancy Phase 1 step 5 — unique WITHIN an Organization, not across
  /// the platform. A bare @unique here is not only a functional bug (two
  /// offices legitimately produce the same value); it leaks across tenants on
  /// its own — a uniqueness-violation error confirms the value already exists
  /// for SOMEONE, with no row ever returned. See @@unique below.
  policyCode     String
  policyName     String
  processType    String
  /// NULL = applies to the whole process.
  workflowState  String?
  description    String?

  durationValue Int
  durationUnit  SlaDurationUnit

  calendarType      SlaCalendarType @default(JORDAN_STANDARD)
  /// `SlaCalendarType.CUSTOM` only — `Date#getUTCDay()` numbering (0=Sunday).
  customWeekendDays Int[]           @default([])
  /// "HH:MM", 24h. Both NULL = the clock runs across the whole day. Only
  /// meaningful for MINUTES/HOURS durations.
  workingHoursStart String?
  workingHoursEnd   String?
  timezone          String          @default("Asia/Amman")

  sourceType      SlaSourceType
  /// e.g. "PDPL Art. 23(b)" or "INTERNAL-POLICY-AML-002". MANDATORY when
  /// `sourceType` is REGULATORY.
  sourceReference String?
  /// e.g. "PRIV-SOP-05". MANDATORY when `sourceType` is REGULATORY.
  sourceDocument  String?
  sourceSection   String?

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  escalationEnabled Boolean @default(true)
  /// Fraction of the SLA elapsed at which a record is "approaching due"
  /// (0.8 = at 80%). Drives the APPROACHING_DUE status, not an escalation
  /// write — the escalation stages below do that.
  warningThreshold  Float   @default(0.8)

  status SlaPolicyStatus @default(DRAFT)

  createdByUserId String
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  escalations SlaPolicyEscalation[]
  timers      SlaTimer[]

  /// Read path: "the ACTIVE policy for this process (and state) right now".
  @@unique([organizationId, policyCode])
  @@index([processType, workflowState, status])
  @@index([status, effectiveFrom])
  @@index([organizationId])
}

/// One escalation stage of a policy. `offsetValue` is SIGNED and relative to
/// the policy's own due date: 0 is the deadline itself, negative is an
/// early-warning stage before it (the DSR T-3-business-days DPO alert).
model SlaPolicyEscalation {
  id             String          @id @default(uuid())
  /// Part I §3.2 (multi-tenancy) — the Organization (brokerage office) this
  /// row belongs to. Supplied by `tenantScopeExtension`, never by hand.
  organizationId String          @default(dbgenerated())
  organization   Organization    @relation(fields: [organizationId], references: [id])
  slaPolicyId    String
  slaPolicy      SlaPolicy       @relation(fields: [slaPolicyId], references: [id], onDelete: Cascade)
  stageOrder     Int
  offsetValue    Int
  offsetUnit     SlaDurationUnit
  /// Free text: several targets named by the lex have no RBAC role yet
  /// (General Manager, Legal Counsel). NULL = the deadline is tracked but no
  /// named party is escalated to.
  escalateTo     String?

  @@unique([slaPolicyId, stageOrder])
  @@index([organizationId])
}

/// A non-working day for business-day SLA math.
///
/// `business-days.util.ts` accounted for the weekend ONLY, and said so: "treat
/// a computed business-day deadline as a lower bound rather than an exact one
/// until a public-holiday calendar is supplied". This is that calendar.
///
/// `observedOn` is a DATE, not a timestamp — a holiday is a whole day in the
/// policy's timezone, not an instant.
model SlaHoliday {
  id              String           @id @default(uuid())
  /// Part I §3.2 (multi-tenancy) — the Organization (brokerage office) this
  /// row belongs to. Supplied by `tenantScopeExtension`, never by hand.
  organizationId  String           @default(dbgenerated())
  organization    Organization     @relation(fields: [organizationId], references: [id])
  observedOn      DateTime         @db.Date
  name            String
  /// NULL = applies to every calendar. Set to scope a holiday to one.
  calendarType    SlaCalendarType?
  createdByUserId String?
  createdAt       DateTime         @default(now())

  @@unique([organizationId, observedOn, calendarType])
  @@index([observedOn])
  @@index([organizationId])
}

// ============================================================================
// GENERIC SLA TIMER (Part 2 cross-cutting "Workflow & Notifications";
// every lex-listed SLA in Part 6.2/7/3.x becomes a queryable row here, not
// a note in a ticket)
// ============================================================================

/// Polymorphic SLA deadline tracker with automated escalation, backing
/// ServiceRequest/Complaint and any other SLA-bearing workflow described
/// across Parts 2-9.
model SlaTimer {
  id             String       @id @default(uuid())
  /// Part I §3.2 (multi-tenancy) — the Organization (brokerage office) this
  /// row belongs to. Supplied by `tenantScopeExtension`, never by hand.
  organizationId String       @default(dbgenerated())
  organization   Organization @relation(fields: [organizationId], references: [id])
  entityType     String // polymorphic: "DataSubjectRequest" | "Complaint" | "ClaimFollowUpAlert" | ...
  entityId       String
  workflowName   String // e.g. "dsr_access", "consent_withdrawal", "disposal_batch_execution"
  dueAt          DateTime
  escalatedAt    DateTime?
  escalatedTo    String? // role or user escalated to
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())

  /// Which configured policy produced `dueAt`. Nullable: timers created
  /// before SLA policies existed have none, and a caller may still compute a
  /// domain-specific due date without going through a policy. When set, it is
  /// what lets a reader answer "was this deadline regulatory or internal?"
  /// about a HISTORICAL timer, even after the policy is later edited.
  slaPolicyId String?
  slaPolicy   SlaPolicy? @relation(fields: [slaPolicyId], references: [id])

  /// PAUSE/RESUME. `pausedAt` set = the clock is stopped. `pausedTotalMs`
  /// accumulates completed pauses, so remaining time is
  /// `dueAt + pausedTotalMs (+ now - pausedAt while paused) - now`. Storing
  /// accumulated pause rather than mutating `dueAt` keeps the ORIGINAL
  /// deadline legible next to the adjusted one — a regulator asking "when was
  /// this due?" gets a different answer from "how long did you have?", and
  /// both are recoverable.
  pausedAt      DateTime?
  pausedTotalMs Int       @default(0)
  pauseReason   String?

  /// Stamped once by the escalation sweep when the adjusted deadline passes
  /// unresolved, so a breach is a queryable fact rather than a comparison
  /// every reader has to redo (and get the pause arithmetic right in).
  breachedAt DateTime?

  serviceRequest ServiceRequest?
  complaint      Complaint?

  @@index([entityType, entityId])
  @@index([dueAt])
  /// Declared here because migration 20260921100000 creates it in raw SQL and
  /// the schema never mentioned it — so `prisma migrate diff` proposed DROPPING
  /// a live index on an FK column. Declaring it is the fix; stripping the drop
  /// every time would leave the divergence in place forever.
  @@index([slaPolicyId])
  @@index([organizationId])
}

/// A screening hold that a compliance user accepted in writing so a workflow
/// could proceed (task Part B §17).
///
/// This exists because "the approver knew" is not a control. A REVIEW_REQUIRED
/// hold is released only by naming, in writing, what is being accepted — and
/// the acceptance is a row, attributable and queryable, not a line in a log
/// that rotates. A BLOCKED hold has no release path at all and never produces
/// one of these.
model ScreeningHoldRelease {
  id             String       @id @default(uuid())
  /// Part I §3.2 (multi-tenancy) — the Organization (brokerage office) this
  /// row belongs to. Supplied by `tenantScopeExtension`, never by hand.
  organizationId String       @default(dbgenerated())
  organization   Organization @relation(fields: [organizationId], references: [id])
  kycRecordId    String
  kycRecord      KYCRecord    @relation(fields: [kycRecordId], references: [id])

  /// The level in force when it was released. Always REVIEW_REQUIRED today —
  /// stored rather than assumed so a later policy change stays legible in the
  /// history.
  level      ScreeningHoldLevel
  /// The conditions accepted, as `ScreeningHoldCondition` names. A snapshot:
  /// re-evaluating later can give a different answer, and this is what the
  /// releaser actually saw.
  conditions String[]           @default([])
  /// The evaluator's own operator-facing detail lines at release time. Free of
  /// subject PII by construction (see `screening-hold.config.ts`).
  detail     String

  /// Mandatory. The business justification, kept verbatim — the same treatment
  /// `ScreeningMatch.reviewReason` and `Refund.reason` get.
  reason           String
  releasedByUserId String
  releasedAt       DateTime @default(now())

  /// What the release let happen, so a reviewer can trace effect to cause.
  workflow String @default("kyc_decision")

  @@index([kycRecordId, releasedAt(sort: Desc)])
  @@index([releasedByUserId])
  @@index([organizationId])
}

enum ScreeningHoldLevel {
  NO_HOLD
  REVIEW_REQUIRED
  BLOCKED
}

/// Part B §6/§7 — one downloaded, validated, published generation of a
/// sanctions list.
///
/// ## Why this exists: the reader must never see a half-written list
///
/// The sync used to upsert ~19,000 rows in chunks and then delete whatever it
/// had not stamped. Neither step is a transaction, so a screening running
/// during a sync could observe a list that was partly the old generation and
/// partly the new one — and worse, one where the entries a subject would have
/// matched had already been pruned but their replacements had not yet landed.
/// A sanctions check against a half-written list produces a CLEAR result, which
/// is the failure mode this whole module exists to prevent.
///
/// So entries are written against a VERSION, and a screening reads only the
/// version that is currently PUBLISHED. Writing happens entirely outside what
/// any reader can see; publishing is a single transaction that flips one row.
/// A reader therefore sees the old complete generation or the new complete
/// generation, never a mixture.
///
/// ## The lifecycle
///
///   DOWNLOADED  rows are being written; no reader can see them
///   VALIDATED   the plausibility checks passed; still invisible
///   PUBLISHED   readers now see exactly this generation
///   SUPERSEDED  a newer generation was published; kept for rollback
///   REJECTED    validation failed; never visible, kept for the audit trail
///
/// A generation can only be published from VALIDATED. Rollback re-publishes a
/// SUPERSEDED generation whose rows are still present, which is why superseded
/// generations are retained rather than pruned immediately.
model WatchlistDatasetVersion {
  id     String               @id @default(uuid())
  source WatchlistSource
  status DatasetVersionStatus @default(DOWNLOADED)

  /// Human-readable and stable, e.g. `OFAC_SDN@2026-09-10T18:00:00.000Z`.
  /// This is what a `ScreeningResult.datasetVersion` records, so a historical
  /// screening stays traceable to the exact generation it was made against
  /// even after that generation's rows are gone.
  version     String  @unique
  recordCount Int?
  /// Entries in this generation that were not in the previously published one.
  addedCount  Int?
  /// SHA-256 of the raw feed, so an identical re-download is recognisable.
  checksum    String?

  downloadedAt    DateTime  @default(now())
  validatedAt     DateTime?
  publishedAt     DateTime?
  supersededAt    DateTime?
  rejectedAt      DateTime?
  /// Why validation refused this generation. Never contains feed content.
  rejectionReason String?

  syncRunId         String?
  /// Null when the 12-hourly scheduler published it; set when a person did.
  publishedByUserId String?
  /// Set when this publication is a ROLLBACK — the generation it displaced.
  rolledBackFromId  String?
  /// Mandatory on a rollback: a person overriding the newest list owes a
  /// written reason, the same rule the screening match queue follows.
  rollbackReason    String?

  entries WatchlistEntry[]

  @@index([source, status])
  @@index([source, downloadedAt(sort: Desc)])
}

enum DatasetVersionStatus {
  DOWNLOADED
  VALIDATED
  PUBLISHED
  SUPERSEDED
  REJECTED
}
