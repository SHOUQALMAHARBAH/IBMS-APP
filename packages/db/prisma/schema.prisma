}

// ============================================================================
// PART 13 — MANAGEMENT: SALES, INSURER & EMPLOYEE PERFORMANCE
// ============================================================================

/// Process 59 — a sales quota set for one Sales/Relationship Officer OR one
/// Branch (never both — SalesTarget_owner_xor_branch, a hand-authored CHECK,
/// migration 20260910120000) for a period. `ownerUserId`/`branchId` are bare
/// scalars (the Opportunity.createdByUserId / Policy.placedByUserId shape),
/// not relations — this table is a live-query scope selector, not a
/// provenance trail. `SalesPerformanceService` resolves the "actual" side
/// (new Prospects qualified in the same window, by that owner or by anyone
/// in that branch) live against Lead/Prospect at read time — this model
/// never stores an actual figure itself, only the target. Two hand-authored
/// PARTIAL unique indexes (not a single composite `@@unique`, since Postgres
/// treats every NULL as distinct in a plain composite unique — the #48
/// AML gotcha) enforce "at most one target per owner per period label" and
/// "at most one target per branch per period label" independently.
model SalesTarget {
  id                 String       @id @default(uuid())
  /// Part I §3.2 (multi-tenancy) — the Organization (brokerage office) this
  /// row belongs to. Supplied by `tenantScopeExtension`, never by hand.
  organizationId     String       @default(dbgenerated())
  organization       Organization @relation(fields: [organizationId], references: [id])
  ownerUserId        String?
  branchId           String?
  periodLabel        String
  periodStart        DateTime
  periodEnd          DateTime
  targetNewProspects Int
  createdByUserId    String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([ownerUserId])
  @@index([branchId])
  @@index([periodStart, periodEnd])
  @@index([organizationId])
}

/// Process 60 — score insurers on Quote Response, Claims Service, Price,
/// Service quality. A monthly periodic job (`InsurerPerformanceScheduler`)
/// snapshots one row per insurer per `periodLabel` ("YYYY-MM") — a recompute
/// for the same insurer+period UPSERTS via `@@unique([insurerId,
/// periodLabel])` (both columns are always non-null here, so unlike
/// `SalesTarget` this is a plain composite unique, no partial-index gotcha)
/// rather than accumulating stray duplicate snapshots. Each dimension falls
/// back to a documented neutral `NEUTRAL_SCORE = 50.00` when the period has
/// no computable data for it (e.g. no RFQ sent that month) — see
/// `insurer-performance.config.ts` and `ibms-brain/meta/context/
/// insurer-performance.md`.
model InsurerPerformanceScore {
  id                  String       @id @default(uuid())
  /// Part I §3.2 (multi-tenancy) — the Organization (brokerage office) this
  /// row belongs to. Supplied by `tenantScopeExtension`, never by hand.
  organizationId      String       @default(dbgenerated())
  organization        Organization @relation(fields: [organizationId], references: [id])
  insurerId           String
  insurer             Insurer      @relation(fields: [insurerId], references: [id])
  periodLabel         String
  quoteResponseScore  Decimal      @db.Decimal(5, 2)
  claimsServiceScore  Decimal      @db.Decimal(5, 2)
  priceScore          Decimal      @db.Decimal(5, 2)
  serviceQualityScore Decimal      @db.Decimal(5, 2)
  computedAt          DateTime     @default(now())

  @@unique([insurerId, periodLabel])
  @@index([organizationId])
}

/// Process 61 — employee KPI achievement vs target. A monthly periodic job
/// (`EmployeePerformanceScheduler`) snapshots one row per `Employee` per
/// `periodLabel` ("YYYY-MM") for every employee with a linked `User`
/// account (`User.employeeId` — dormant elsewhere in this codebase, no
/// writer ever sets it; this process is its first real consumer, alongside
/// `Employee` itself, since Domain H/#66 HR is not built) — a recompute for
/// the same employee+period UPSERTS via `@@unique([employeeId, periodLabel])`
/// (both columns always non-null, the `InsurerPerformanceScore` shape, not
/// `SalesTarget`'s partial-index one). Every field stays nullable per the
/// schema's own design: `newClients`/`premiumWritten`/`commissionEarned`
/// are always a real number (0 when there is no activity — a plain count/
/// sum always has a defined zero); `renewalRatePercent`/
/// `crossSellRatePercent` are `null` specifically when their denominator is
/// zero (no renewal/cross-sell outcomes existed to rate that period) — a
/// genuine "not yet ratable," not a computed 0%. See
/// `employee-performance.config.ts` and `ibms-brain/meta/context/
/// employee-performance.md`.
model EmployeePerformanceRecord {
  id                   String       @id @default(uuid())
  /// Part I §3.2 (multi-tenancy) — the Organization (brokerage office) this
  /// row belongs to. Supplied by `tenantScopeExtension`, never by hand.
  organizationId       String       @default(dbgenerated())
  organization         Organization @relation(fields: [organizationId], references: [id])
  employeeId           String
  employee             Employee     @relation(fields: [employeeId], references: [id])
  periodLabel          String
  newClients           Int?
  premiumWritten       Decimal?     @db.Decimal(18, 3)
  commissionEarned     Decimal?     @db.Decimal(18, 3)
  renewalRatePercent   Decimal?     @db.Decimal(5, 2)
  crossSellRatePercent Decimal?     @db.Decimal(5, 2)

  @@unique([employeeId, periodLabel])
  @@index([organizationId])
}

