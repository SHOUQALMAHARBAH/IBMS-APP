{
  "name": "@ibms/db",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "build": "dotenv -e ../../.env -- prisma generate && tsc",
    "generate": "dotenv -e ../../.env -- prisma generate",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "migrate:status": "dotenv -e ../../.env -- prisma migrate status",
    "migrate:test:dev": "dotenv -e ../../.env.test -- prisma migrate dev",
    "migrate:test:deploy": "dotenv -e ../../.env.test -- prisma migrate deploy",
    "migrate:test:status": "dotenv -e ../../.env.test -- prisma migrate status",
    "validate": "dotenv -e ../../.env -- prisma validate",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "seed": "dotenv -e ../../.env -- prisma db seed",
    "seed:test": "dotenv -e ../../.env.test -- prisma db seed",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "prisma": "6.19.3",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
