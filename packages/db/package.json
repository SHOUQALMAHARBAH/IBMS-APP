{
  "name": "@ibms/db",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./password-policy": {
      "types": "./dist/password-policy.d.ts",
      "default": "./dist/password-policy.js"
    }
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "build": "dotenv -e ../../.env -- prisma generate && tsc",
    "generate": "dotenv -e ../../.env -- prisma generate",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "migrate:status": "dotenv -e ../../.env -- prisma migrate status",
    "migrate:test:dev": "dotenv -e ../../.env.test -- prisma migrate dev",
    "migrate:test:deploy": "dotenv -e ../../.env.test -- prisma migrate deploy",
    "migrate:test:status": "dotenv -e ../../.env.test -- prisma migrate status",
    "checksums": "dotenv -e ../../.env -- node scripts/check-migration-checksums.mjs",
    "divergence": "dotenv -e ../../.env -- node scripts/check-schema-divergence.mjs",
    "divergence:test": "dotenv -e ../../.env.test -- node scripts/check-schema-divergence.mjs",
    "checksums:test": "dotenv -e ../../.env.test -- node scripts/check-migration-checksums.mjs",
    "validate": "dotenv -e ../../.env -- prisma validate",
    "format": "dotenv -e ../../.env -- prisma format",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "seed": "dotenv -e ../../.env -- prisma db seed",
    "seed:test": "dotenv -e ../../.env.test -- prisma db seed",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.seed.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "prisma": "6.19.3",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vitest": "^5.0.0"
  }
}
