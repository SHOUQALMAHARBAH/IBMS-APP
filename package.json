{
  "name": "ibms-app",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.8.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "fast-uri": "3.1.8"
  },
  "scripts": {
    "browsers:check": "node scripts/check-playwright-browsers.mjs",
    "build": "turbo run build",
    "cache:prune": "node scripts/prune-turbo-cache.mjs",
    "cache:report": "node scripts/prune-turbo-cache.mjs --report",
    "db:backup:drill": "bash scripts/backup-restore-drill.sh",
    "db:checksums": "npm run checksums --workspace=@ibms/db",
    "db:divergence": "npm run divergence --workspace=@ibms/db",
    "db:fixture:permissions": "dotenv -e .env -- node scripts/generate-role-permissions-fixture.mjs",
    "db:fixture:permissions:check": "dotenv -e .env -- node scripts/generate-role-permissions-fixture.mjs --check",
    "db:format": "npm run format --workspace=@ibms/db",
    "db:generate": "npm run generate --workspace=@ibms/db",
    "db:migrate:deploy": "npm run migrate:deploy --workspace=@ibms/db",
    "db:migrate:dev": "npm run migrate:dev --workspace=@ibms/db",
    "db:migrate:status": "npm run migrate:status --workspace=@ibms/db",
    "db:permission-catalogue": "dotenv -e .env.test -- tsx scripts/export-permission-catalogue.ts",
    "db:reference-values": "dotenv -e .env.test -- tsx scripts/generate-reference-values.ts",
    "db:permission-descriptions": "dotenv -e .env.test -- tsx scripts/generate-permission-descriptions-input.ts",
    "db:permission-descriptions:check": "dotenv -e .env.test -- tsx scripts/generate-permission-descriptions-input.ts --check",
    "db:privileges": "npm run privileges --workspace=@ibms/db",
    "db:provision-app-role": "node scripts/provision-app-role.mjs",
    "db:seed": "npm run seed --workspace=@ibms/db",
    "db:studio": "npm run studio --workspace=@ibms/db",
    "db:test:checksums": "npm run checksums:test --workspace=@ibms/db",
    "db:test:divergence": "npm run divergence:test --workspace=@ibms/db",
    "db:test:fixture:permissions": "dotenv -e .env.test -- node scripts/generate-role-permissions-fixture.mjs",
    "db:test:fixture:permissions:check": "dotenv -e .env.test -- node scripts/generate-role-permissions-fixture.mjs --check",
    "db:test:migrate:deploy": "npm run migrate:test:deploy --workspace=@ibms/db",
    "db:test:migrate:dev": "npm run migrate:test:dev --workspace=@ibms/db",
    "db:test:migrate:status": "npm run migrate:test:status --workspace=@ibms/db",
    "db:test:privileges": "npm run privileges:test --workspace=@ibms/db",
    "db:test:seed": "npm run seed:test --workspace=@ibms/db",
    "db:validate": "npm run validate --workspace=@ibms/db",
    "dev": "turbo run dev",
    "e2e": "turbo run e2e",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:a11y": "turbo run test:a11y",
    "test:contract": "turbo run test:contract",
    "test:e2e": "turbo run test:e2e",
    "test:security": "node scripts/audit-check.mjs",
    "test:smoke": "bash scripts/smoke.sh api",
    "typecheck": "turbo run typecheck",
    "db:migrate:diff": "npm run migrate:diff --workspace=@ibms/db",
    "check:screen-route-fit": "python scripts/measurements/screen-route-permission-fit.py --check",
    "check:loaders": "python scripts/measurements/all-or-nothing-loaders.py --check",
    "check:absence": "python scripts/measurements/page-wide-absence-assertions.py --check",
    "check:labels": "python scripts/measurements/identifier-labels.py --check",
    "check:seed-sweeps": "python scripts/measurements/seed-sweeps-vs-cascade.py --check",
    "check:maker-checker-pairs": "python scripts/measurements/combined-duty-projection.py",
    "check:css-properties": "python scripts/measurements/undefined-css-properties.py",
    "check:rendered-identifiers": "python scripts/measurements/rendered-identifiers.py --check",
    "check:typed-identifiers": "python scripts/measurements/typed-identifier-inputs.py --check",
    "check:four-states": "python scripts/measurements/four-states.py --check",
    "check:load-error-way-forward": "python scripts/measurements/load-error-way-forward.py --check",
    "check:unreachable-routes": "python scripts/measurements/unreachable-routes.py --check",
    "check:unreachable-routes-by-verb": "python scripts/measurements/unreachable-routes-by-verb.py --check",
    "check:screen-pass": "npm run check:labels && npm run check:rendered-identifiers && npm run check:typed-identifiers && npm run check:four-states && npm run check:load-error-way-forward && npm run check:unreachable-routes && npm run check:unreachable-routes-by-verb",
    "measure:screen-route-fit": "python scripts/measurements/screen-route-permission-fit.py"
  },
  "devDependencies": {
    "turbo": "2.10.11"
  }
}
